---
import Button from '@/components/ui/Button.astro'
import EmptyState from '@/components/ui/EmptyState.astro'
import Link from '@/components/ui/Link.astro'
import StateSwitch from '@/components/ui/StateSwitch.astro'
import WorkspacesLink from '@/components/ui/WorkspacesLink.astro'
import WorkspaceFormModal from '@/components/modal/WorkspaceFormModal.astro'
import { actions } from 'astro:actions'
import type { Workspace } from '@/types/workspaces'
import PermissionGuard from '@/components/ui/PermissionGuard.astro'

const getWorkspacesFromSession = async () => {
  const workspaces = (await Astro.session?.get('workspaces')) ?? []
  return workspaces as Workspace[]
}

const hasWorkspacesInSession = (await getWorkspacesFromSession()).length > 0

let workspaces: Workspace[] = []
let latestWorkspaces: Workspace[] = []
let hasWorkSpaces = false
let error: string | null = null

if (!hasWorkspacesInSession) {
  const { data, error: actionError } = await Astro.callAction(actions.workspaces.list, {})
  workspaces = data?.data ?? []
  latestWorkspaces = workspaces.toReversed().slice(0, 4)
  hasWorkSpaces = workspaces.length > 0
  error = actionError?.message ?? null
}

if (hasWorkspacesInSession) {
  workspaces = await getWorkspacesFromSession()
  latestWorkspaces = workspaces.toReversed().slice(0, 4)
  hasWorkSpaces = workspaces.length > 0
}
---

<section class="mb-10">
  <header class="mb-5 flex items-center justify-between">
    <div>
      <h2 class="text-lg font-semibold text-heading">Espacios de trabajo</h2>
      <p class="text-sm text-subheading">{hasWorkSpaces ? `${workspaces.length} espacios de trabajo` : 'Aún no tienes espacios de trabajo'}</p>
    </div>

    <div class="flex items-center gap-2">
      <PermissionGuard permission="workspaces.create">
        <Button size="sm" data-open-modal="create-workspace" icon="Plus">Crear nuevo</Button>
      </PermissionGuard>

      <Link size="sm" variant="secondary" href="/workspaces" icon="ChevronRight">Ver todos</Link>
    </div>
  </header>

  <StateSwitch isEmpty={!hasWorkSpaces}>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {hasWorkSpaces && latestWorkspaces.map((workspace, index) => <WorkspacesLink workspace={workspace} index={index} />)}
    </div>

    <div slot="empty">
      <EmptyState state="info" title="Aún no tienes espacios de trabajo" hiddenAction description="Crea tu primer espacio de trabajo para comenzar" />
    </div>

    <div slot="error">
      <EmptyState state="error" title="Error al cargar los espacios de trabajo" description={error ?? 'Error al cargar los espacios de trabajo'} />
    </div>
  </StateSwitch>
</section>

<WorkspaceFormModal mode="create" />
