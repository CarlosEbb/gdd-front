---
import Modal from '@/components/modal/Modal.astro'
import Button from '@/components/ui/Button.astro'
import CardDocument from '@/components/ui/CardDocument.astro'
import EmptyState from '@/components/ui/EmptyState.astro'
import Icon from '@/components/ui/Icon.astro'
import { actions } from 'astro:actions'
import type { Document } from '@/types/documents'
import DataGrid from '@/components/ui/DataGrid.astro'
import type { ActionError } from 'astro:actions'
import StateSwitch from '@/components/ui/StateSwitch.astro'

interface Props {
  limit?: number | null
  uuidWorkspace?: string | null
}

const { limit = 7, uuidWorkspace = null } = Astro.props

let documents: Document[] | null = null
let hasDocuments = false
let error: ActionError | undefined = undefined

let grid = ''

if (uuidWorkspace) {
  const { data, error: errorDocuments } = await Astro.callAction(actions.documents.getByWorkspaces, { uuid: uuidWorkspace })
  documents = data?.data ?? []
  hasDocuments = documents.length > 0 || false
  error = errorDocuments ?? undefined
  grid = 'xs:grid-cols-2 grid grid-cols-1 gap-3 sm:grid-cols-3 lg:grid-cols-3'
} else {
  const { data, error: errorDocuments } = await Astro.callAction(actions.documents.getByUser, { limit })
  documents = data?.data ?? []
  hasDocuments = documents.length > 0 || false
  error = errorDocuments ?? undefined
  grid = 'grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4'
}

// crear un mock para documents
documents = [
  {
    id: 1,
    uuid: '1',
    title: 'Documento 1',
    name: 'Documento 1',
    description: 'Descripcion del documento 1',
    open_date: '2022-01-01',
    id_workspace: 1,
    created_at: '2022-01-01',
    updated_at: '2022-01-01',
    status: 'active',
    last_version: {
      id: 1,
      id_template: 1,
      name_version: 'Version 1',
      build_number: '1.0.0',
      path_thumbnails: 'path_thumbnails',
      path_json: 'path_json',
      created_by: 1,
      created_at: new Date(),
      status: 'active',
      uuid: '1',
    },
  },
  {
    id: 2,
    uuid: '2',
    title: 'Documento 2',
    name: 'Documento 2',
    description: 'Descripcion del documento 2',
    open_date: '2022-01-01',
    id_workspace: 1,
    created_at: '2022-01-01',
    updated_at: '2022-01-01',
    status: 'active',
    last_version: {
      id: 2,
      id_template: 2,
      name_version: 'Version 2',
      build_number: '2.0.0',
      path_thumbnails: 'path_thumbnails',
      path_json: 'path_json',
      created_by: 2,
      created_at: new Date(),
      status: 'active',
      uuid: '2',
    },
  },
  {
    id: 3,
    uuid: '3',
    title: 'Documento 3',
    name: 'Documento 3',
    description: 'Descripcion del documento 3',
    open_date: '2022-01-01',
    id_workspace: 1,
    created_at: '2022-01-01',
    updated_at: '2022-01-01',
    status: 'active',
    last_version: {
      id: 3,
      id_template: 3,
      name_version: 'Version 3',
      build_number: '3.0.0',
      path_thumbnails: 'path_thumbnails',
      path_json: 'path_json',
      created_by: 3,
      created_at: new Date(),
      status: 'active',
      uuid: '3',
    },
  },
  {
    id: 4,
    uuid: '4',
    title: 'Documento 4',
    name: 'Documento 4',
    description: 'Descripcion del documento 4',
    open_date: '2022-01-01',
    id_workspace: 1,
    created_at: '2022-01-01',
    updated_at: '2022-01-01',
    status: 'active',
    last_version: {
      id: 4,
      id_template: 4,
      name_version: 'Version 4',
      build_number: '4.0.0',
      path_thumbnails: 'path_thumbnails',
      path_json: 'path_json',
      created_by: 4,
      created_at: new Date(),
      status: 'active',
      uuid: '4',
    },
  },
]

hasDocuments = true
error = undefined
const currentPath = '/home'
---

<StateSwitch hasError={error !== undefined} isEmpty={!hasDocuments}>
  <EmptyState slot="error-state" title="Error al cargar los documentos" description="Intenta nuevamente." href={currentPath} hrefText="Recargar" state="error" action="refresh" />

  <EmptyState
    slot="empty-state"
    title="Documentos no encontrados"
    description="Crea un nuevo documento para empezar a trabajar."
    modalId="save-template"
    hrefText="Crear documento"
    state="notFound"
    action="create"
  />

  <div class={`mb-10 grid ${grid}`} data-documents-container>
    {documents.map((document) => <CardDocument document={document} />)}
  </div>
</StateSwitch>

<Modal modalId="modal-delete" title="Eliminar documento">
  <form class="space-y-6" id="delete-document-form">
    <div class="flex flex-col items-center justify-center py-5">
      <Icon name="Trash" size={48} stroke-width={1.5} class="text-red-300" />
      <p class="mb-2 text-lg font-semibold text-gray-900" id="document-name"></p>
      <p class="mb-4 text-center">¿Estás seguro de querer eliminar el documento?</p>
      <input type="hidden" name="uuid_template" id="uuid-template" value="" />
      <input type="hidden" name="name_version" id="name-version" value="" />
    </div>
  </form>

  <div slot="footer">
    <Button type="button" size="sm" variant="outline" data-close-modal>Cancelar</Button>
    <Button type="submit" size="sm" form="delete-document-form" id="btn-delete-document" loadingText="Eliminando...">Eliminar documento</Button>
  </div>
</Modal>

<script>
  import { initDocumentModals } from '@/scripts/document-modals'

  initDocumentModals()
  document.addEventListener('astro:page-load', initDocumentModals)
</script>
