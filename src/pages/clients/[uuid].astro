---
import Container from '@/components/ui/Container.astro'
import MainLayout from '@/layouts/MainLayout.astro'
import Link from '@/components/ui/Link.astro'
import Icon from '@/components/ui/Icon.astro'
import Button from '@/components/ui/Button.astro'
import { formatDate } from '@/scripts/utils'
import Tabs from '@/components/tabs/Tabs.astro'
import TabsList from '@/components/tabs/TabsList.astro'
import TabsTrigger from '@/components/tabs/TabsTrigger.astro'
import TabsContent from '@/components/tabs/TabsContent.astro'
import List from '@/components/ui/List.astro'
import { actions } from 'astro:actions'
import EmptyState from '@/components/ui/EmptyState.astro'
import Modal from '@/components/modal/Modal.astro'
import StateSwitch from '@/components/ui/StateSwitch.astro'
import Header from '@/components/ui/Header.astro'

const { uuid } = Astro.params
const { PUBLIC_PROJECT_URL } = import.meta.env
const { data, error } = await Astro.callAction(actions.clients.getByUuid, { uuid: uuid! })

const client = data?.data || null
const dataBases = client?.databases || []
const hasDatabases = dataBases.length > 0
const servers = client?.servers || []
const hasServers = servers.length > 0

const selectedClient = {
  name: client?.name || '',
  rif: client?.rif || '',
  id: client?.id || 0,
  uuid: client?.uuid || '',
  nroDocumentsMax: client?.nroDocumentsMax || 0,
  nroWorkspacesMax: client?.nroWorkspacesMax || 0,
  createdAt: client?.createdAt || '',
  databases: client?.databases || [],
  servers: client?.servers || [],
  logo: client?.logo ? `${PUBLIC_PROJECT_URL}${client.logo}` : null,
}
---

<MainLayout title="Nombre del cliente">
  <Container>
    <Header title="Detalles del cliente" />

    <StateSwitch hasError={!!error}>
      <>
        <div class="overflow-hidden rounded-main border border-border bg-background shadow-base">
          <div class="flex h-14 flex-row items-center justify-between border-b border-border py-3 pr-3 pl-4">
            <h1 class="text-base font-medium text-heading">Detalles cliente</h1>

            <div class="flex items-center gap-3">
              <Link size="sm" href={`/clients/${uuid}/edit`} icon="Pencil"> Editar </Link>
              <Button size="sm" variant="destructive" data-open-modal="delete-client"> Eliminar </Button>
            </div>
          </div>
          <div class="flex flex-col items-start justify-between gap-6 p-6 sm:p-8 md:flex-row md:items-center">
            <div class="flex items-start gap-5">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center overflow-hidden rounded-xl bg-linear-to-br from-primary to-primary/90 text-heading shadow-inner">
                {
                  selectedClient.logo !== null ? (
                    <img src={selectedClient.logo} alt="Logo del cliente" class="object-contain" />
                  ) : (
                    <div class="bg-primary/30 p-4 text-heading">
                      <Icon name="Building2" size={32} />
                    </div>
                  )
                }
              </div>

              <div>
                <div class="grid">
                  <h2 class="mb-4 text-xl font-semibold tracking-tight text-heading">{selectedClient.name}</h2>

                  <div class="grid gap-4 sm:grid-cols-3">
                    <div class="grid gap-1">
                      <span class="text-xs font-semibold tracking-wide text-subheading">Rif</span>
                      <span class="text-sm font-medium text-heading">{selectedClient.rif}</span>
                    </div>
                    <div class="grid gap-1">
                      <span class="text-xs font-semibold tracking-wide text-subheading">Servidores</span>
                      <span class="text-sm font-medium text-heading">Tiene {selectedClient.servers.length} servidores asignado</span>
                    </div>
                    <div class="grid gap-1">
                      <span class="text-xs font-semibold tracking-wide text-subheading">Base de Datos</span>
                      <span class="text-sm font-medium text-heading">Base de datos asignada {selectedClient.databases.length}</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="flex flex-col gap-4 border-t border-border bg-background px-6 py-4 text-sm transition-colors sm:flex-row sm:items-center sm:gap-8 sm:px-8">
            <div class="flex items-center gap-2">
              <Icon name="FileText" class="h-4 w-4 text-gray-400" />
              <span class="text-gray-500">Límite documentos:</span>
              <span class="font-semibold text-gray-900">{selectedClient.nroDocumentsMax}</span>
            </div>

            <div class="flex items-center gap-2">
              <Icon name="LayoutGrid" class="h-4 w-4 text-gray-400" />
              <span class="text-gray-500">Espacios de trabajo:</span>
              <span class="font-semibold text-gray-900">{selectedClient.nroWorkspacesMax}</span>
            </div>

            <div class="flex items-center gap-2 sm:ml-auto">
              <Icon name="Calendar" class="h-4 w-4 text-gray-400" />
              <span class="text-gray-500">Registro:</span>
              <span class="font-medium text-gray-900">{formatDate(selectedClient.createdAt as string)}</span>
            </div>
          </div>
        </div>

        <section class="mt-6">
          <Tabs defaultValue="dataBase">
            <div class="flex items-center justify-between">
              <TabsList>
                <TabsTrigger value="dataBase"
                  >Base de Datos <span class="ml-1 flex aspect-square h-5 w-5 items-center justify-center rounded-full bg-foreground p-2 text-xs font-semibold text-primary"
                    >{selectedClient.databases.length}</span
                  ></TabsTrigger
                >
                <TabsTrigger value="servidores"
                  >Servidores <span class="ml-1 flex aspect-square h-5 w-5 items-center justify-center rounded-full bg-foreground p-2 text-xs font-semibold text-primary"
                    >{selectedClient.servers.length}</span
                  ></TabsTrigger
                >
              </TabsList>
            </div>

            <TabsContent value="dataBase">
              <StateSwitch isEmpty={!hasDatabases}>
                <div class="grid grid-cols-1 gap-3">
                  {selectedClient.databases.map((database) => <List title={database.nameBd} subtitle={database.idServer.toString()} icon="Database" />)}
                </div>
                <div slot="empty">
                  <EmptyState title="No hay bases de datos" state="info" hiddenAction={true} />
                </div>
              </StateSwitch>
            </TabsContent>

            <TabsContent value="servidores">
              <StateSwitch isEmpty={!hasServers}>
                <div class="grid grid-cols-1 gap-3">
                  {
                    selectedClient.servers.map((server) => (
                      <List title={server.id.toString()} subtitle={server.uuidServer} icon="Server">
                        <div slot="actions">
                          <Link href={`/servers/${server.uuidServer}`} variant="ghost" size="icon">
                            <Icon name="ChevronRight" stroke-width={1.5} size={16} />
                          </Link>
                        </div>
                      </List>
                    ))
                  }
                </div>
                <div slot="empty">
                  <EmptyState title="No hay servidores" description="Agrega un nuevo servidor para este cliente" href="/servers/form-server" hrefText="Crear servidor" state="info" action="create" />
                </div>
              </StateSwitch>
            </TabsContent>
          </Tabs>
        </section>
      </>
      <div slot="error">
        <EmptyState title="Ah ocurrido un error" state="error" description={error?.message ?? 'Ocurrió un error inesperado'} />
      </div>
    </StateSwitch>
  </Container>
</MainLayout>

<Modal modalId="delete-client" title="Eliminar cliente">
  <form class="space-y-6" id="delete-client-form">
    <div class="flex flex-col items-center justify-center py-5">
      <Icon name="Trash" size={48} stroke-width={1.5} class="text-red-300" />
      <p class="mt-4 mb-1 text-lg font-semibold text-gray-900">{selectedClient.name}</p>
      <p class="mb-4 text-center">¿Estás seguro de querer eliminar este cliente?</p>
      <input type="hidden" name="uuid" value={selectedClient.uuid} required readonly />
    </div>
  </form>

  <div slot="footer">
    <Button type="button" size="sm" variant="outline" data-close-modal>Cancelar</Button>
    <Button type="submit" size="sm" variant="destructive" form="delete-client-form" id="btn-delete-client" loadingText="Eliminando cliente...">Eliminar cliente</Button>
  </div>
</Modal>

<script>
  import { actions } from 'astro:actions'
  import { toast } from '@/scripts/toast'
  import { navigate } from 'astro:transitions/client'
  import { callAction, setButtonLoading } from '@/scripts/utils'

  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('delete-client-form') as HTMLFormElement
    const modal = document.getElementById('delete-client') as HTMLDialogElement

    if (form.dataset.initialized) return
    form.dataset.initialized = 'true'

    async function deleteClient(e: Event) {
      e.preventDefault()
      const dataForm = new FormData(form)
      setButtonLoading('#btn-delete-client', true)
      const { data, error } = await callAction(actions.clients.delete(dataForm))

      if (error) {
        toast.error(error.message)
        setButtonLoading('#btn-delete-client', false)
        modal.close()
        return
      }

      toast.success(data!.message)
      navigate(data!.data.redirect)
      modal.close()
    }

    form.addEventListener('submit', deleteClient)
  })
</script>
