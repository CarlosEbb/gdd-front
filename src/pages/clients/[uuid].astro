---
import Container from '@/components/ui/Container.astro'
import TitleForPage from '@/components/ui/TitleForPage.astro'
import MainLayout from '@/layouts/MainLayout.astro'
import Link from '@/components/ui/Link.astro'
import Icon from '@/components/ui/Icon.astro'
import Button from '@/components/ui/Button.astro'
import { formatDate } from '@/scripts/utils'
import Tabs from '@/components/tabs/Tabs.astro'
import TabsList from '@/components/tabs/TabsList.astro'
import TabsTrigger from '@/components/tabs/TabsTrigger.astro'
import TabsContent from '@/components/tabs/TabsContent.astro'
import List from '@/components/ui/List.astro'
import { actions } from 'astro:actions'
import EmptyState from '@/components/ui/EmptyState.astro'
import Modal from '@/components/modal/Modal.astro'

const { uuid } = Astro.params
const { PROJECT_URL } = import.meta.env
const { data, error } = await Astro.callAction(actions.clients.getByUuid, { uuid: uuid! })

const client = data?.data || null
const dataBases = client?.databases || []
const hasDatabases = dataBases.length > 0
const servers = client?.servers || []
const hasServers = servers.length > 0

const selectedClient = {
  name: client?.name || '',
  rif: client?.rif || '',
  id: client?.id || 0,
  uuid: client?.uuid || '',
  nroDocumentsMax: client?.nroDocumentsMax || 0,
  nroWorkspacesMax: client?.nroWorkspacesMax || 0,
  createdAt: client?.createdAt || '',
  databases: client?.databases || [],
  servers: client?.servers || [],
  logo: client?.logo ? `${PROJECT_URL}${client.logo}` : null,
}
---

<MainLayout title="Nombre del cliente">
  <Container>
    <TitleForPage title="Detalles del cliente" backHref="/clients" />
    <div class="border-b border-purple-light/20 py-8">
      <div class="flex items-start justify-between">
        <div class="flex items-center gap-5">
          <div class="overflow-hidden rounded-2xl shadow-sm">
            {
              selectedClient.logo !== null ? (
                <img src={selectedClient.logo} alt="Logo del cliente" class="size-16 object-cover" />
              ) : (
                <div class="bg-indigo-600 p-4 text-white">
                  <Icon name="Building2" size={32} />
                </div>
              )
            }
          </div>
          <div>
            <h2 class="text-2xl font-bold text-slate-800">{selectedClient.name}</h2>
            <div class="mt-1 flex items-center gap-3 text-sm text-slate-500">
              <span class="rounded bg-slate-100 px-2 py-0.5 font-mono text-slate-600">RIF: {selectedClient.rif}</span>
              <span>•</span>
              <span class="flex items-center gap-1"><Icon name="Hash" size={14} /> ID: {selectedClient.id}</span>
              <span>•</span>
              <span class="w-32 truncate md:w-48 xl:w-auto" title={selectedClient.uuid}>{selectedClient.uuid}</span>
            </div>
          </div>
        </div>
        <div class="flex gap-2">
          <Link size="sm" variant="secondary" href={`/clients/form-client?edit=true&uuid=${uuid}`}> Editar </Link>
          <Button size="sm" variant="destructive" data-open-modal="delete-client"> Eliminar </Button>
        </div>
      </div>
    </div>

    <section class="mt-6">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        <div class="flex items-center gap-5 rounded-xl border border-gray-200 bg-white p-6">
          <div class="rounded-xl bg-purple-light/10 p-4 text-purple-light"><Icon name="FileText" size={28} /></div>
          <div>
            <p class="mb-1 text-xs font-bold tracking-wider text-slate-400 uppercase">Límite Documentos</p>
            <p class="text-3xl leading-none font-semibold text-slate-800">{selectedClient.nroDocumentsMax}</p>
          </div>
        </div>
        <div class="flex items-center gap-5 rounded-xl border border-gray-200 bg-white p-6">
          <div class="rounded-xl bg-purple-light/10 p-4 text-purple-light"><Icon name="LayoutDashboard" size={28} /></div>
          <div>
            <p class="mb-1 text-xs font-bold tracking-wider text-slate-400 uppercase">Límite Workspaces</p>
            <p class="text-3xl leading-none font-semibold text-slate-800">{selectedClient.nroWorkspacesMax}</p>
          </div>
        </div>
        <div class="flex items-center gap-5 rounded-xl border border-gray-200 bg-white p-6">
          <div class="rounded-xl bg-purple-light/10 p-4 text-purple-light"><Icon name="Calendar" size={28} /></div>
          <div>
            <p class="mb-1 text-xs font-bold tracking-wider text-slate-400 uppercase">Fecha de Registro</p>
            <p class="mt-1 text-sm font-semibold text-slate-800">{formatDate(selectedClient.createdAt as string)}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="mt-6">
      <Tabs defaultValue="dataBase">
        <div class="flex items-center justify-between">
          <TabsList>
            <TabsTrigger value="dataBase"
              >Base de Datos <span class="ml-1 flex aspect-square h-5 w-5 items-center justify-center rounded-full bg-purple-light/10 p-2 text-xs font-semibold text-purple-light"
                >{selectedClient.databases.length}</span
              ></TabsTrigger
            >
            <TabsTrigger value="servidores"
              >Servidores <span class="ml-1 flex aspect-square h-5 w-5 items-center justify-center rounded-full bg-purple-light/10 p-2 text-xs font-semibold text-purple-light"
                >{selectedClient.servers.length}</span
              ></TabsTrigger
            >
          </TabsList>
        </div>

        <TabsContent value="dataBase">
          <div class="grid grid-cols-1 gap-3">
            {
              hasDatabases ? (
                selectedClient.databases.map((database) => <List title={database.nameBd} subtitle={database.idServer.toString()} icon="Database" />)
              ) : (
                <EmptyState title="No hay bases de datos" state="info" hiddenAction={true} />
              )
            }
          </div>
        </TabsContent>

        <TabsContent value="servidores">
          <div class="grid grid-cols-1 gap-3">
            {
              hasServers ? (
                selectedClient.servers.map((server) => (
                  <List title={server.id.toString()} subtitle={server.uuidServer} icon="Server">
                    <div slot="actions">
                      <Link href={`/servers/${server.uuidServer}`} variant="ghost" size="icon">
                        <Icon name="ChevronRight" stroke-width={1.5} size={16} />
                      </Link>
                    </div>
                  </List>
                ))
              ) : (
                <EmptyState title="No hay servidores" description="Agrega un nuevo servidor para este cliente" href="/servers/form-server" hrefText="Crear servidor" state="info" action="create" />
              )
            }
          </div>
        </TabsContent>
      </Tabs>
    </section>
  </Container>
</MainLayout>

<Modal modalId="delete-client" title="Eliminar cliente">
  <form class="space-y-6" id="delete-client-form">
    <div class="flex flex-col items-center justify-center py-5">
      <Icon name="Trash" size={48} stroke-width={1.5} class="text-red-300" />
      <p class="mt-4 mb-1 text-lg font-semibold text-gray-900">{selectedClient.name}</p>
      <p class="mb-4 text-center">¿Estás seguro de querer eliminar este cliente?</p>
      <input type="hidden" name="uuid" value={selectedClient.uuid} required readonly />
    </div>
    <div class="flex justify-end space-x-4 border-t border-gray-200 pt-4">
      <Button type="button" size="sm" variant="outline" data-close-modal>Cancelar</Button>
      <Button type="submit" size="sm" variant="destructive" id="btn-delete-client" loadingText="Eliminando cliente...">Eliminar cliente</Button>
    </div>
  </form>
</Modal>

<script>
  import { actions } from 'astro:actions'
  import { toast } from '@/scripts/toast'
  import { navigate } from 'astro:transitions/client'
  import { callAction, setButtonLoading } from '@/scripts/utils'

  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('delete-client-form') as HTMLFormElement
    const modal = document.getElementById('delete-client') as HTMLDialogElement

    if (form.dataset.initialized) return
    form.dataset.initialized = 'true'

    async function deleteClient(e: Event) {
      e.preventDefault()
      const dataForm = new FormData(form)
      setButtonLoading('#btn-delete-client', true)
      const { data, error } = await callAction(actions.clients.delete(dataForm))

      if (error) {
        toast.error(error.message)
        setButtonLoading('#btn-delete-client', false)
        modal.close()
        return
      }

      toast.success(data!.message)
      navigate(data!.data.redirect)
      modal.close()
    }

    form.addEventListener('submit', deleteClient)
  })
</script>
