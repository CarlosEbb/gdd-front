---
import Container from '@/components/ui/Container.astro'
import MainLayout from '@/layouts/MainLayout.astro'
import Link from '@/components/ui/Link.astro'
import Icon from '@/components/ui/Icon.astro'
import { actions } from 'astro:actions'
import DataGrid from '@/components/ui/DataGrid.astro'
import EmptyState from '@/components/ui/EmptyState.astro'
import type { DetailsClient } from '@/types/clients'
import SearchFilter from '@/components/form/SearchFilter.astro'
import { formatDate } from '@/scripts/utils'
import Header from '@/components/ui/Header.astro'
import CardList from '@/components/ui/CardList.astro'
import Avatar from '@/components/ui/Avatar.astro'
import PermissionGuard from '@/components/ui/PermissionGuard.astro'

const currentPath = Astro.url.pathname
const { data, error } = await Astro.callAction(actions.clients.list, {})

const clients = data?.data || []
const hasClients = clients.length > 0
const totalClients = clients.length
---

<MainLayout title="Clientes">
  <Container>
    <Header title="Gestión de clientes" subtitle={`Total: ${totalClients} clientes`}>
      <PermissionGuard slot="actions" permission="clients.create">
        <Link size="sm" icon="Plus" href="/clients/new">Crear Cliente</Link>
      </PermissionGuard>
    </Header>

    <DataGrid hasData={hasClients} isError={error} grid="x1">
      <EmptyState slot="error-state" title="Error al cargar los clientes" description="Intenta nuevamente." href={currentPath} state="error" />

      <EmptyState slot="empty-state" title="No hay clientes disponibles" description="No tienes ningún cliente registrado." href={currentPath} state="notFound" />

      <div slot="header" class="mb-4">
        <SearchFilter placeholder="Buscar cliente..." target=".client-item" keys={['name', 'rif']} />
      </div>

      <div class="overflow-hidden rounded-main border border-border bg-background">
        {
          clients.map((client: DetailsClient) => (
            <CardList
              class="client-item"
              data-name={client.name}
              data-rif={client.rif}
              title={client.name}
              description={client.rif}
              secondaryText={client.createdAt ? `Creado: ${formatDate(client.createdAt as string)}` : ''}
            >
              <Avatar slot="avatar" size="lg" name={client.name} lastName={client.rif} photo={client.logo} />
              <div slot="actions" class="flex gap-1">
                <PermissionGuard permission="clients.update">
                  <Link href={`/clients/${client.uuid}/edit`} variant="outline" size="icon">
                    <Icon stroke-width={1.5} name="Pencil" size={16} />
                  </Link>
                </PermissionGuard>
                <Link href={`/clients/${client.uuid}`} variant="outline" size="icon">
                  <Icon stroke-width={1.5} name="ChevronRight" size={16} />
                </Link>
              </div>
            </CardList>
          ))
        }
      </div>
    </DataGrid>
  </Container>
</MainLayout>
