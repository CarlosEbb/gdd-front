---
import Container from '@/components/ui/Container.astro'
import MainLayout from '@/layouts/MainLayout.astro'
import Header from '@/components/ui/Header.astro'
import Icon from '@/components/ui/Icon.astro'
import { actions } from 'astro:actions'
import { hasPermission } from '@/lib/permissions/policy'
import type { PermissionData } from '@/lib/permissions/types'

// Enforzamos la carga de permisos y autenticación
const permissions = (await Astro.session?.get('permissions')) as PermissionData | undefined
const isSuperAdmin = permissions ? hasPermission(permissions, 'admin.full') : false

// 1. Obtener la lista de clientes disponibles para auditar
const clientsRes = await Astro.callAction(actions.audits.getClients, {})
const clients = clientsRes.data?.data || []

// 2. Obtener catálogo de filtros (acciones y entidades) para los dropdowns
const filtersRes = await Astro.callAction(actions.audits.getFilters, {})
const filterCatalog = filtersRes.data?.data || { actions: [], entities: [] }

// 3. Leer los filtros de la URL actual para el estado inicial
const url = new URL(Astro.request.url)
const selectedClientUuid = url.searchParams.get('clientUuid') || (clients[0]?.uuid || '')
const selectedAction = url.searchParams.get('action') || ''
const selectedEntity = url.searchParams.get('entity') || ''
const dateFrom = url.searchParams.get('dateFrom') || ''
const dateTo = url.searchParams.get('dateTo') || ''
const page = parseInt(url.searchParams.get('page') || '1', 10)
const limit = 15

// 4. Cargar logs del cliente seleccionado (o general si no hay cliente asignado)
let logsData = { logs: [], pagination: { total: 0, totalPages: 1, page: 1 } }
let fetchError = null

if (selectedClientUuid) {
  const logsRes = await Astro.callAction(actions.audits.getClientLogs, {
    clientUuid: selectedClientUuid,
    action: selectedAction,
    entity: selectedEntity,
    dateFrom,
    dateTo,
    page,
    limit,
  })
  if (logsRes.error) {
    fetchError = logsRes.error
  } else {
    logsData = logsRes.data?.data || logsData
  }
} else if (isSuperAdmin) {
  // Si no hay cliente seleccionado pero es superadmin, traer logs generales
  const logsRes = await Astro.callAction(actions.audits.getGeneralLogs, {
    action: selectedAction,
    entity: selectedEntity,
    dateFrom,
    dateTo,
    page,
    limit,
  })
  if (logsRes.error) {
    fetchError = logsRes.error
  } else {
    logsData = logsRes.data?.data || logsData
  }
}

const logs = logsData.logs || []
const pagination = logsData.pagination
const totalLogs = pagination.total

// Helper estético para las badges de acciones
function getActionBadgeConfig(action: string) {
  if (action.endsWith('.create')) {
    return { bg: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20', label: 'Creación', icon: 'Plus' }
  }
  if (action.endsWith('.delete')) {
    return { bg: 'bg-rose-500/10 text-rose-400 border-rose-500/20', label: 'Eliminación', icon: 'Trash' }
  }
  if (action.includes('assign') || action.includes('update')) {
    return { bg: 'bg-cyan-500/10 text-cyan-400 border-cyan-500/20', label: 'Modificación', icon: 'Pencil' }
  }
  if (action.startsWith('auth.')) {
    return { bg: 'bg-violet-500/10 text-violet-400 border-violet-500/20', label: 'Seguridad', icon: 'Lock' }
  }
  return { bg: 'bg-slate-500/10 text-slate-400 border-slate-500/20', label: 'Acción', icon: 'Activity' }
}

// Formateador estético para fechas con localización en español
function formatAuditDate(dateString: string) {
  const date = new Date(dateString)
  return date.toLocaleString('es-ES', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
  })
}
---

<MainLayout title="Auditorías">
  <Container>
    <Header title="Auditorías del Sistema" subtitle="Registro cronológico oficial para cumplimiento y seguridad">
      <div slot="actions" class="flex gap-2">
        {isSuperAdmin && (
          <button
            id="btn-purge"
            class="flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg border border-rose-500/30 bg-rose-500/10 text-rose-400 hover:bg-rose-500/20 transition-all duration-200 cursor-pointer"
          >
            <Icon stroke-width={2} name="Trash" size={16} />
            <span>Purgar Historial (>180 días)</span>
          </button>
        )}
      </div>
    </Header>

    <!-- BANNER DE FILTROS PREMIUM GLASSMORPHISM -->
    <div class="mb-6 p-5 rounded-xl border border-slate-800/80 bg-slate-900/60 backdrop-blur-md">
      <form id="filters-form" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
        <!-- Selector de Cliente (Solo se muestra dropdown si hay múltiples o es admin) -->
        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-semibold text-slate-400">Cliente a Auditar</label>
          <select
            name="clientUuid"
            class="w-full bg-slate-950/80 border border-slate-800 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:ring-1 focus:ring-primary/50"
          >
            {clients.map((c: any) => (
              <option value={c.uuid} selected={c.uuid === selectedClientUuid}>
                {c.name}
              </option>
            ))}
          </select>
        </div>

        <!-- Filtro Acción -->
        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-semibold text-slate-400">Acción</label>
          <select
            name="action"
            class="w-full bg-slate-950/80 border border-slate-800 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:ring-1 focus:ring-primary/50"
          >
            <option value="">Todas las acciones</option>
            {filterCatalog.actions.map((act: string) => (
              <option value={act} selected={act === selectedAction}>
                {act}
              </option>
            ))}
          </select>
        </div>

        <!-- Filtro Entidad -->
        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-semibold text-slate-400">Entidad</label>
          <select
            name="entity"
            class="w-full bg-slate-950/80 border border-slate-800 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:ring-1 focus:ring-primary/50"
          >
            <option value="">Todas las entidades</option>
            {filterCatalog.entities.map((ent: string) => (
              <option value={ent} selected={ent === selectedEntity}>
                {ent}
              </option>
            ))}
          </select>
        </div>

        <!-- Fecha Desde -->
        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-semibold text-slate-400">Desde</label>
          <input
            type="date"
            name="dateFrom"
            value={dateFrom}
            class="w-full bg-slate-950/80 border border-slate-800 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:ring-1 focus:ring-primary/50"
          />
        </div>

        <!-- Fecha Hasta -->
        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-semibold text-slate-400">Hasta</label>
          <input
            type="date"
            name="dateTo"
            value={dateTo}
            class="w-full bg-slate-950/80 border border-slate-800 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:ring-1 focus:ring-primary/50"
          />
        </div>
      </form>
    </div>

    <!-- TABLA DE LOGS -->
    <div class="overflow-hidden rounded-xl border border-slate-800 bg-slate-950">
      {fetchError && (
        <div class="p-8 text-center text-rose-400">
          <Icon name="AlertTriangle" size={40} class="mx-auto mb-3" />
          <p class="font-medium">Error al cargar registros</p>
          <p class="text-xs opacity-75">{fetchError.message}</p>
        </div>
      )}

      {!fetchError && logs.length === 0 && (
        <div class="p-12 text-center text-slate-500">
          <Icon name="Activity" size={48} class="mx-auto mb-3 opacity-30" />
          <p class="text-base font-semibold">No se encontraron registros de auditoría</p>
          <p class="text-sm opacity-75 mt-1">Intente cambiar los filtros o el rango de fechas.</p>
        </div>
      )}

      {!fetchError && logs.length > 0 && (
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-slate-800/80 bg-slate-900/40 text-xs font-semibold text-slate-400 uppercase tracking-wider">
                <th class="py-4 px-6 w-8"></th>
                <th class="py-4 px-6">Usuario</th>
                <th class="py-4 px-6">Acción</th>
                <th class="py-4 px-6">Recurso Afectado</th>
                <th class="py-4 px-6">Fecha y Hora</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/60 text-sm">
              {logs.map((log: any) => {
                const badge = getActionBadgeConfig(log.action)
                return (
                  <>
                    <!-- Fila Principal (Clic para expandir) -->
                    <tr
                      class="hover:bg-slate-900/30 cursor-pointer transition-colors duration-150 border-slate-800/60 row-clickable"
                      data-target={`details-${log.id}`}
                    >
                      <td class="py-4 px-6 text-center">
                        <span class="chevron-icon inline-block transform transition-transform duration-200 text-slate-500">
                          <Icon name="ChevronRight" size={16} />
                        </span>
                      </td>
                      <td class="py-4 px-6">
                        <div class="flex flex-col">
                          <span class="font-medium text-slate-200">
                            {log.user ? `${log.user.name} ${log.user.lastName}` : 'Sistema / API'}
                          </span>
                          <span class="text-xs text-slate-500">{log.user?.email || 'bypass.admin'}</span>
                        </div>
                      </td>
                      <td class="py-4 px-6">
                        <span class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium border ${badge.bg}`}>
                          {log.action}
                        </span>
                      </td>
                      <td class="py-4 px-6">
                        <div class="flex flex-col">
                          <span class="font-mono text-xs text-slate-300">{log.entityUuid || 'N/A'}</span>
                          <span class="text-xs text-slate-500 uppercase tracking-wider font-semibold">{log.entity}</span>
                        </div>
                      </td>
                      <td class="py-4 px-6 text-slate-300" title={`Timestamp ISO: ${log.createdAt}`}>
                        {formatAuditDate(log.createdAt)}
                      </td>
                    </tr>

                    <!-- Fila Detalle (Oculta por defecto) -->
                    <tr id={`details-${log.id}`} class="hidden bg-slate-900/20">
                      <td colspan="5" class="py-5 px-8">
                        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                          <!-- Metadatos de Red / Contexto -->
                          <div class="flex flex-col gap-3 p-4 rounded-lg bg-slate-950/40 border border-slate-800/50">
                            <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Contexto de Red</h4>
                            <div class="space-y-2 text-xs">
                              <div class="flex justify-between py-1 border-b border-slate-900">
                                <span class="text-slate-500">Dirección IP:</span>
                                <span class="font-mono text-slate-300 font-semibold">{log.ipAddress || '127.0.0.1'}</span>
                              </div>
                              <div class="flex flex-col gap-1 py-1">
                                <span class="text-slate-500">User-Agent:</span>
                                <span class="text-slate-400 wrap-break-word font-mono text-[10px] leading-relaxed">
                                  {log.userAgent || 'Desconocido / Llamada directa de backend'}
                                </span>
                              </div>
                            </div>
                          </div>

                          <!-- Detalles Modificación JSON -->
                          <div class="col-span-2 flex flex-col gap-2">
                            <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider flex items-center gap-2">
                              <Icon name="FileText" size={14} class="text-primary" />
                              <span>Cambios Registrados (JSON)</span>
                            </h4>
                            <pre class="w-full overflow-x-auto p-4 rounded-lg bg-slate-950 border border-slate-800/80 text-xs font-mono text-emerald-400 leading-relaxed max-h-60 overflow-y-auto"><code>{JSON.stringify(log.details, null, 2)}</code></pre>
                          </div>
                        </div>
                      </td>
                    </tr>
                  </>
                )
              })}
            </tbody>
          </table>
        </div>
      )}

      <!-- PAGINACIÓN -->
      {!fetchError && pagination.totalPages > 1 && (
        <div class="flex items-center justify-between px-6 py-4 border-t border-slate-800 bg-slate-900/20">
          <span class="text-xs text-slate-400">
            Página <strong class="text-slate-200">{pagination.page}</strong> de <strong class="text-slate-200">{pagination.totalPages}</strong> ({totalLogs} registros)
          </span>
          <div class="flex gap-2">
            <button
              id="btn-prev"
              disabled={pagination.page <= 1}
              class="px-3 py-1.5 rounded-lg border border-slate-800 bg-slate-950 text-slate-300 text-xs hover:bg-slate-900 disabled:opacity-40 disabled:cursor-not-allowed transition-colors"
            >
              Anterior
            </button>
            <button
              id="btn-next"
              disabled={pagination.page >= pagination.totalPages}
              class="px-3 py-1.5 rounded-lg border border-slate-800 bg-slate-950 text-slate-300 text-xs hover:bg-slate-900 disabled:opacity-40 disabled:cursor-not-allowed transition-colors"
            >
              Siguiente
            </button>
          </div>
        </div>
      )}
    </div>
  </Container>
</MainLayout>

<script is:inline define:vars={{ page, totalPages: pagination.totalPages }}>
  document.addEventListener('astro:page-load', () => {
    // 1. Manejo del acordeón interactivo para ver detalles JSON
    const rows = document.querySelectorAll('.row-clickable');
    rows.forEach(row => {
      row.addEventListener('click', (e) => {
        const targetId = row.getAttribute('data-target');
        const detailsRow = document.getElementById(targetId);
        const chevron = row.querySelector('.chevron-icon');

        if (detailsRow) {
          const isHidden = detailsRow.classList.contains('hidden');
          if (isHidden) {
            detailsRow.classList.remove('hidden');
            if (chevron) chevron.style.transform = 'rotate(90deg)';
          } else {
            detailsRow.classList.add('hidden');
            if (chevron) chevron.style.transform = 'rotate(0deg)';
          }
        }
      });
    });

    // 2. Escuchar cambios en los inputs del formulario de filtros y hacer submit dinámico
    const filtersForm = document.getElementById('filters-form');
    if (filtersForm) {
      const inputs = filtersForm.querySelectorAll('select, input[type="date"]');
      inputs.forEach(input => {
        input.addEventListener('change', () => {
          // Volver a la página 1 cuando cambian los filtros
          const params = new URLSearchParams(new FormData(filtersForm));
          params.set('page', '1');
          window.location.search = params.toString();
        });
      });
    }

    // 3. Manejo de los botones de paginación
    const btnPrev = document.getElementById('btn-prev');
    const btnNext = document.getElementById('btn-next');

    if (btnPrev && page > 1) {
      btnPrev.addEventListener('click', () => {
        const params = new URLSearchParams(window.location.search);
        params.set('page', String(page - 1));
        window.location.search = params.toString();
      });
    }

    if (btnNext && page < totalPages) {
      btnNext.addEventListener('click', () => {
        const params = new URLSearchParams(window.location.search);
        params.set('page', String(page + 1));
        window.location.search = params.toString();
      });
    }

    // 4. Manejo del botón de purga (Solo admin)
    const btnPurge = document.getElementById('btn-purge');
    if (btnPurge) {
      btnPurge.addEventListener('click', async () => {
        const confirmed = confirm('¿Estás seguro de que deseas purgar de forma permanente todos los registros de auditoría de más de 180 días? Esta acción no se puede deshacer.');
        if (!confirmed) return;

        btnPurge.disabled = true;
        btnPurge.style.opacity = '0.5';

        try {
          // Import dynamic Astro Action on the client-side
          const { actions } = await import('astro:actions');
          const res = await actions.audits.purgeLogs();
          if (res.error) {
            alert('Error al purgar los logs: ' + res.error.message);
          } else {
            alert('Purga completada con éxito. Registros eliminados: ' + (res.data?.data?.deletedCount || 0));
            window.location.reload();
          }
        } catch (err) {
          alert('Error inesperado: ' + err.message);
        } finally {
          btnPurge.disabled = false;
          btnPurge.style.opacity = '1';
        }
      });
    }
  });
</script>
