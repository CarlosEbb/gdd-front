---
import Button from '@/components/ui/Button.astro'
import Clients from './Clients.astro'
import Actions from './Actions.astro'
import Entities from './Entities.astro'
import Users from './Users.astro'
import Date from './Date.astro'

interface Props {
  clients: any[]
  selectedClientUuid: string
  filterCatalog: {
    actions: string[]
    entities: string[]
  }
  selectedAction: string
  selectedEntity: string
  filterUsers: any[]
  selectedUserUuid: string
  dateFrom: string
  dateTo: string
}

const { clients, selectedClientUuid, filterCatalog, selectedAction, selectedEntity, filterUsers, selectedUserUuid, dateFrom, dateTo } = Astro.props as Props
---

<!-- Backdrop for mobile -->
<div id="mobile-filters-backdrop" class="fixed inset-0 z-40 hidden bg-background/50 opacity-0 transition-opacity duration-300 md:hidden! [&.is-open]:block [&.is-open]:opacity-100"></div>

<!-- Filters Container (Sidebar on desktop, Modal/Bottom sheet on mobile) -->
<div
  id="sidebar-filters-container"
  class:list={[
    'invisible fixed inset-x-0 bottom-0 z-50 flex max-h-[85vh] translate-y-full flex-col overflow-y-auto rounded-t-3xl border-r border-border bg-background pb-10 opacity-0 shadow-[0_-8px_30px_rgba(0,0,0,0.12)] transition-all duration-300 ease-out',
    '[&.is-open]:visible [&.is-open]:translate-y-0 [&.is-open]:opacity-100',
    'md:visible md:fixed md:top-[57px] md:right-auto md:bottom-0 md:left-0 md:z-10 md:h-[calc(100vh-57px)] md:max-h-none md:w-[280px] md:translate-y-0 md:flex-col md:rounded-none md:border-r md:border-border md:pb-10 md:opacity-100 md:shadow-none lg:left-16 xl:left-[85px]',
  ]}
>
  <div class="mx-auto mt-3 mb-2 h-1.5 w-12 shrink-0 rounded-full bg-gray-300 md:hidden"></div>

  <div class="flex items-center justify-between px-5 py-4">
    <p class="text-md font-medium text-heading">Filtros</p>
    <Button variant="outline" size="sm" id="btn-clear-filters"> Limpiar </Button>
  </div>
  <form id="filters-form" class="space-y-1 px-5 py-4">
    <Clients clients={clients} selectedClientUuid={selectedClientUuid} />
    <Actions filterCatalog={filterCatalog} selectedAction={selectedAction} />
    <Entities filterCatalog={filterCatalog} selectedEntity={selectedEntity} />
    <Users filterUsers={filterUsers} selectedUserUuid={selectedUserUuid} />
    <Date dateFrom={dateFrom} dateTo={dateTo} />
  </form>
</div>

<script>
  function initSidebarFilters() {
    const btnToggle = document.getElementById('btn-toggle-filters')
    const container = document.getElementById('sidebar-filters-container')
    const backdrop = document.getElementById('mobile-filters-backdrop')
    const btnClear = document.getElementById('btn-clear-filters')

    if (!container || !backdrop) return

    function openFilters() {
      container?.classList.add('is-open')
      backdrop?.classList.add('is-open')
    }

    function closeFilters() {
      container?.classList.remove('is-open')
      backdrop?.classList.remove('is-open')
    }

    if (btnToggle) {
      btnToggle.addEventListener('click', (e) => {
        e.stopPropagation()
        openFilters()
      })
    }

    backdrop.addEventListener('click', closeFilters)

    if (btnClear) {
      btnClear.addEventListener('click', (e) => {
        e.preventDefault()
        const params = new URLSearchParams(window.location.search)
        const clientUuid = params.get('clientUuid')
        if (clientUuid) {
          window.location.search = `?clientUuid=${clientUuid}`
        } else {
          window.location.search = ''
        }
      })
    }
  }

  document.addEventListener('astro:page-load', () => {
    initSidebarFilters()
  })
</script>
