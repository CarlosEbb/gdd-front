---
import Accordion from '../Accordion.astro'
import Radio from '../Radio.astro'

interface Props {
  filterCatalog: any
  selectedEntity: string
}

const { filterCatalog, selectedEntity } = Astro.props
---

<Accordion title="Entidad" queryKeys="entity">
  <div class="divide-y divide-border overflow-hidden rounded-main border border-border">
    {
      [{ value: '', label: 'Todas' }, ...filterCatalog.entities.map((ent: string) => ({ value: ent, label: ent }))].map((opt) => {
        const isSelected = opt.value === selectedEntity
        return <Radio name="entity" value={opt.value} label={opt.label} checked={isSelected} />
      })
    }
  </div>
</Accordion>
