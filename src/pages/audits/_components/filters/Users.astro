---
import Accordion from '../Accordion.astro'
import Radio from '../Radio.astro'

interface Props {
  filterUsers: any[]
  selectedUserUuid: string
}

const { filterUsers, selectedUserUuid } = Astro.props as Props
---

<Accordion title="Usuario" queryKeys="userUuid">
  <div class="divide-y divide-border overflow-hidden rounded-main border border-border">
    {
      [{ value: '', label: 'Todos' }, ...filterUsers.map((u: any) => ({ value: u.uuid, label: `${u.name} ${u.lastName} (${u.email.split('@')[0]})` }))].map((opt) => {
        const isSelected = opt.value === selectedUserUuid
        return <Radio name="userUuid" value={opt.value} label={opt.label} checked={isSelected} />
      })
    }
  </div>
</Accordion>
