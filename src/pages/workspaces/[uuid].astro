---
import MainLayout from '@/layouts/MainLayout.astro'
import { actions } from 'astro:actions'
import Header from '@/components/ui/Header.astro'
import Icon from '@/components/ui/Icon.astro'
import Container from '@/components/ui/Container.astro'
import Card from '@/components/ui/Card.astro'
import { formatDate } from '@/scripts/utils'
import Button from '@/components/ui/Button.astro'
import Table from '@/components/ui/Table.astro'
import Modal from '@/components/modal/Modal.astro'
import WorkspaceFormModal from '@/components/modal/WorkspaceFormModal.astro'
import Selector from '@/sections/workspaces/Selector.astro'
const { uuid } = Astro.params

if (!uuid) {
  return Astro.redirect('/home')
}

const workspaces = await Astro.session?.get('workspaces')
const workspaceExists = workspaces?.some((workspace) => workspace.uuid === uuid)

const { data, error } = await Astro.callAction(actions.workspaces.getByUuid, { uuid })

const name = data?.data.name ?? 'Espacio de trabajo no encontrado'
const workspace = data?.data
const status = workspace?.status === 'ACTIVE'
const client = workspace?.client
const hasLogoClient = client?.logo === null
const server = workspace?.dataBase?.server
const database = workspace?.dataBase
const templates = workspace?.templates || []
const columnsTemplates = [
  { key: 'title', label: 'Titulo' },
  { key: 'description', label: 'Descripción', align: 'left' as const },
  { key: 'updatedAt', label: 'Actualización', align: 'left' as const },
]
const rowsTemplates = templates.map((template) => ({
  title: template.title,
  description: template.description,
  updatedAt: formatDate(template.updatedAt),
  href: `/editor/${template.uuid}`,
}))
const getInitials = (name: string) => {
  return name
    .split(' ')
    .map((word) => word[0])
    .join('')
    .toUpperCase()
    .slice(0, 2)
}
---

<MainLayout title={`Espacio de trabajo: ${name}` || 'Espacio de trabajo'}>
  <Container>
    <Header backHref="/workspaces" title={name} subtitle={`Numero de documentos: ${templates.length}`}>
      <div slot="actions">
        <Button size="sm" data-open-modal="edit-workspace" icon="Pencil">Editar</Button>
        <Button size="sm" data-open-modal="delete-workspace" icon="Trash" variant="destructive">Eliminar</Button>
      </div>
    </Header>

    <div>
      <div class="mt-12 mb-6 flex items-center justify-between">
        <h2 class="text-xl font-semibold text-heading">Detalles del espacio de trabajo</h2>
        <Selector workspaces={workspaces || []} currentWorkspaceName={name} />
      </div>
      <div class="mb-4 grid grid-cols-1 gap-4 lg:grid-cols-3">
        <Card>
          <div class="mb-6 flex items-center gap-2 pb-4">
            <Icon name="Info" size={16} class="text-heading" />
            <h2 class="text-xs font-bold tracking-widest text-heading uppercase">Identificación</h2>
          </div>

          <div class="space-y-6">
            <div>
              <p class="mb-1 text-[10px] font-bold tracking-tighter text-subheading uppercase">Espacio de trabajo</p>
              <p class="font-mono text-2xl font-bold text-heading">{workspace?.id}</p>
            </div>
            <div>
              <p class="mb-1 text-[10px] font-bold tracking-tighter text-subheading uppercase">Estado del Entorno</p>
              <div class="flex items-center gap-2 text-sm font-medium">
                <span class="relative flex h-2 w-2">
                  <span class:list={['absolute inline-flex h-full w-full animate-ping rounded-full', status ? 'bg-green-400' : 'bg-red-400', status ? 'opacity-75' : 'opacity-50']}></span>
                  <span class:list={['relative inline-flex h-2 w-2 rounded-full', status ? 'bg-green-500' : 'bg-red-500']}></span>
                </span>
                {status ? <span class="text-green-600">Disponible</span> : <span class="text-red-600">Inactivo</span>}
              </div>
            </div>
            <div>
              <p class="mb-1 text-[10px] font-bold tracking-tighter text-subheading uppercase">Última actualización</p>
              <p class="text-xs font-medium text-heading">{formatDate(workspace?.updatedAt || '')}</p>
            </div>
          </div>
        </Card>

        <Card>
          <div class="mb-6 flex items-center gap-2 pb-4">
            <Icon name="ShieldCheck" size={16} class="text-heading" />
            <h2 class="text-xs font-bold tracking-widest text-heading uppercase">Propietario</h2>
          </div>

          <div class="mb-8 flex items-center gap-4">
            {
              hasLogoClient ? (
                <img src={client?.logo || ''} alt="Logo del cliente" class="h-12 w-12 rounded-full object-cover" />
              ) : (
                <div class="flex h-12 w-12 items-center justify-center rounded-full border border-gray-200 bg-gray-100 text-sm font-bold text-heading">{getInitials(client?.name || '')}</div>
              )
            }
            <div>
              <a href={`/clients/${client?.uuid}`} class="relative z-20 leading-none font-medium tracking-tight text-heading hover:underline">
                {client?.name || 'Nombre no disponible'}
              </a>
              <p class="font-mono text-xs text-heading">RIF: {client?.rif || 'RIF no disponible'}</p>
            </div>
          </div>

          <div class="space-y-6">
            <div class="space-y-2">
              <div class="flex justify-between text-xs">
                <span class="text-subheading uppercase">Espacios disponibles</span>
                <span class="font-bold text-heading">{client?.nroWorkspacesMax || 0}</span>
              </div>
            </div>
            <div class="space-y-2">
              <div class="flex justify-between text-xs">
                <span class="text-subheading uppercase">Documentos</span>
                <span class="font-bold text-heading">{client?.nroDocumentsMax || 0}</span>
              </div>
            </div>
            <div class="space-y-2">
              <div class="flex justify-between text-xs">
                <span class="text-subheading uppercase">Actualización</span>
                <span class="font-bold text-heading">{client?.updatedAt ? formatDate(client?.updatedAt) : 'N/A'}</span>
              </div>
            </div>
          </div>
        </Card>

        <Card>
          <div class="mb-6 flex items-center gap-2 pb-4">
            <Icon name="Database" size={16} class="text-heading" />
            <h2 class="text-xs font-bold tracking-widest text-heading uppercase">Conexión de Datos</h2>
          </div>

          <div class="space-y-4">
            <div class="rounded-xl border border-gray-200 bg-white p-3">
              <p class="mb-1 text-[10px] font-bold text-subheading uppercase">Host de Acceso</p>
              <div class="group flex items-center justify-between">
                <a href={`/servers/${server?.uuid}`} class="relative z-20 font-mono text-sm font-bold text-heading hover:underline">{`${server?.ip}:${server?.puerto}`}</a>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div class="rounded-xl border border-gray-200 bg-white p-3">
                <p class="mb-1 text-[10px] font-bold text-subheading uppercase">Database</p>
                <span class="font-mono text-xs font-bold text-heading">{database?.nameBd}</span>
              </div>
              <div class="rounded-xl border border-gray-200 bg-white p-3">
                <p class="mb-1 text-[10px] font-bold text-subheading uppercase">Usuario</p>
                <span class="font-mono text-xs font-bold text-heading">{database?.username}</span>
              </div>
            </div>

            <div class="flex items-center gap-2 px-1">
              <span class="text-[10px] font-medium tracking-tighter text-subheading uppercase">Actualización: {database?.updatedAt ? formatDate(database?.updatedAt) : 'N/A'}</span>
            </div>
          </div>
        </Card>
      </div>
    </div>

    <div>
      <h2 class="mt-12 mb-6 text-xl font-semibold text-heading">Documentos</h2>
      <Table pageSize={templates.length} columns={columnsTemplates} rows={rowsTemplates} />
    </div>

    <Modal modalId="delete-workspace" title="Eliminar espacio de trabajo">
      <form class="space-y-6" id="delete-workspace-form">
        <div class="flex flex-col items-center justify-center py-5">
          <Icon name="Trash" size={48} class="text-red-300" />
          <p class="mt-4 mb-2 text-lg font-semibold text-heading">{name}</p>
          <p class="mb-4 text-center text-subheading">¿Estás seguro de querer eliminar este espacio de trabajo?</p>
          <input type="hidden" name="uuid" value={workspace?.uuid} required readonly />
        </div>
      </form>

      <div slot="footer">
        <Button type="button" size="sm" variant="outline" data-close-modal>Cancelar</Button>
        <Button variant="destructive" type="submit" size="sm" form="delete-workspace-form" id="btn-delete-workspace" loadingText="Eliminando espacio...">Eliminar espacio</Button>
      </div>
    </Modal>

    <WorkspaceFormModal
      mode="edit"
      workspace={{
        uuid: workspace?.uuid ?? '',
        name: workspace?.name ?? '',
        icon: workspace?.icon ?? '',
        clientUuid: workspace?.uuidClient ?? '',
        serverUuid: workspace?.dataBase?.uuidServer ?? '',
      }}
    />
  </Container>
</MainLayout>

<!-- Eliminar espacio de trabajo -->
<script>
  import { actions } from 'astro:actions'
  import { toast } from '@/scripts/toast'
  import { navigate } from 'astro:transitions/client'
  import { callAction, setButtonLoading } from '@/scripts/utils'

  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('delete-workspace-form') as HTMLFormElement
    const modal = document.getElementById('delete-workspace') as HTMLDialogElement

    if (!form || !modal) return

    // Evitar agregar múltiples listeners
    if (form.dataset.initialized) return
    form.dataset.initialized = 'true'

    async function deleteWorkspace(e: Event) {
      e.preventDefault()
      const dataForm = new FormData(form)
      setButtonLoading('#btn-delete-workspace', true)
      const { data, error } = await callAction(actions.workspaces.delete({ uuid: dataForm.get('uuid') as string }))

      if (error) {
        toast.error(error.message)
        setButtonLoading('#btn-delete-workspace', false)
        modal.close()
        return
      }

      toast.success(data!.message)
      navigate(data!.data.redirect)
      modal.close()
    }

    form.addEventListener('submit', deleteWorkspace)
  })
</script>
