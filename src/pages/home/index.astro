---
import MainLayout from '@/layouts/MainLayout.astro'
import ListLatestOpenid from '@/sections/workspaces/List.astro'
import ListDocuments from '@/sections/documents/List.astro'
import TitleForPage from '@/components/ui/TitleForPage.astro'
import Container from '@/components/ui/Container.astro'

const user = await Astro.session?.get('user')
const name = user.name
---

<MainLayout title="Inicio">
  <Container>
    <TitleForPage showBackButton={false} title={`¡Bienvenido, ${name}!`} />

    <ListLatestOpenid />
    <ListDocuments limit={7} />
  </Container>
</MainLayout>
