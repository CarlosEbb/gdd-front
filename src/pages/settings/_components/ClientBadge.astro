---
import { API_URL } from 'astro:env/client'

interface Props {
  name: string
  logo?: string | null
}

const { name, logo } = Astro.props
const hasLogo = Boolean(logo) && logo !== '{}'
const initials = name
  .trim()
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part.charAt(0).toUpperCase())
  .join('')
---

<span class="flex min-w-0 items-center gap-2" data-client-badge>
  {
    hasLogo ? (
      <img src={`${API_URL}${logo}`} alt="" loading="lazy" class="size-6 shrink-0 rounded-full border border-border object-cover" />
    ) : (
      <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-primary text-xs font-semibold text-white">{initials || '?'}</span>
    )
  }
  <span class="truncate text-sm font-medium text-heading">{name}</span>
</span>
