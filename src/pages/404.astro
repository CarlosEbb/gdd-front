---
import Layout from '@/layouts/Layout.astro'
import notFoundImage from '@/assets/images/imagotipo.png'
import Link from '@/components/ui/Link.astro'

const isAuthenticated = await Astro.session?.has('token')
const redirectTo = isAuthenticated ? '/home' : '/'
---

<Layout title="404">
  <div class="flex min-h-screen items-center justify-center bg-foreground">
    <div class="flex min-h-80 min-w-4xl flex-col items-center justify-center space-y-14 rounded-main border border-dashed border-border p-16 text-center shadow-base">
      <img src={notFoundImage.src} transition:name="image-transition" transition:animate="fade" alt="404" width={400} height={400} />
      <h1 class="text-7xl font-bold text-heading">404</h1>
      <div class="space-y-4">
        <div>
          <p class="mt-4 text-xl text-subheading">Página no encontrada</p>
          <p class="mt-2 text-subheading">La página que buscas no existe o ha sido movida.</p>
        </div>
        <Link href={redirectTo} variant="gradient" size="sm"> Volver </Link>
      </div>
    </div>
  </div>
</Layout>
