---
import EmptyState from '@/components/ui/EmptyState.astro'
import Layout from '../_components/Layout.astro'

const { uuid } = Astro.params
const build_number = Astro.url.searchParams.get('build_number') as string

if (!uuid || !build_number) {
  return Astro.redirect('/home')
}
---

<Layout title="Seguridad">
  <EmptyState title="Seguridad" description="En construcción" />
</Layout>
