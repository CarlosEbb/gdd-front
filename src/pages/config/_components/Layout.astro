---
import Dropdown from '@/components/ui/Dropdown.astro'
import TabsLayout from '@/layouts/TabsLayout.astro'
import { actions } from 'astro:actions'
interface Props {
  title: string
}

const { uuid } = Astro.params
const { title } = Astro.props

const buildNumber = Astro.url.searchParams.get('build_number') as string
const nameWorkspace = Astro.url.searchParams.get('name_workspace') as string

const NAVIGATION = [
  { href: `/config/version/${uuid}?build_number=${buildNumber}`, label: 'Versiones' },
  { href: `/config/documentation/${uuid}?build_number=${buildNumber}`, label: 'Documentación' },
  { href: `/config/validation/${uuid}?build_number=${buildNumber}`, label: 'Validaciones' },
  { href: `/config/security/${uuid}?build_number=${buildNumber}`, label: 'Seguridad' },
  { href: `/config/metrics/${uuid}?build_number=${buildNumber}`, label: 'Métricas' },
  { href: `/config/generated/${uuid}?build_number=${buildNumber}`, label: 'Generados' },
]

const { data } = await Astro.callAction(actions.documents.getByUser, { limit: null })
const documents = data?.data ?? []
const getCurrentUrl = Astro.url.pathname
const [_, page, tab] = getCurrentUrl.split('/')
---

<TabsLayout title={title} navigation={NAVIGATION} subtitle={nameWorkspace ? `Espacio de trabajo: ${nameWorkspace}` : ''} titleForPage="Gestionar documento">
  <div slot="actions">
    <Dropdown shadow="none" buttonLabel="Cambiar documento">
      <ul>
        {
          documents.map((document) => (
            <li>
              <a href={`/${page}/${tab}/${document.uuid}?build_number=${buildNumber}`} class="flex items-center gap-x-2 px-4 py-2 text-sm text-heading hover:bg-foreground">
                {document.name}
              </a>
            </li>
          ))
        }
      </ul>
    </Dropdown>
  </div>

  <slot />
</TabsLayout>
