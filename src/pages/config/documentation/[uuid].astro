---
import ConfigLayout from '@/layouts/ConfigLayout.astro'
import { actions } from 'astro:actions'
import { Code } from 'astro:components'
import Icon from '@/components/ui/Icon.astro'
import Card from '@/components/ui/Card.astro'
import Button from '@/components/ui/Button.astro'
import StateSwitch from '@/components/ui/StateSwitch.astro'
import EmptyState from '@/components/ui/EmptyState.astro'

const { uuid } = Astro.params

if (!uuid) return Astro.redirect('/home')

const build_number = Astro.url.searchParams.get('build_number') as string

const url = `/documents/${uuid}/${build_number}`
const urlUuid =`/documents/${uuid}`

const { PUBLIC_PROJECT_URL: base_url, PUBLIC_PROJECT_URL: project_url } = import.meta.env
console.log(base_url, project_url)

const responseExample = {
  status: 201,
  message: 'Documento guardado con versión específica',
  data: {
    url: `${project_url}/documents/viewPDF/5klBqz6MH1v7F74hksoDA6wSWWT6xhU2VK36rURb`,
    build_number: '1.00',
  },
}

const { data, error } = await Astro.callAction(actions.documents.getRequestForDocument, { uuid_template: uuid, build_number: build_number })
const request = data?.data?.variables
const buildNumberLastVersion = data?.data?.build_number || ''
const url = `/documents/${uuid}/${buildNumberLastVersion}`
const urlLatest = `/documents/${uuid}`

const token = data?.data.template.jwt_token
const bearerToken = token ?? 'tu_token'
const authorizationHeader = {
  Authorization: `Bearer ${bearerToken}`,
}
const request = data?.data.variables
---

<ConfigLayout title="Documentación">
  <div class="relative w-full max-w-full overflow-x-hidden">
    <div class="flex w-full max-w-full min-w-0 items-stretch gap-x-2 pe-0 sm:gap-x-3 sm:pe-5 md:gap-x-10">
      <div class="flex flex-col items-center">
        <div class="z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full border-4 border-white bg-custom-blue3 text-base font-bold text-white shadow-lg sm:h-12 sm:w-12 sm:text-xl">
          1
        </div>
        <div class="-my-2 h-full w-0.5 bg-custom-blue3/60"></div>
      </div>

      <div class="w-full max-w-full min-w-0 pt-2 pb-16">
        <h3 class="mb-3 text-xl font-bold text-slate-900 sm:text-2xl">Endpoint (URL)</h3>
        <p class="mb-6 leading-relaxed text-slate-600">
          Todas las peticiones deben realizarse a través de HTTPS. Para crear un nuevo documento, utiliza el endpoint de documentos. Asegúrate de incluir tu API Key en los headers.
          <br/>
          <span class="text-xs text-neutral-400">
            <strong>Nota:</strong> Si la endpoint no se le agrega el numero de version <strong>siempre tomara la ultima version</strong>
          </span>
        </p>

        <div class="w-full max-w-full overflow-hidden rounded-xl bg-custom-blue3/10 shadow-lg ring-1 ring-custom-blue3/60">
          <div class="flex w-full min-w-0 flex-col items-start justify-between gap-3 border-b border-custom-blue3/60 bg-custom-blue3/40 px-3 py-3 sm:flex-row sm:items-center sm:px-4">
            <div class="flex space-x-2">
              <div class="h-3 w-3 rounded-full bg-red-500"></div>
              <div class="h-3 w-3 rounded-full bg-yellow-500"></div>
              <div class="h-3 w-3 rounded-full bg-green-500"></div>
            </div>
            <div class="flex min-w-0 items-center gap-2">
              <span class="font-mono text-xs text-custom-blue3">POST Request</span>
              <button class="copy-btn p-1 text-custom-blue3 transition-colors hover:text-white" title="Copiar URL" data-content={base_url + url}>
                <Icon name="Copy" stroke-width={1.5} class="size-4" />
              </button>
            </div>
          </div>
          <div class="code-scroll w-full max-w-full overflow-hidden p-4 font-mono text-sm sm:p-6">

                        <span class="bg-brand-500/20 text-brand-400 rounded px-2 py-1 mt-5 text-xs font-normal tracking-wider"> * Solicitar por versión</span>
            <div class="flex min-w-0 flex-col items-start gap-3 sm:flex-row sm:items-center mb-5">
              <span class="bg-brand-500/20 text-brand-400 rounded px-2 py-1 text-xs font-bold tracking-wider uppercase">POST</span>
              <span class="min-w-0 break-all text-custom-blue3">{base_url}<span class="text-brand-400">{url}</span></span>
            </div>

            <span class="bg-brand-500/20 text-brand-400 rounded px-2 py-1 mt-5 text-xs font-normal tracking-wider"> * Solicitar última versión</span>
            <div class="flex min-w-0 flex-col items-start gap-3 sm:flex-row sm:items-center">
              <span class="bg-brand-500/20 text-brand-400 rounded px-2 py-1 text-xs font-bold tracking-wider uppercase">POST</span>
              <span class="min-w-0 break-all text-custom-blue3">{base_url}<span class="text-brand-400">{urlUuid}</span></span>
            </div>
          </div>
        </div>

    <div class="flex w-full max-w-full min-w-0 items-stretch gap-x-2 pe-0 sm:gap-x-3 sm:pe-5 md:gap-x-10">
      <div class="flex flex-col items-center">
        <div class="z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full border-4 border-white bg-custom-blue3 text-base font-bold text-white shadow-lg sm:h-12 sm:w-12 sm:text-xl">
          2
        </div>
        <div class="-my-2 h-full w-0.5 bg-custom-blue3/60"></div>
      </div>

      <div class="w-full max-w-full min-w-0 pt-2 pb-16">
        <h3 class="mb-3 text-xl font-bold text-slate-900 sm:text-2xl">Autenticación</h3>
        <p class="mb-6 leading-relaxed text-slate-600">
          Debes enviar tu token de acceso en los headers de la petición usando el esquema <code>Bearer</code> para autorizar la creación del documento.
        </p>

        <div class="w-full max-w-full overflow-hidden rounded-xl bg-custom-blue3/10 shadow-lg ring-1 ring-custom-blue3/60">
          <div class="flex w-full min-w-0 items-center justify-between gap-3 border-b border-custom-blue3/60 bg-custom-blue3/40 px-3 py-2 sm:px-4">
            <span class="font-mono text-xs text-custom-blue3">headers</span>
            <button class="copy-btn p-1 text-custom-blue3 transition-colors hover:text-white" title="Copiar token" data-copy-type="token" data-content={bearerToken}>
              <Icon name="Copy" stroke-width={1.5} class="size-4" />
            </button>
          </div>
          <div class="code-scroll code-container w-full max-w-full overflow-hidden p-3 sm:p-4">
            <Code theme="catppuccin-latte" lang="json" defaultColor={false} code={JSON.stringify(authorizationHeader, null, 2)} />
          </div>
        </div>
      </div>
    </div>

    <div class="flex w-full max-w-full min-w-0 items-stretch gap-x-2 pe-0 sm:gap-x-3 sm:pe-5 md:gap-x-10">
      <div class="flex flex-col items-center">
        <div class="z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full border-4 border-white bg-custom-blue3 text-base font-bold text-white shadow-lg sm:h-12 sm:w-12 sm:text-xl">
          3
        </div>
        <div class="-my-2 h-full w-0.5 bg-custom-blue3/60"></div>
      </div>

      <div class="w-full max-w-full min-w-0 pt-2 pb-16">
        <h3 class="mb-3 text-xl font-bold text-slate-900 sm:text-2xl">Petición</h3>
        <p class="mb-4 leading-relaxed text-slate-600">Envía un objeto JSON en el cuerpo de la petición. todos los campos son obligatorios para iniciar el proceso.</p>
        <ul class="mb-6 space-y-2">
          <li class="flex items-center gap-2 text-sm text-slate-600">
            <svg class="h-4 w-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"
              ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg
            >
            Validación automática de campos requeridos
          </li>
          <li class="flex items-center gap-2 text-sm text-slate-600">
            <svg class="h-4 w-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"
              ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg
            >
            Soporte para variables personalizadas
          </li>
        </ul>

        <div class="w-full max-w-full overflow-hidden rounded-xl bg-custom-blue3/10 shadow-lg ring-1 ring-custom-blue3/60">
          <div class="flex w-full min-w-0 items-center justify-between gap-3 border-b border-custom-blue3/60 bg-custom-blue3/40 px-3 py-2 sm:px-4">
            <span class="font-mono text-xs text-custom-blue3">body.json</span>
            <button class="copy-btn p-1 text-custom-blue3 transition-colors hover:text-white" title="Copiar código" data-copy-type="body" data-content={JSON.stringify(request, null, 2)}>
              <Icon name="Copy" stroke-width={1.5} class="size-4" />
            </button>
          </div>
          <div class="code-scroll code-container w-full max-w-full overflow-hidden p-3 sm:p-4">
            <Code theme="catppuccin-latte" lang="json" defaultColor={false} code={JSON.stringify(request, null, 2)} />
          </div>
        </div>
      </div>
    </div>

    <div class="flex w-full max-w-full min-w-0 items-start gap-x-2 pe-0 sm:gap-x-3 sm:pe-5 md:gap-x-10">
      <div class="flex flex-col items-center">
        <div class="z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full border-4 border-white bg-custom-blue3 text-base font-bold text-white shadow-lg sm:h-12 sm:w-12 sm:text-xl">
          4
        </div>
      </div>

      <div class="w-full max-w-full min-w-0 pt-2 pb-16">
        <h3 class="mb-3 text-xl font-bold text-slate-900 sm:text-2xl">Respuesta</h3>
        <p class="mb-6 leading-relaxed text-slate-600">
          Si todo es correcto, recibirás un código <code>200 OK</code>. La respuesta incluirá un <code>uuid</code> único de documento que deberás y la url para ver el documento.
        </p>
        <div class="mt-4 ml-12 overflow-hidden rounded-main border border-border bg-muted">
          <div class="code-scroll overflow-x-auto bg-background p-4 font-mono text-sm">
            <div class="flex items-center justify-between gap-2">
              <div>
                <span class="text-muted-foreground">1</span>
                <span class="text-pink-600">POST</span>
                <span class="text-heading">{base_url}<span class="text-primary">{urlLatest}</span></span>
              </div>

        <div class="w-full max-w-full overflow-hidden rounded-xl bg-custom-blue3/10 shadow-lg ring-1 ring-custom-blue3/60">
          <div class="flex w-full min-w-0 items-center justify-between gap-3 border-b border-custom-blue3/60 bg-custom-blue3/40 px-3 py-2 sm:px-4">
            <div class="flex items-center gap-2">
              <span class="flex h-2 w-2 rounded-full bg-custom-blue3"></span>
              <span class="font-mono text-xs font-bold text-custom-blue3">200 OK</span>
            </div>
          </div>
        </div>
      </Card>

      <Card class="overflow-visible">
        <div class="flex items-start gap-4">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary-foreground text-sm font-semibold text-primary">2</div>
          <div class="flex-1">
            <h3 class="text-base font-semibold text-heading">Autenticación</h3>
            <p class="mt-1 text-sm text-subheading">Debes enviar tu token de acceso en los headers de la petición usando el esquema <code>Bearer</code> para autorizar la creación del documento.</p>
          </div>
        </div>

        <div class="mt-4 ml-12">
          <!-- JSON Headers -->
          <div id="header-json" class="format-block-header overflow-hidden rounded-main border border-border bg-background">
            <div class="flex items-center justify-between border-b border-border bg-secondary px-4 py-2">
              <div class="flex items-center gap-2">
                <Icon name="Terminal" stroke-width={1.5} class="size-4 text-muted-foreground" />
                <span class="font-mono text-xs text-muted-foreground">headers</span>
              </div>
              <button class="copy-btn p-1 text-muted-foreground transition-colors hover:text-heading" title="Copiar código" data-content={JSON.stringify(authorizationHeaderJson, null, 2)}>
                <Icon name="Copy" stroke-width={1.5} class="size-4" />
              </button>
            </div>
            <div class="code-scroll code-container overflow-x-auto p-4">
              <Code theme="catppuccin-latte" lang="json" defaultColor={false} code={JSON.stringify(authorizationHeaderJson, null, 2)} />
            </div>
          </div>

          <!-- XML Headers -->
          <div id="header-xml" class="format-block-header hidden overflow-hidden rounded-main border border-border bg-background">
            <div class="flex items-center justify-between border-b border-border bg-secondary px-4 py-2">
              <div class="flex items-center gap-2">
                <Icon name="Terminal" stroke-width={1.5} class="size-4 text-muted-foreground" />
                <span class="font-mono text-xs text-muted-foreground">headers</span>
              </div>
              <button class="copy-btn p-1 text-muted-foreground transition-colors hover:text-heading" title="Copiar código" data-content={JSON.stringify(authorizationHeaderXml, null, 2)}>
                <Icon name="Copy" stroke-width={1.5} class="size-4" />
              </button>
            </div>
            <div class="code-scroll code-container overflow-x-auto p-4">
              <Code theme="catppuccin-latte" lang="json" defaultColor={false} code={JSON.stringify(authorizationHeaderXml, null, 2)} />
            </div>
          </div>
        </div>
      </Card>

      <Card class="overflow-visible">
        <div class="flex items-start gap-4">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary-foreground text-sm font-semibold text-primary">3</div>
          <div class="flex-1">
            <h3 class="text-base font-semibold text-heading">Datos que debe contener la solicitud</h3>
            <p class="mt-1 text-sm text-subheading">Envía un objeto JSON o XML en el cuerpo de la petición. Todos los campos son obligatorios para iniciar el proceso.</p>
          </div>
        </div>

        <div class="mt-4 ml-12">
          <div id="block-json" class="format-block overflow-hidden rounded-main border border-border bg-background">
            <div class="flex items-center justify-between border-b border-border bg-secondary px-4 py-2">
              <div class="flex items-center gap-2">
                <Icon name="Terminal" stroke-width={1.5} class="size-4 text-muted-foreground" />
                <span class="font-mono text-xs text-muted-foreground">body.json</span>
              </div>
              <button class="copy-btn copy-body-btn p-1 text-muted-foreground transition-colors hover:text-heading" title="Copiar código" data-content={JSON.stringify(request, null, 2)}>
                <Icon name="Copy" stroke-width={1.5} class="size-4" />
              </button>
            </div>
            <div class="code-scroll code-container overflow-x-auto p-4">
              <Code theme="catppuccin-latte" lang="json" defaultColor={false} code={JSON.stringify(request, null, 2)} />
            </div>
          </div>

          <div id="block-xml" class="format-block hidden overflow-hidden rounded-main border border-border bg-background">
            <div class="flex items-center justify-between border-b border-border bg-secondary px-4 py-2">
              <div class="flex items-center gap-2">
                <Icon name="Terminal" stroke-width={1.5} class="size-4 text-muted-foreground" />
                <span class="font-mono text-xs text-muted-foreground">body.xml</span>
              </div>
              <button class="copy-btn copy-body-xml-btn p-1 text-muted-foreground transition-colors hover:text-heading" title="Copiar código" data-content={requestXml}>
                <Icon name="Copy" stroke-width={1.5} class="size-4" />
              </button>
            </div>
            <div class="code-scroll code-container overflow-x-auto p-4">
              <Code theme="catppuccin-latte" lang="xml" defaultColor={false} code={requestXml} />
            </div>
          </div>
        </div>
      </Card>

      <Card class="overflow-visible">
        <div class="flex items-start gap-4">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary-foreground text-sm font-semibold text-primary">4</div>
          <div class="flex-1">
            <h3 class="text-base font-semibold text-heading">Respuesta que devolverá el servidor</h3>
            <p class="mt-1 text-sm text-subheading">
              Si todo es correcto, recibirás un código <code class="rounded bg-muted px-1.5 py-0.5 text-xs">200 OK</code>. La respuesta incluirá un <code class="rounded bg-muted px-1.5 py-0.5 text-xs"
                >uuid</code
              > único de documento y la url para ver el documento.
            </p>
          </div>
        </div>

        <div class="mt-4 ml-12 overflow-hidden rounded-main border border-border bg-background">
          <div class="flex items-center justify-between border-b border-border bg-secondary px-4 py-2">
            <div class="flex items-center gap-2">
              <Icon name="Terminal" stroke-width={1.5} class="size-4 text-muted-foreground" />
              <span class="font-mono text-xs text-muted-foreground">response.json</span>
            </div>
            <button class="copy-btn p-1 text-muted-foreground transition-colors hover:text-heading" title="Copiar código" data-content={JSON.stringify(responseExample, null, 2)}>
              <Icon name="Copy" stroke-width={1.5} class="size-4" />
            </button>
          </div>
          <div class="code-scroll code-container w-full max-w-full overflow-hidden p-3 sm:p-4">
            <Code theme="catppuccin-latte" lang="json" code={JSON.stringify(responseExample, null, 2)} />
          </div>
        </div>
      </Card>

    <div class="flex w-full max-w-full min-w-0 items-start gap-x-2 pe-0 sm:gap-x-3 sm:pe-5 md:gap-x-10">
      <div class="flex flex-col items-center">
        <div class="z-10 flex h-12 w-12 shrink-0"></div>
      </div>

      <div class="w-full max-w-full min-w-0 pt-2 pb-16">
        <h3 class="mb-3 text-xl font-bold text-slate-900 sm:text-2xl">Cómo importar en Postman:</h3>
        <p class="mb-6 leading-relaxed text-slate-600">Para importar la colección en Postman, haz clic en el botón de descarga y sigue las instrucciones.</p>

        <div class="w-full max-w-full overflow-hidden rounded-xl bg-orange-50 shadow-lg ring-1 ring-orange-800/60">
          <div class="code-scroll code-container flex w-full max-w-full flex-col items-start justify-between gap-4 overflow-hidden p-4 md:flex-row md:gap-6">
            <ol class="space-y-1 text-left text-sm text-orange-800">
              <li class="flex items-start gap-2">
                <span class="font-bold">1.</span>
                <span>Haz clic en el botón de descarga</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="font-bold">2.</span>
                <span>Abre Postman (Desktop o Web)</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="font-bold">3.</span>
                <span>Ve a <span class="rounded bg-orange-100 px-1.5 py-0.5 font-mono text-xs">File → Import</span></span>
              </li>
              <li class="flex items-start gap-2">
                <span class="font-bold">4.</span>
                <span>Selecciona el archivo descargado</span>
              </li>
            </ol>
            <input type="text" value={base_url} id="url_base" hidden />
            <input type="text" value={bearerToken} id="auth_token" hidden />
            <button
              class="postman-btn group mt-4 flex items-center gap-3 rounded-xl bg-linear-to-r from-orange-500 to-orange-600 px-4 py-2 text-sm font-semibold text-white shadow-lg transition-all hover:scale-105 hover:shadow-xl md:mt-0"
            >
              <span>Descargar para Postman</span>
              <Icon name="Download" stroke-width={2} class="size-5 transition-transform group-hover:translate-y-1" />
            </button>
          </div>
        </div>

        <ol class="relative ml-12 space-y-6 border-l border-border">
          <li class="relative pl-6">
            <span class="absolute top-1 -left-[7px] h-3 w-3 rounded-full border-2 border-primary bg-background"></span>
            <p class="text-sm text-heading">Descarga la colección de Postman</p>
            <Button variant="secondary" size="sm" icon="Download" class="postman-btn mt-3" data-token={bearerToken}>Descargar colección</Button>
          </li>
          <li class="relative pl-6">
            <span class="absolute top-1 -left-[7px] h-3 w-3 rounded-full border-2 border-primary bg-background"></span>
            <p class="text-sm text-heading">Abre Postman (Desktop o Web)</p>
          </li>
          <li class="relative pl-6">
            <span class="absolute top-1 -left-[7px] h-3 w-3 rounded-full border-2 border-primary bg-background"></span>
            <p class="text-sm text-heading">Ve a <code class="rounded bg-secondary px-1.5 py-0.5 font-mono text-xs">File → Import</code></p>
          </li>
          <li class="relative pl-6">
            <span class="absolute top-1 -left-[7px] h-3 w-3 rounded-full border-2 border-primary bg-background"></span>
            <p class="text-sm text-heading">Selecciona el archivo descargado</p>
          </li>
        </ol>

        <div slot="footer" class="flex items-start gap-2 text-sm text-subheading">
          <Icon name="Info" stroke-width={1.5} class="mt-0.5 size-4 shrink-0 text-primary" />
          <p>
            El archivo descargado es una <strong>colección estándar</strong> compatible con herramientas como <strong>Postman</strong>, <strong>Bruno</strong>, <strong>Insomnia</strong> o
            <strong>ApiDog</strong>. Impórtala en la herramienta de tu preferencia para consumir el servicio sin configuración manual.
          </p>
        </div>
      </Card>
    </div>

    <EmptyState slot="error" title="Error al cargar la documentación" description="No se pudo cargar la documentación para este documento." />

    <EmptyState
      slot="empty"
      title="Documentación no disponible"
      state="info"
      action="create"
      hrefText="Crear versión"
      href={`/config/version/${uuid}?build_number=${build_number}`}
      description={data?.message || 'No se encontró documentación para este documento.'}
    />
  </StateSwitch>
</Layout>

<script>
  import { toast } from '@/scripts/toast'
  import { PUBLIC_CARGA_URL, PUBLIC_NAME_PROJECT } from 'astro:env/client'

  function setupCopyButtons() {
    const buttons = document.querySelectorAll('.copy-btn')

    buttons.forEach((btn) => {
      const button = btn as HTMLElement

      if (button.dataset.listenerAdded === 'true') return

      button.addEventListener('click', async () => {
        const content = button.getAttribute('data-content')
        if (content) {
          try {
            await navigator.clipboard.writeText(content)

            button.style.color = '#22c55e'
            toast.success('Copiado al portapapeles')

            setTimeout(() => {
              button.style.color = ''
            }, 2000)
          } catch (err) {
            toast.error('Error al copiar')
            console.error('Error al copiar: ', err)
          }
        }
      })

      button.dataset.listenerAdded = 'true'
    })
  }

  function setupPostmanButton() {
    const postmanButtons = document.querySelectorAll('.postman-btn')

    postmanButtons.forEach((btn) => {
      const button = btn as HTMLElement

      if (button.dataset.listenerAdded === 'true') return

      button.addEventListener('click', () => {
        const url = window.location.pathname
        const uuid = url.split('/').pop()
        const buildNumber = new URLSearchParams(window.location.search).get('build_number')
        const baseUrl = document.getElementById('url_base') as HTMLInputElement
        const authToken = document.getElementById('auth_token') as HTMLInputElement
        const endpoint = `/documents/${uuid}/${buildNumber}`

        const copyBtn = document.querySelector('.copy-btn[data-copy-type="body"]') as HTMLElement
        const requestBody = copyBtn?.getAttribute('data-content') || '{}'
        const bearerToken = authToken?.value || 'tu_token'

        const copyXmlBtn = document.querySelector('.copy-body-xml-btn') as HTMLElement
        const requestXmlBody = copyXmlBtn?.getAttribute('data-content') || '<?xml version="1.0" encoding="UTF-8"?>\n<document>\n</document>'

        const activeFormat = document.querySelector('.format-tab.active')?.getAttribute('data-format') || 'json'

        const jsonItem = {
          name: 'Crear Documento (JSON)',
          request: {
            method: 'POST',
            header: [
              { key: 'Content-Type', value: 'application/json' },
              { key: 'Authorization', value: `Bearer ${button.getAttribute('data-token') || 'tu_token'}` },
            ],
            body: { mode: 'raw', raw: requestBody, options: { raw: { language: 'json' } } },
            url: {
              raw: PUBLIC_CARGA_URL + endpoint,
              protocol: 'https',
              host: [PUBLIC_CARGA_URL.replace('https://', '').replace('http://', '')],
              path: endpoint.split('/').filter(Boolean),
            },
            description: 'Endpoint para crear un nuevo documento con las variables especificadas en formato JSON',
          },
          response: [],
        }

        const xmlItem = {
          name: 'Crear Documento (XML)',
          request: {
            method: 'POST',
            header: [
              { key: 'Content-Type', value: 'application/xml' },
              { key: 'Authorization', value: `Bearer ${button.getAttribute('data-token') || 'tu_token'}` },
            ],
            body: { mode: 'raw', raw: requestXmlBody, options: { raw: { language: 'xml' } } },
            url: {
              raw: PUBLIC_CARGA_URL + endpoint,
              protocol: 'https',
              host: [PUBLIC_CARGA_URL.replace('https://', '').replace('http://', '')],
              path: endpoint.split('/').filter(Boolean),
            },
            description: 'Endpoint para crear un nuevo documento con las variables especificadas en formato XML',
          },
          response: [],
        }

        const postmanCollection = {
          info: {
            name: `${PUBLIC_NAME_PROJECT} - Documento ${uuid}`,
            description: `Colección generada automáticamente para crear documentos en formato ${activeFormat.toUpperCase()}.`,
            schema: 'https://schema.getpostman.com/json/collection/v2.1.0/collection.json',
          },
          item: [
            {
              name: 'Crear Documento',
              request: {
                method: 'POST',
                header: [
                  {
                    key: 'Content-Type',
                    value: 'application/json',
                  },
                  {
                    key: 'Authorization',
                    value: `Bearer ${bearerToken}`,
                  },
                ],
                body: {
                  mode: 'raw',
                  raw: requestBody,
                  options: {
                    raw: {
                      language: 'json',
                    },
                  },
                },
                url: {
                  raw: baseUrl.value + endpoint,
                  protocol: 'https',
                  host: [baseUrl.value.replace('https://', '').replace('http://', '')],
                  path: endpoint.split('/').filter(Boolean),
                },
                description: 'Endpoint para crear un nuevo documento con las variables especificadas',
              },
              response: [],
            },
          ],
          variable: [],
        }

        const collectionJson = JSON.stringify(postmanCollection, null, 2)

        const blob = new Blob([collectionJson], { type: 'application/json' })
        const blobUrl = URL.createObjectURL(blob)

        const downloadLink = document.createElement('a')
        downloadLink.href = blobUrl
        downloadLink.download = `${PUBLIC_NAME_PROJECT}-Documento-${uuid}.collection.json`
        downloadLink.style.display = 'none'
        document.body.appendChild(downloadLink)

        downloadLink.click()

        setTimeout(() => {
          document.body.removeChild(downloadLink)
          URL.revokeObjectURL(blobUrl)
        }, 100)

        toast.success('¡Colección descargada!')
      })

      button.dataset.listenerAdded = 'true'
    })
  }

  function setupTabs() {
    const tabs = document.querySelectorAll('.format-tab')

    tabs.forEach((tab) => {
      if ((tab as HTMLElement).dataset.listenerAdded === 'true') return

      tab.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement
        const format = target.dataset.format

        // Update active class on tabs
        document.querySelectorAll('.format-tab').forEach((t) => {
          t.classList.remove('active', 'bg-primary', 'text-primary-foreground')
          t.classList.add('text-muted-foreground', 'hover:text-heading')
        })

        target.classList.add('active', 'bg-primary', 'text-primary-foreground')
        target.classList.remove('text-muted-foreground', 'hover:text-heading')

        // Show/hide blocks
        document.querySelectorAll('.format-block').forEach((b) => b.classList.add('hidden'))
        document.getElementById(`block-${format}`)?.classList.remove('hidden')

        document.querySelectorAll('.format-block-header').forEach((b) => b.classList.add('hidden'))
        document.getElementById(`header-${format}`)?.classList.remove('hidden')
      })
      ;(tab as HTMLElement).dataset.listenerAdded = 'true'
    })
  }

  setupCopyButtons()
  setupPostmanButton()
  setupTabs()

  document.addEventListener('astro:page-load', () => {
    setupCopyButtons()
    setupPostmanButton()
    setupTabs()
  })
</script>
