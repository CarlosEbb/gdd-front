---
import Card from '@/components/ui/Card.astro'
import Tabs from '@/components/tabs/Tabs.astro'
import TabsList from '@/components/tabs/TabsList.astro'
import TabsTrigger from '@/components/tabs/TabsTrigger.astro'
import TabsContent from '@/components/tabs/TabsContent.astro'
import Link from '@/components/ui/Link.astro'
import CodeEditor from '@/components/editor/CodeEditor.astro'
---

<Card class="flex h-full min-h-112 flex-col" data-response-card>
  <Tabs defaultValue="response" variant="line" class="flex h-full min-h-0 flex-1 flex-col">
    <div class="flex w-full shrink-0 flex-nowrap items-center justify-between gap-3">
      <TabsList class="w-auto! min-w-0 shrink">
        <TabsTrigger value="response">Response</TabsTrigger>
        <TabsTrigger value="headers">Headers</TabsTrigger>
      </TabsList>

      <div class="ml-auto flex shrink-0 items-center gap-2 text-xs">
        <span class="inline-flex items-center rounded-main border border-border bg-muted px-2 py-1 font-mono text-muted-foreground" data-response-status>—</span>
        <span class="inline-flex items-center rounded-main border border-border bg-muted px-2 py-1 font-mono text-muted-foreground" data-response-time>—</span>
      </div>
    </div>

    <TabsContent value="headers" class="mt-4 flex min-h-0 flex-1 flex-col overflow-hidden">
      <div class="min-h-72 flex-1 overflow-hidden rounded-main border border-border bg-background">
        <CodeEditor
          id="response-headers"
          name="response-headers"
          language="plaintext"
          readOnly
          value="Sin respuesta aún."
          data-response-headers
          aria-label="Headers de la respuesta"
        />
      </div>
    </TabsContent>

    <TabsContent value="response" class="mt-4 flex min-h-0 flex-1 flex-col overflow-hidden">
      <div class="mb-3 hidden shrink-0" data-response-url-container>
        <Link href="#" target="_blank" rel="noopener noreferrer" variant="outline" size="sm" icon="ExternalLink" iconPosition="right" data-response-url>
          Abrir enlace de la respuesta
        </Link>
      </div>
      <div class="min-h-72 flex-1 overflow-hidden rounded-main border border-border bg-background">
        <CodeEditor
          id="response-body"
          name="response-body"
          language="plaintext"
          readOnly
          value="Envía una solicitud para ver la respuesta aquí."
          data-response-body
          aria-label="Cuerpo de la respuesta"
        />
      </div>
    </TabsContent>
  </Tabs>
</Card>

<script>
  type ResponsePayload = {
    status: number
    statusText: string
    durationMs: number
    headersText: string
    bodyText: string
    bodyLang: 'json' | 'xml' | 'plaintext'
  }

  function statusClasses(status: number): string {
    if (status >= 200 && status < 300) return 'border-green-200 bg-green-50 text-green-700'
    if (status >= 400) return 'border-red-200 bg-red-50 text-red-700'
    return 'border-amber-200 bg-amber-50 text-amber-700'
  }

  function getResponseUrl(bodyText: string): string | null {
    try {
      const parsed: unknown = JSON.parse(bodyText)
      if (typeof parsed !== 'object' || parsed === null || Array.isArray(parsed)) return null

      const data = (parsed as Record<string, unknown>).data
      if (typeof data !== 'object' || data === null || Array.isArray(data)) return null

      const urlValue = (data as Record<string, unknown>).url
      if (typeof urlValue !== 'string' || !urlValue.trim()) return null

      const url = new URL(urlValue.trim(), window.location.origin)
      return url.protocol === 'http:' || url.protocol === 'https:' ? url.href : null
    } catch {
      return null
    }
  }

  function updateEditor(input: HTMLTextAreaElement | null, value: string, language?: string) {
    if (!input) return

    const editorRoot = input.closest<HTMLElement>('[data-code-editor]')
    if (language && editorRoot) editorRoot.dataset.language = language
    input.value = value
  }

  function renderResponse(root: HTMLElement, payload: ResponsePayload) {
    const statusEl = root.querySelector('[data-response-status]') as HTMLElement
    const timeEl = root.querySelector('[data-response-time]') as HTMLElement
    const headersInput = root.querySelector<HTMLTextAreaElement>('[data-response-headers]')
    const bodyInput = root.querySelector<HTMLTextAreaElement>('[data-response-body]')
    const urlContainer = root.querySelector('[data-response-url-container]') as HTMLElement
    const urlEl = root.querySelector('[data-response-url]') as HTMLAnchorElement

    statusEl.className = `inline-flex items-center rounded-main border px-2 py-1 font-mono text-xs ${statusClasses(payload.status)}`
    statusEl.textContent = `${payload.status} ${payload.statusText}`.trim()
    timeEl.textContent = `${payload.durationMs} ms`

    updateEditor(headersInput, payload.headersText || '(sin headers)', 'plaintext')
    updateEditor(bodyInput, payload.bodyText, payload.bodyLang)

    const responseUrl = getResponseUrl(payload.bodyText)
    urlEl.href = responseUrl || '#'
    urlContainer.classList.toggle('hidden', !responseUrl)
  }

  function setupResponsePanel(root: HTMLElement) {
    if (root.dataset.responsePanelInitialized === 'true') return
    root.dataset.responsePanelInitialized = 'true'

    root.addEventListener('http-client:response', ((event: CustomEvent<ResponsePayload>) => {
      renderResponse(root, event.detail)
    }) as EventListener)
  }

  function initResponsePanels() {
    document.querySelectorAll<HTMLElement>('[data-http-client]').forEach(setupResponsePanel)
  }

  initResponsePanels()
  document.addEventListener('astro:page-load', initResponsePanels)
</script>

<style>
  [data-response-card] > div {
    display: flex;
    min-height: 0;
    flex: 1;
    flex-direction: column;
  }

  [data-response-card] [data-tabs-container] {
    display: flex;
    min-height: 0;
    height: 100%;
    flex: 1;
    flex-direction: column;
  }

  [data-response-card] [data-tabs-content][data-state='active'] {
    display: flex;
    min-height: 0;
    flex: 1;
    flex-direction: column;
  }
</style>
