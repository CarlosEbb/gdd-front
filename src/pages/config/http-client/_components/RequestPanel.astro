---
import Card from '@/components/ui/Card.astro'
import Button from '@/components/ui/Button.astro'
import Icon from '@/components/ui/Icon.astro'
import Tabs from '@/components/tabs/Tabs.astro'
import TabsList from '@/components/tabs/TabsList.astro'
import TabsTrigger from '@/components/tabs/TabsTrigger.astro'
import TabsContent from '@/components/tabs/TabsContent.astro'
import Dropdown from '@/components/ui/Dropdown.astro'
import CodeEditor from '@/components/editor/CodeEditor.astro'

interface Props {
  bearerToken: string
  requestJson: string
  requestXml: string
}

const BODY_FORMAT_OPTIONS = [
  { value: 'json', label: 'JSON' },
  { value: 'xml', label: 'XML' },
] as const

const { bearerToken, requestJson, requestXml } = Astro.props
---

<Card class="flex h-full min-h-112 flex-col overflow-visible!">
  <Tabs defaultValue="body" variant="line" class="flex h-full min-h-0 flex-1 flex-col">
    <div class="flex w-full shrink-0 flex-nowrap items-center justify-between gap-3">
      <TabsList class="w-auto! min-w-0 shrink">
        <TabsTrigger value="headers">Headers</TabsTrigger>
        <TabsTrigger value="body">Body</TabsTrigger>
      </TabsList>

      <div class="ml-auto w-36 shrink-0" data-body-format-select data-body-format="json">
        <Dropdown buttonLabel="JSON" size="sm" shadow="none" position="right" menuClass="min-w-[140px] md:min-w-[160px]" mobileIcon="Braces">
          {
            BODY_FORMAT_OPTIONS.map((option) => (
              <button type="button" data-body-format-option={option.value} class="flex w-full cursor-pointer items-center px-4 py-2 text-left text-sm whitespace-nowrap text-heading hover:bg-muted">
                {option.label}
              </button>
            ))
          }
        </Dropdown>
      </div>
    </div>

    <TabsContent value="headers" class="mt-4 min-h-0 flex-1">
      <div class="space-y-3 rounded-main border border-border bg-muted/40 p-3">
        <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
          <span class="font-mono text-xs text-muted-foreground">Authorization</span>
          <span class="font-mono text-xs break-all text-heading" data-header-authorization>
            Bearer {bearerToken}
          </span>
        </div>
        <div class="flex flex-col gap-1 border-t border-border pt-3 sm:flex-row sm:items-center sm:justify-between">
          <span class="font-mono text-xs text-muted-foreground">Content-Type</span>
          <span class="font-mono text-xs text-heading" data-header-content-type>application/json</span>
        </div>
      </div>
    </TabsContent>

    <TabsContent value="body" class="mt-4 flex min-h-0 flex-1 flex-col overflow-hidden">
      <div class="flex min-h-0 flex-1 flex-col gap-3">
        <div data-body-panel="json" class="flex min-h-72 flex-1 flex-col">
          <div class="flex min-h-0 flex-1 flex-col overflow-hidden rounded-main border border-border bg-background">
            <div class="flex shrink-0 items-center justify-between border-b border-border bg-secondary px-4 py-2">
              <div class="flex items-center gap-2">
                <Icon name="Terminal" stroke-width={1.5} class="size-4 text-muted-foreground" />
                <span class="font-mono text-xs text-muted-foreground">body.json</span>
              </div>
            </div>
            <div class="min-h-0 flex-1">
              <label for="body-json" class="sr-only">JSON</label>
              <CodeEditor id="body-json" name="body-json" language="json" value={requestJson} data-body-json aria-label="JSON" />
            </div>
          </div>
        </div>

        <div data-body-panel="xml" class="hidden min-h-72 flex-1 flex-col">
          <div class="flex min-h-0 flex-1 flex-col overflow-hidden rounded-main border border-border bg-background">
            <div class="flex shrink-0 items-center justify-between border-b border-border bg-secondary px-4 py-2">
              <div class="flex items-center gap-2">
                <Icon name="Terminal" stroke-width={1.5} class="size-4 text-muted-foreground" />
                <span class="font-mono text-xs text-muted-foreground">body.xml</span>
              </div>
            </div>
            <div class="min-h-0 flex-1">
              <label for="body-xml" class="sr-only">XML</label>
              <CodeEditor id="body-xml" name="body-xml" language="xml" value={requestXml} data-body-xml aria-label="XML" />
            </div>
          </div>
        </div>

        <div class="shrink-0 pt-1 lg:hidden">
          <Button type="button" size="lg" icon="Send" loadingText="Enviando..." data-send-btn data-send-mode="advanced" class="h-10 w-full"> Enviar </Button>
        </div>
      </div>
    </TabsContent>
  </Tabs>
</Card>

<script>
  import { parseXmlBody, serializeXmlBody, type BodyData } from '@/scripts/xml-body'

  type BodyFormat = 'json' | 'xml'

  const BODY_FORMAT_LABELS: Record<BodyFormat, string> = {
    json: 'JSON',
    xml: 'XML',
  }

  function getBodyFormatContainer(root: HTMLElement): HTMLElement | null {
    return root.querySelector('[data-body-format-select]') as HTMLElement | null
  }

  function getActiveBodyFormat(root: HTMLElement): BodyFormat {
    const format = getBodyFormatContainer(root)?.dataset.bodyFormat
    return format === 'xml' ? 'xml' : 'json'
  }

  function getContentType(format: BodyFormat): string {
    return format === 'xml' ? 'application/xml' : 'application/json'
  }

  function updateContentTypeHeader(root: HTMLElement) {
    const contentTypeEl = root.querySelector('[data-header-content-type]') as HTMLElement | null
    if (!contentTypeEl) return
    contentTypeEl.textContent = getContentType(getActiveBodyFormat(root))
  }

  function closeBodyFormatDropdown(container: HTMLElement) {
    const dropdown = container.querySelector('[data-dropdown-container]')
    dropdown?.classList.remove('is-open')
    dropdown?.querySelector('[data-dropdown-menu]')?.classList.remove('is-open')
  }

  function parseJsonData(raw: string): BodyData | null {
    try {
      const data: unknown = JSON.parse(raw)
      return data !== null && typeof data === 'object' && !Array.isArray(data) ? (data as BodyData) : null
    } catch {
      return null
    }
  }

  function getBodyData(root: HTMLElement, format: BodyFormat): BodyData | null {
    const selector = format === 'json' ? '[data-body-json]' : '[data-body-xml]'
    const raw = root.querySelector<HTMLTextAreaElement>(selector)?.value || ''
    return format === 'json' ? parseJsonData(raw) : parseXmlBody(raw)
  }

  function setBodyFormat(root: HTMLElement, format: BodyFormat) {
    const currentFormat = getActiveBodyFormat(root)
    const data = currentFormat === format ? null : getBodyData(root, currentFormat)

    const container = getBodyFormatContainer(root)
    if (container) {
      container.dataset.bodyFormat = format
      const label = container.querySelector('[data-dropdown-toggle] .truncate')
      if (label) label.textContent = BODY_FORMAT_LABELS[format]
    }

    root.querySelectorAll('[data-body-panel]').forEach((panel) => {
      const element = panel as HTMLElement
      const isActive = element.dataset.bodyPanel === format
      element.classList.toggle('hidden', !isActive)
      element.classList.toggle('flex', isActive)
    })

    if (data) {
      const selector = format === 'json' ? '[data-body-json]' : '[data-body-xml]'
      const textarea = root.querySelector<HTMLTextAreaElement>(selector)
      if (textarea) textarea.value = format === 'json' ? JSON.stringify(data, null, 2) : serializeXmlBody(data)
    }

    updateContentTypeHeader(root)
  }

  function setupRequestPanel(root: HTMLElement) {
    if (root.dataset.requestPanelInitialized === 'true') return
    root.dataset.requestPanelInitialized = 'true'

    root.addEventListener('click', (event) => {
      const target = event.target
      if (!(target instanceof Element)) return

      const formatOption = target.closest('[data-body-format-option]') as HTMLElement | null
      if (!formatOption) return

      const format = formatOption.dataset.bodyFormatOption
      if (format === 'json' || format === 'xml') {
        setBodyFormat(root, format)
        const container = getBodyFormatContainer(root)
        if (container) closeBodyFormatDropdown(container)
      }
    })

    setBodyFormat(root, 'json')
  }

  function initRequestPanels() {
    document.querySelectorAll<HTMLElement>('[data-http-client]').forEach(setupRequestPanel)
  }

  initRequestPanels()
  document.addEventListener('astro:page-load', initRequestPanels)
</script>
