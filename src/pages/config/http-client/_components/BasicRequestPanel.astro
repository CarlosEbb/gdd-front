---
import Card from '@/components/ui/Card.astro'
import Button from '@/components/ui/Button.astro'
import Input from '@/components/form/Input.astro'
import Checkbox from '@/components/form/Checkbox.astro'
import TagInput from '@/components/form/TagInput.astro'
import ObjectListField from './ObjectListField.astro'
import Select from '@/components/form/Select.astro'

interface VariableEntry {
  key: string
  isArray: boolean
  isObjectArray: boolean
  displayValue: string
  arrayValues: string[]
  objectFields: string[]
  objectItems: Record<string, string>[]
  originalType: string
  isEmailList: boolean
}

interface Props {
  variableEntries: VariableEntry[]
  urlVersioned: string
  urlLatest: string
  buildNumberLastVersion: string
}

const DATE_FIELD_KEY = 'fecha_vencimiento'
const CHECKBOX_FIELD_KEY = 'mostrar_una_sola_vez'

const { variableEntries, urlVersioned, urlLatest, buildNumberLastVersion } = Astro.props

function isCheckedValue(value: string): boolean {
  return ['true', '1', 'on', 'yes'].includes(value.trim().toLowerCase())
}
---

<Card class="sticky top-20 z-10 flex h-[calc(100dvh-23rem)] shrink-0 flex-col self-start" data-basic-request-card>
  <div class="flex h-full min-h-0 flex-1 flex-col gap-4 overflow-y-auto">
    <div>
      <h3 class="text-sm font-semibold text-heading">Datos del documento</h3>
      <p class="mt-1 text-xs text-subheading">Completa los campos y envía la solicitud. Se enviará como JSON.</p>
    </div>

    <Select
      id="basic-request-url"
      name="basic-request-url"
      label="Ruta"
      options={[
        {
          value: urlVersioned,
          label: `${urlVersioned} (build ${buildNumberLastVersion || 'N/A'})`,
          selected: true,
        },
        {
          value: urlLatest,
          label: `${urlLatest} (última versión)`,
        },
      ]}
      data-basic-url-select
    />

    {
      variableEntries.length > 0 ? (
        <form data-basic-body-form>
          <div class="space-y-3 p-0.5">
            {variableEntries.map((field) => {
              if (field.isObjectArray) {
                return <ObjectListField name={field.key} label={field.key.replaceAll('_', ' ')} fields={field.objectFields} items={field.objectItems} />
              }

              if (field.isArray) {
                return (
                  <TagInput
                    name={field.key}
                    idPrefix="basic-"
                    label={field.key.replaceAll('_', ' ')}
                    values={field.arrayValues}
                    validateEmail={field.isEmailList}
                    placeholder={field.isEmailList ? 'Escribe un correo y separa con coma' : 'Escribe y separa con coma'}
                  />
                )
              }

              if (field.key === DATE_FIELD_KEY) {
                return (
                  <Input
                    id={`basic-${field.key}`}
                    name={field.key}
                    label={field.key.replaceAll('_', ' ')}
                    type="datetime-local"
                    step="1"
                    value={field.displayValue}
                    placeholder=""
                    data-form-field={field.key}
                    data-original-type="datetime"
                  />
                )
              }

              if (field.key === CHECKBOX_FIELD_KEY) {
                return (
                  <Checkbox
                    id={`basic-${field.key}`}
                    name={field.key}
                    label={field.key.replaceAll('_', ' ')}
                    checked={isCheckedValue(field.displayValue)}
                    data-form-field={field.key}
                    data-original-type="boolean"
                  />
                )
              }

              return (
                <Input
                  id={`basic-${field.key}`}
                  name={field.key}
                  label={field.key.replaceAll('_', ' ')}
                  value={field.displayValue}
                  data-form-field={field.key}
                  data-original-type={field.originalType}
                />
              )
            })}
          </div>
        </form>
      ) : (
        <p class="text-sm text-subheading">No hay variables disponibles para este documento.</p>
      )
    }
  </div>

  <Button slot="footer" type="button" size="lg" icon="Send" loadingText="Enviando..." data-send-btn data-send-mode="basic" class="h-10 w-full"> Enviar </Button>
</Card>

<script>
  function setupBasicRequestPanel(root: HTMLElement) {
    if (root.dataset.basicRequestInitialized === 'true') return
    root.dataset.basicRequestInitialized = 'true'

    const form = root.querySelector('[data-basic-body-form]') as HTMLFormElement | null
    form?.addEventListener('submit', (event) => {
      event.preventDefault()
    })
  }

  function initBasicRequestPanels() {
    document.querySelectorAll<HTMLElement>('[data-http-client]').forEach(setupBasicRequestPanel)
  }

  initBasicRequestPanels()
  document.addEventListener('astro:page-load', initBasicRequestPanels)
</script>
