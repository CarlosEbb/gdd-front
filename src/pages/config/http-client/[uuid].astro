---
import Layout from '../_components/Layout.astro'
import { actions } from 'astro:actions'
import StateSwitch from '@/components/ui/StateSwitch.astro'
import EmptyState from '@/components/ui/EmptyState.astro'
import Tabs from '@/components/tabs/Tabs.astro'
import TabsList from '@/components/tabs/TabsList.astro'
import TabsTrigger from '@/components/tabs/TabsTrigger.astro'
import TabsContent from '@/components/tabs/TabsContent.astro'
import UrlSelector from './_components/UrlSelector.astro'
import RequestPanel from './_components/RequestPanel.astro'
import ResponsePanel from './_components/ResponsePanel.astro'
import BasicRequestPanel from './_components/BasicRequestPanel.astro'
import BasicResponsePanel from './_components/BasicResponsePanel.astro'
import { serializeXmlBody } from '@/scripts/xml-body'

const { uuid } = Astro.params

if (!uuid) return Astro.redirect('/home')

const build_number = Astro.url.searchParams.get('build_number') as string
const uuidWorkspace = Astro.url.searchParams.get('id_workspace') as string
const nameWorkspace = Astro.url.searchParams.get('name_workspace') as string

const versionParams = new URLSearchParams()
if (build_number) versionParams.set('build_number', build_number)
if (uuidWorkspace) versionParams.set('id_workspace', uuidWorkspace)
if (nameWorkspace) versionParams.set('name_workspace', nameWorkspace)
const versionHref = `/config/version/${uuid}?${versionParams.toString()}`
const base_url = import.meta.env.PUBLIC_CARGA_URL

const { data, error } = await Astro.callAction(actions.documents.getRequestForDocument, {
  uuid_template: uuid,
  build_number: build_number,
})

const request = data?.data?.variables
const buildNumberLastVersion = data?.data?.build_number || ''
const urlVersioned = `${base_url}/documents/${uuid}/${buildNumberLastVersion}`
const urlLatest = `${base_url}/documents/${uuid}`

const token = data?.data?.jwtToken
const bearerToken = token ?? 'tu_token'

function isPlainObject(value: unknown): value is Record<string, unknown> {
  return typeof value === 'object' && value !== null && !Array.isArray(value)
}

function toTextValue(value: unknown): string {
  if (value == null) return ''
  if (typeof value === 'string') return value
  if (typeof value === 'number' || typeof value === 'boolean') return String(value)
  return JSON.stringify(value)
}

function collectObjectFields(items: Record<string, unknown>[]): string[] {
  const fields: string[] = []

  items.forEach((item) => {
    Object.keys(item).forEach((key) => {
      if (!fields.includes(key)) fields.push(key)
    })
  })

  return fields
}

const requestJson = JSON.stringify(request ?? {}, null, 2)
const requestXml = serializeXmlBody(request ?? {})
const variableEntries = Object.entries(request ?? {}).map(([key, value]) => {
  const isArray = Array.isArray(value)
  const objectItemsSource = isArray && value.length > 0 && value.every(isPlainObject) ? value : null
  const objectFields = objectItemsSource ? collectObjectFields(objectItemsSource) : []
  const isObjectArray = objectFields.length > 0

  return {
    key,
    isArray: isArray && !isObjectArray,
    isObjectArray,
    displayValue: value == null ? '' : typeof value === 'object' ? JSON.stringify(value) : String(value),
    arrayValues: isArray && !isObjectArray ? value.map((item) => String(item ?? '')) : [],
    objectFields,
    objectItems: objectItemsSource
      ? objectItemsSource.map((item) => Object.fromEntries(objectFields.map((field) => [field, toTextValue(item[field])])))
      : [],
    originalType: isObjectArray ? 'object-array' : isArray ? 'array' : typeof value,
    isEmailList: isArray && !isObjectArray && /correo|email|mail/i.test(key),
  }
})
---

<Layout title="Cliente HTTP">
  <StateSwitch hasError={!!error} isEmpty={!request}>
    <div data-http-client data-token={bearerToken}>
      <Tabs defaultValue="basic" variant="default">
        <TabsList>
          <TabsTrigger value="basic">Básica</TabsTrigger>
          <TabsTrigger value="advanced">Avanzada</TabsTrigger>
        </TabsList>

        <TabsContent value="basic" class="mt-4">
          <div class="grid grid-cols-1 items-stretch gap-4 lg:grid-cols-2">
            <BasicRequestPanel
              variableEntries={variableEntries}
              urlVersioned={urlVersioned}
              urlLatest={urlLatest}
              buildNumberLastVersion={buildNumberLastVersion}
            />
            <BasicResponsePanel />
          </div>
        </TabsContent>

        <TabsContent value="advanced" class="mt-4 space-y-4">
          <UrlSelector urlVersioned={urlVersioned} urlLatest={urlLatest} buildNumberLastVersion={buildNumberLastVersion} />

          <div class="grid grid-cols-1 items-stretch gap-4 lg:grid-cols-2">
            <RequestPanel bearerToken={bearerToken} requestJson={requestJson} requestXml={requestXml} />
            <ResponsePanel />
          </div>
        </TabsContent>
      </Tabs>
    </div>

    <EmptyState slot="error" title="Error al cargar el cliente HTTP" description="No se pudo cargar la información del documento." />

    <EmptyState
      slot="empty"
      title="Cliente HTTP no disponible"
      state="info"
      action="create"
      hrefText="Crear versión"
      href={versionHref}
      description={data?.message || 'No se encontró información para este documento.'}
    />
  </StateSwitch>
</Layout>

<script>
  import { toast } from '@/scripts/toast'

  type BodyFormat = 'json' | 'xml'
  type SendMode = 'basic' | 'advanced'

  type ResponsePayload = {
    status: number
    statusText: string
    durationMs: number
    headersText: string
    bodyText: string
    bodyLang: 'json' | 'xml' | 'plaintext'
  }

  type BasicResponsePayload = {
    status: number
    statusText: string
    durationMs: number
    bodyText: string
  }

  function parseTypedValue(raw: string, originalType: string): unknown {
    if (originalType === 'array') {
      try {
        const parsed = JSON.parse(raw)
        return Array.isArray(parsed) ? parsed : []
      } catch {
        return []
      }
    }

    if (originalType === 'number') {
      const parsed = Number(raw)
      return Number.isNaN(parsed) ? raw : parsed
    }

    if (originalType === 'boolean') {
      if (raw === 'true') return true
      if (raw === 'false') return false
      return raw
    }

    if (originalType === 'object') {
      try {
        return JSON.parse(raw)
      } catch {
        return raw
      }
    }

    return raw
  }

  function getBodyFormatContainer(root: HTMLElement): HTMLElement | null {
    return root.querySelector('[data-body-format-select]') as HTMLElement | null
  }

  function getActiveBodyFormat(root: HTMLElement): BodyFormat {
    const format = getBodyFormatContainer(root)?.dataset.bodyFormat
    return format === 'xml' ? 'xml' : 'json'
  }

  function getContentType(format: BodyFormat): string {
    return format === 'xml' ? 'application/xml' : 'application/json'
  }

  function toUtcIsoString(datetimeLocal: string): string {
    if (!datetimeLocal) return ''

    const [date, time = '00:00:00'] = datetimeLocal.split('T')
    const [hours = '00', minutes = '00', seconds = '00'] = time.split(':')
    const normalizedSeconds = seconds.padStart(2, '0').slice(0, 2)

    return `${date}T${hours.padStart(2, '0')}:${minutes.padStart(2, '0')}:${normalizedSeconds}Z`
  }

  function readObjectList(list: HTMLElement): Record<string, string>[] {
    let fieldKeys: string[] = []

    try {
      const parsed = JSON.parse(list.dataset.objectFields || '[]')
      fieldKeys = Array.isArray(parsed) ? parsed.filter((key): key is string => typeof key === 'string') : []
    } catch {
      fieldKeys = []
    }

    const items = list.querySelectorAll<HTMLElement>('[data-object-list-items] > [data-object-list-item]')

    return Array.from(items).map((item) => {
      const entry: Record<string, string> = {}

      fieldKeys.forEach((fieldKey) => {
        const control = item.querySelector<HTMLTextAreaElement>(`[data-object-field="${CSS.escape(fieldKey)}"]`)
        entry[fieldKey] = control?.value ?? ''
      })

      return entry
    })
  }

  function collectFormPayload(scope: ParentNode): Record<string, unknown> {
    const payload: Record<string, unknown> = {}

    scope.querySelectorAll<HTMLElement>('[data-object-list]').forEach((list) => {
      const key = list.dataset.formField
      if (!key) return
      payload[key] = readObjectList(list)
    })

    const fields = scope.querySelectorAll<HTMLElement>('[data-form-field]')

    fields.forEach((field) => {
      if (field.closest('[data-object-list]')) return
      if (!(field instanceof HTMLInputElement) && !(field instanceof HTMLTextAreaElement)) return

      const key = field.dataset.formField || field.name
      const originalType = field.dataset.originalType || 'string'

      if (field instanceof HTMLInputElement && field.type === 'checkbox') {
        payload[key] = field.checked
        return
      }

      if (field instanceof HTMLInputElement && field.type === 'datetime-local') {
        payload[key] = toUtcIsoString(field.value)
        return
      }

      payload[key] = parseTypedValue(field.value, originalType)
    })

    return payload
  }

  function buildBasicRequestBody(root: HTMLElement): { contentType: string; body: string } {
    const form = root.querySelector('[data-basic-body-form]') as HTMLFormElement | null
    const payload = collectFormPayload(form ?? root)
    return {
      contentType: 'application/json',
      body: JSON.stringify(payload),
    }
  }

  function buildAdvancedRequestBody(root: HTMLElement): { contentType: string; body: string } {
    const format = getActiveBodyFormat(root)
    const contentType = getContentType(format)

    if (format === 'json') {
      const textarea = root.querySelector('[data-body-json]') as HTMLTextAreaElement
      const raw = textarea?.value?.trim() || '{}'
      try {
        JSON.parse(raw)
      } catch {
        throw new Error('El JSON del body no es válido.')
      }
      return { contentType, body: raw }
    }

    const textarea = root.querySelector('[data-body-xml]') as HTMLTextAreaElement
    const raw = textarea?.value?.trim() || ''
    if (!raw) {
      throw new Error('El body XML no puede estar vacío.')
    }
    return { contentType, body: raw }
  }

  function detectBodyLang(raw: string, contentType: string | null): 'json' | 'xml' | 'plaintext' {
    if (contentType?.includes('application/json') || raw.trim().startsWith('{') || raw.trim().startsWith('[')) {
      return 'json'
    }
    if (contentType?.includes('xml') || raw.trim().startsWith('<?xml') || raw.trim().startsWith('<')) {
      return 'xml'
    }
    return 'plaintext'
  }

  function formatResponseBody(raw: string, contentType: string | null): { code: string; lang: 'json' | 'xml' | 'plaintext' } {
    if (!raw) return { code: '(respuesta vacía)', lang: 'plaintext' }

    const lang = detectBodyLang(raw, contentType)
    if (lang === 'json') {
      try {
        return { code: JSON.stringify(JSON.parse(raw), null, 2), lang }
      } catch {
        return { code: raw, lang: 'plaintext' }
      }
    }

    return { code: raw, lang }
  }

  function setSendButtonsLoading(buttons: HTMLButtonElement[], loading: boolean) {
    buttons.forEach((button) => {
      button.dispatchEvent(new Event(loading ? 'button:start-loading' : 'button:stop-loading'))
    })
  }

  function scrollToResponseCard(root: HTMLElement, mode: SendMode) {
    const selector = mode === 'basic' ? '[data-basic-response-card]' : '[data-response-card]'
    const responseCard = root.querySelector(selector) as HTMLElement | null
    if (!responseCard) return

    responseCard.scrollIntoView({ behavior: 'smooth', block: 'start' })
  }

  function dispatchAdvancedResponse(root: HTMLElement, payload: ResponsePayload) {
    root.dispatchEvent(new CustomEvent<ResponsePayload>('http-client:response', { detail: payload }))
  }

  function dispatchBasicResponse(root: HTMLElement, payload: BasicResponsePayload) {
    root.dispatchEvent(new CustomEvent<BasicResponsePayload>('http-client:basic-response', { detail: payload }))
  }

  function getRequestUrl(root: HTMLElement, mode: SendMode): string | null {
    const selector = mode === 'basic' ? '[data-basic-url-select]' : '[data-url-select]'
    const urlSelect = root.querySelector(selector) as HTMLSelectElement | null
    return urlSelect?.value || null
  }

  function setupHttpClient(root: HTMLElement) {
    if (root.dataset.initialized === 'true') return
    root.dataset.initialized = 'true'

    const sendButtons = Array.from(root.querySelectorAll('[data-send-btn]')) as HTMLButtonElement[]
    const token = root.dataset.token || 'tu_token'

    async function sendRequest(mode: SendMode) {
      const requestUrl = getRequestUrl(root, mode)
      if (!requestUrl) {
        toast.error('Selecciona una URL válida')
        return
      }

      let requestBody: { contentType: string; body: string }

      try {
        requestBody = mode === 'basic' ? buildBasicRequestBody(root) : buildAdvancedRequestBody(root)
      } catch (error) {
        toast.error(error instanceof Error ? error.message : 'Body inválido')
        return
      }

      const modeButtons = sendButtons.filter((button) => (button.dataset.sendMode || 'advanced') === mode)
      setSendButtonsLoading(modeButtons, true)
      const startedAt = performance.now()

      try {
        const response = await fetch(requestUrl, {
          method: 'POST',
          headers: {
            Authorization: `Bearer ${token}`,
            'Content-Type': requestBody.contentType,
          },
          body: requestBody.body,
        })

        const durationMs = Math.round(performance.now() - startedAt)
        const rawBody = await response.text()

        if (mode === 'basic') {
          dispatchBasicResponse(root, {
            status: response.status,
            statusText: response.statusText,
            durationMs,
            bodyText: rawBody,
          })
        } else {
          const headersText = Array.from(response.headers.entries())
            .map(([key, value]) => `${key}: ${value}`)
            .join('\n')
          const formattedBody = formatResponseBody(rawBody, response.headers.get('content-type'))

          dispatchAdvancedResponse(root, {
            status: response.status,
            statusText: response.statusText,
            durationMs,
            headersText,
            bodyText: formattedBody.code,
            bodyLang: formattedBody.lang,
          })
        }

        if (response.ok) {
          toast.success('Solicitud enviada correctamente')
        } else {
          toast.warn(`Respuesta ${response.status}`)
        }
      } catch (error) {
        const durationMs = Math.round(performance.now() - startedAt)
        const message = error instanceof Error ? error.message : 'Error de conexión'

        if (mode === 'basic') {
          dispatchBasicResponse(root, {
            status: 0,
            statusText: 'Network Error',
            durationMs,
            bodyText: message,
          })
        } else {
          dispatchAdvancedResponse(root, {
            status: 0,
            statusText: 'Network Error',
            durationMs,
            headersText: '',
            bodyText: message,
            bodyLang: 'plaintext',
          })
        }

        toast.error('Error al enviar la solicitud')
      } finally {
        setSendButtonsLoading(modeButtons, false)
        scrollToResponseCard(root, mode)
      }
    }

    sendButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const mode = (button.dataset.sendMode as SendMode) || 'advanced'
        void sendRequest(mode)
      })
    })
  }

  function initAllHttpClients() {
    document.querySelectorAll<HTMLElement>('[data-http-client]').forEach(setupHttpClient)
  }

  initAllHttpClients()
  document.addEventListener('astro:page-load', initAllHttpClients)
</script>
