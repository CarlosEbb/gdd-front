---
import AccordionStep from '@/components/ui/AccordionStep.astro'
import Button from '@/components/ui/Button.astro'
import Icon from '@/components/ui/Icon.astro'
import CardList from '@/components/ui/CardList.astro'
import Link from '@/components/ui/Link.astro'

interface Props {
  stats: {
    id: string
    label: string
    color: string
  }[]
}

const { stats } = Astro.props
---

<AccordionStep step={3} title="Progreso y Resultados" description="Monitorea el progreso del procesamiento y revisa los resultados.">
  <p id="progress-idle" class="text-sm text-subheading">El procesamiento comenzará cuando subas un archivo en el paso 2.</p>

  <div id="progress-container" class="hidden">
    <!-- Indicador de Procesamiento Activo -->
    <div id="processing-banner" class="mb-4 flex items-center gap-2.5 rounded-main border border-border bg-muted/30 p-2.5">
      <Icon name="Loader" class="h-3.5 w-3.5 shrink-0 animate-spin text-primary" />
      <div class="flex min-w-0 flex-1 flex-col sm:flex-row sm:items-center sm:gap-2">
        <p class="text-xs font-semibold text-heading">Procesando registros</p>
        <span class="hidden text-border sm:inline">|</span>
        <p class="text-[11px] text-subheading">Por favor, mantén esta ventana abierta mientras se generan los documentos.</p>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-3 sm:grid-cols-4">
      <div class="flex items-center justify-between gap-4 rounded-main border border-border bg-foreground p-3 sm:col-span-1">
        <div class="min-w-0 flex-1">
          <span class="mb-1 block text-xs text-subheading">Estado</span>
          <p id="progress-text" class="truncate text-sm font-semibold text-heading">En cola...</p>
        </div>
        <div class="relative h-14 w-14 shrink-0">
          <svg viewBox="0 0 64 64" class="h-full w-full -rotate-90">
            <circle cx="32" cy="32" r="28" fill="none" stroke-width="6" class="stroke-muted"></circle>
            <circle id="progress-circle" cx="32" cy="32" r="28" fill="none" stroke-width="6" stroke-linecap="round" class="stroke-primary transition-all duration-500"></circle>
          </svg>
          <span id="progress-percentage" class="absolute inset-0 flex items-center justify-center text-xs font-semibold text-heading">0%</span>
        </div>
      </div>

      <div class="grid grid-cols-3 gap-3 sm:col-span-3 sm:grid-cols-3">
        {
          stats.map((stat) => (
            <div class="flex flex-col justify-center rounded-main border border-border bg-foreground p-3 text-center">
              <span id={stat.id} class={`block text-xl font-semibold ${stat.color}`}>
                0
              </span>
              <span class="text-xs text-subheading">{stat.label}</span>
            </div>
          ))
        }
      </div>
    </div>

    <div id="results-container" class="mt-6 hidden">
      <div class="mb-3 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <h3 class="text-sm font-semibold text-heading">Detalle de Resultados</h3>
        <Button id="btn-download-report" size="sm" icon="Download" class="hidden" loadingText="Descargando..."> Descargar Reporte Excel </Button>
      </div>
      <div id="bulk-results-list" class="max-h-96 overflow-y-auto rounded-main border border-border bg-background"></div>
    </div>
  </div>

  <template id="result-item-template">
    <CardList title="Fila #" description="Detalle">
      <div slot="avatar" class="flex size-10 shrink-0 items-center justify-center rounded-main">
        <div class="avatar-success hidden h-10 w-10 items-center justify-center rounded-full bg-green-100 text-green-600">
          <Icon name="Check" class="h-5 w-5" />
        </div>
        <div class="avatar-error hidden h-10 w-10 items-center justify-center rounded-full bg-red-100 text-red-600">
          <Icon name="X" class="h-5 w-5" />
        </div>
      </div>
      <div slot="actions" class="flex items-center gap-2">
        <Link href="#" iconPosition="right" size="sm" target="_blank" icon="ArrowUpRight" variant="secondary" class="result-link hidden"> Ver PDF </Link>
      </div>
    </CardList>
  </template>
</AccordionStep>
