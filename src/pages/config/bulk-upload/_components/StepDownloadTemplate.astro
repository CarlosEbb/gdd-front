---
import AccordionStep from '@/components/ui/AccordionStep.astro'
import Button from '@/components/ui/Button.astro'
import Icon from '@/components/ui/Icon.astro'

interface Props {
  uuid: string
}

const { uuid } = Astro.props
---

<AccordionStep
  step={1}
  title="Descargar Plantilla Modelo"
  description="Descarga el archivo Excel con las variables configuradas de este documento. Incluye las validaciones que hayas establecido."
  defaultOpen
>
  <form id="download-template-form">
    <input type="hidden" id="current-template-uuid" value={uuid} />

    <div class="grid grid-cols-1 items-stretch gap-6 md:grid-cols-12">
      <div
        class="group relative flex min-h-[180px] items-center justify-center overflow-hidden rounded-main border border-emerald-500/20 bg-linear-to-br from-green-500/5 via-emerald-500/5 to-teal-500/5 p-6 md:col-span-4 dark:border-emerald-500/10 dark:from-green-950/10 dark:via-emerald-950/15 dark:to-teal-950/10"
      >
        <div class="animate-glow-shift pointer-events-none absolute -right-12 -bottom-12 h-32 w-32 rounded-full bg-emerald-500/20 blur-3xl"></div>
        <div class="animate-glow-shift pointer-events-none absolute -top-12 -left-12 h-32 w-32 rounded-full bg-green-500/10 blur-3xl [animation-delay:2s]"></div>

        <div class="excel-grid-pattern pointer-events-none absolute inset-0 opacity-75">
          <div class="absolute top-0 right-0 left-0 flex h-5 border-b border-emerald-500/10 bg-emerald-500/5 font-mono text-[9px] text-emerald-600/40 select-none">
            <div class="w-6 border-r border-emerald-500/10"></div>
            <div class="w-12 border-r border-emerald-500/10 text-center">A</div>
            <div class="w-12 border-r border-emerald-500/10 text-center">B</div>
            <div class="w-12 border-r border-emerald-500/10 text-center">C</div>
            <div class="w-12 border-r border-emerald-500/10 text-center">D</div>
          </div>

          <div
            class="absolute top-5 bottom-0 left-0 flex w-6 flex-col gap-[15px] border-r border-emerald-500/10 bg-emerald-500/5 pt-1 text-center font-mono text-[9px] text-emerald-600/40 select-none"
          >
            <div>1</div>
            <div>2</div>
            <div>3</div>
            <div>4</div>
            <div>5</div>
          </div>
        </div>

        <div class="pointer-events-none absolute top-[40px] left-[54px] h-[24px] w-[48px] animate-pulse rounded-[2px] border border-emerald-500/30 bg-emerald-500/10"></div>
        <div
          class="pointer-events-none absolute top-[64px] left-[102px] h-[24px] w-[72px] animate-pulse rounded-[2px] border border-dashed border-emerald-500/20 bg-emerald-500/5 [animation-delay:1s]"
        >
        </div>

        <div class="relative z-10 flex h-24 w-24 items-center justify-center drop-shadow-lg transition-transform duration-500 group-hover:scale-110 group-hover:rotate-3">
          <svg viewBox="0 0 486 500" class="h-full w-full"
            ><defs
              ><radialGradient
                id="microsoft_excel__a"
                cx="-746.66"
                cy="781.44"
                r="13.89"
                fx="-746.66"
                fy="781.44"
                gradientTransform="matrix(-28.32596 -29.80763 -23.11916 21.97986 -2596.39 -38900.31)"
                gradientUnits="userSpaceOnUse"
                ><stop offset=".06" stop-color="#379539"></stop><stop offset=".42" stop-color="#297c2d"></stop><stop offset=".7" stop-color="#15561c"></stop></radialGradient
              ><radialGradient
                id="microsoft_excel__b"
                cx="-773.19"
                cy="771.25"
                r="13.89"
                fx="-773.19"
                fy="771.25"
                gradientTransform="matrix(-11.97612 -11.58137 -8.95853 9.26806 -2155.12 -15858.88)"
                gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#073b10"></stop><stop offset=".99" stop-color="#084a13" stop-opacity="0"></stop></radialGradient
              ><radialGradient
                id="microsoft_excel__f"
                cx="-824.11"
                cy="810.99"
                r="13.89"
                fx="-824.11"
                fy="810.99"
                gradientTransform="matrix(-9.02 0 0 19.09 -7120.4 -15378.69)"
                gradientUnits="userSpaceOnUse"><stop offset=".29" stop-color="#4eb43b"></stop><stop offset="1" stop-color="#72cc61" stop-opacity="0"></stop></radialGradient
              ><radialGradient
                id="microsoft_excel__h"
                cx="-769.14"
                cy="808.9"
                r="13.89"
                fx="-769.14"
                fy="808.9"
                gradientTransform="matrix(-16.9077 -13.68182 13.64112 -16.86345 -23523.37 3309.71)"
                gradientUnits="userSpaceOnUse"><stop offset=".44" stop-color="#79e96d"></stop><stop offset="1" stop-color="#d0eb76"></stop></radialGradient
              ><radialGradient
                id="microsoft_excel__i"
                cx="-675.64"
                cy="793.28"
                r="13.89"
                fx="-675.64"
                fy="793.28"
                gradientTransform="matrix(15.99196 15.99755 45.54153 -45.54797 -25315.85 47178.18)"
                gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#20a85e"></stop><stop offset=".94" stop-color="#09442a"></stop></radialGradient
              ><radialGradient
                id="microsoft_excel__j"
                cx="-657.62"
                cy="853.99"
                r="13.89"
                fx="-657.62"
                fy="853.99"
                gradientTransform="matrix(0 11.2 12.9 0 -10902.85 7734.8)"
                gradientUnits="userSpaceOnUse"><stop offset=".58" stop-color="#33a662" stop-opacity="0"></stop><stop offset=".97" stop-color="#98f0b0"></stop></radialGradient
              ><linearGradient id="microsoft_excel__c" x1="69.43" x2="260.84" y1="210.33" y2="210.33" gradientTransform="matrix(1 0 0 -1 0 502)" gradientUnits="userSpaceOnUse"
                ><stop offset="0" stop-color="#52d17c"></stop><stop offset=".33" stop-color="#4aa647"></stop></linearGradient
              ><linearGradient id="microsoft_excel__d" x1="194.4" x2="194.4" y1="335.33" y2="161.68" gradientTransform="matrix(1 0 0 -1 0 502)" gradientUnits="userSpaceOnUse"
                ><stop offset="0" stop-color="#29852f"></stop><stop offset=".5" stop-color="#4aa647" stop-opacity="0"></stop></linearGradient
              ><linearGradient id="microsoft_excel__e" x1="80.49" x2="311.45" y1="297.22" y2="497.54" gradientTransform="matrix(1 0 0 -1 0 502)" gradientUnits="userSpaceOnUse"
                ><stop offset="0" stop-color="#66d052"></stop><stop offset="1" stop-color="#85e972"></stop></linearGradient
              ><linearGradient id="microsoft_excel__g" x1="182.11" x2="69.43" y1="377" y2="377" gradientTransform="matrix(1 0 0 -1 0 502)" gradientUnits="userSpaceOnUse"
                ><stop offset=".18" stop-color="#c0e075" stop-opacity="0"></stop><stop offset="1" stop-color="#d1eb95"></stop></linearGradient
              ></defs
            ><path
              d="M69.43 159.72c0-34.52 27.98-62.5 62.49-62.5h354.09v361.11c0 23.01-18.65 41.67-41.66 41.67H152.74c-46.01 0-83.31-37.31-83.31-83.33V159.72Z"
              style="fill:url(#microsoft_excel__a)"></path><path
              d="M69.43 159.72c0-34.52 27.98-62.5 62.49-62.5h354.09v361.11c0 23.01-18.65 41.67-41.66 41.67H152.74c-46.01 0-83.31-37.31-83.31-83.33V159.72Z"
              style="fill:url(#microsoft_excel__b);fill-opacity:.7"></path><path
              d="M69.43 229.17c0-34.52 27.98-62.5 62.49-62.5h187.46c-23.01 0-41.66 18.66-41.66 41.67v83.33c0 23.01-18.65 41.67-41.66 41.67h-83.31c-46.01 0-83.31 37.31-83.31 83.33v-187.5Z"
              style="fill:url(#microsoft_excel__c)"></path><path
              d="M69.43 229.17c0-34.52 27.98-62.5 62.49-62.5h187.46c-23.01 0-41.66 18.66-41.66 41.67v83.33c0 23.01-18.65 41.67-41.66 41.67h-83.31c-46.01 0-83.31 37.31-83.31 83.33v-187.5Z"
              style="fill:url(#microsoft_excel__d);fill-opacity:.3"></path><path
              d="M69.43 83.33C69.43 37.31 106.73 0 152.74 0h166.63v166.67H152.74c-46.01 0-83.31 37.31-83.31 83.33V83.33Z"
              style="fill:url(#microsoft_excel__e)"></path><path
              d="M69.43 83.33C69.43 37.31 106.73 0 152.74 0h166.63v166.67H152.74c-46.01 0-83.31 37.31-83.31 83.33V83.33Z"
              style="fill:url(#microsoft_excel__f)"></path><path
              d="M69.43 83.33C69.43 37.31 106.73 0 152.74 0h166.63v166.67H152.74c-46.01 0-83.31 37.31-83.31 83.33V83.33Z"
              style="fill:url(#microsoft_excel__g)"></path><rect width="208.29" height="166.67" x="277.71" rx="41.66" ry="41.66" style="fill:url(#microsoft_excel__h)"></rect><rect
              width="222.17"
              height="222.22"
              y="236.11"
              rx="45.13"
              ry="45.13"
              style="fill:url(#microsoft_excel__i)"></rect><rect width="222.17" height="222.22" y="236.11" rx="45.13" ry="45.13" style="fill-opacity:.3;fill:url(#microsoft_excel__j)"></rect><path
              d="M169.48 410.71h-34.25l-21.5-40.47c-.77-1.42-1.36-2.54-1.77-3.37-.35-.88-.74-1.89-1.15-3.01h-.35c-.53 1.42-1.03 2.57-1.5 3.45-.47.89-1.03 1.98-1.68 3.28l-22.3 40.11h-32.3l38.76-63.58-36.1-63.4h33.8l19.11 36.13c.77 1.48 1.42 2.78 1.95 3.9.59 1.06 1.18 2.33 1.77 3.81h.35l1.95-4.07c.53-1 1.24-2.33 2.12-3.98l19.82-35.77h32.21l-36.63 62.43 37.7 64.55Z"
              style="fill:#fff"></path></svg
          >
        </div>
      </div>

      <!-- Columna Derecha: Explicación y Botón -->
      <div class="flex flex-col justify-between gap-6 md:col-span-8">
        <div class="space-y-3">
          <div class="flex items-center gap-2 text-emerald-600 dark:text-emerald-400">
            <Icon name="FileSpreadsheet" class="h-5 w-5" />
            <h4 class="text-xs font-semibold tracking-wide uppercase">Estructura del Documento</h4>
          </div>
          <p class="text-sm leading-relaxed text-subheading">
            Esta plantilla Excel contiene la <strong>estructura de columnas exacta</strong> y las <strong>validaciones configuradas</strong> para este tipo de documento. Descárgala para rellenar los
            datos de manera masiva y <strong>garantizar una importación libre de errores</strong>.
          </p>
          <ul class="space-y-2 text-xs text-subheading">
            <li class="flex items-center gap-2">
              <div class="h-1.5 w-1.5 rounded-full bg-emerald-500"></div>
              <span><strong>Columnas de variables</strong> requeridas y opcionales preconfiguradas.</span>
            </li>
            <li class="flex items-center gap-2">
              <div class="h-1.5 w-1.5 rounded-full bg-emerald-500"></div>
              <span><strong>Validación automática</strong> de tipos de datos en cada columna.</span>
            </li>
          </ul>
        </div>

        <div class="flex items-center justify-end gap-3">
          <Button type="submit" id="btn-download" loadingText="Descargando..." icon="Download" size="sm"> Descargar Excel Modelo </Button>
        </div>
      </div>
    </div>
  </form>
</AccordionStep>
