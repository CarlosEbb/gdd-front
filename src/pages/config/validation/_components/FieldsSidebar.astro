---
import Card from '@/components/ui/Card.astro'
import Icon from '@/components/ui/Icon.astro'

interface Props {
  fields: string[]
}

const { fields } = Astro.props
---

<Card class="sticky top-16 col-span-1 flex h-[calc(100vh-20rem)] flex-col">
  <div slot="header">
    <h2 class="text-md text-heading">
      <span class="me-1 inline-flex size-5 items-center justify-center rounded-main bg-primary-foreground p-3 text-base font-semibold text-primary"> 1 </span>
      Selecciona los campos a validar
    </h2>
  </div>
  <div class="h-[calc(100vh-25rem)] space-y-1 overflow-y-auto" id="fields-sidebar">
    {
      fields.map((field) => (
        <div
          class="field-item flex items-center gap-2 rounded-main border border-transparent transition-all duration-200 hover:border-primary hover:bg-primary/10 has-checked:border-primary has-checked:bg-primary-foreground"
          data-field-item={field}
        >
          <label class="flex flex-1 cursor-pointer flex-col p-2">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2 font-mono text-sm text-subheading">
                <input type="radio" name="field-selection" value={field} data-field-radio={field} class="accent-primary" />
                {field}
              </div>
              <div class="flex items-center gap-2">
                <span class="hidden rounded-main bg-orange-100 px-2 py-1 text-xs font-medium text-orange-900" data-required-badge>
                  Requerido
                </span>
              </div>
            </div>
            <div class="hidden flex-col gap-1 pl-5" data-field-info>
              <span class="text-sm font-medium text-heading">
                Tipo:
                <span class="text-xs font-medium text-subheading" data-types-info>
                  -
                </span>
              </span>
              <span class="text-sm font-medium text-heading">
                Validaciones:
                <span class="text-xs font-medium text-subheading" data-validations-info>
                  -
                </span>
              </span>
            </div>
          </label>
          <button
            type="button"
            class="hidden size-6 shrink-0 items-center justify-center rounded-main text-red-500 transition-colors hover:bg-red-100"
            data-btn-delete-field-validation={field}
            title="Eliminar validación"
          >
            <Icon name="Trash2" class="size-3.5" />
          </button>
        </div>
      ))
    }
  </div>
</Card>
