---
import Button from '@/components/ui/Button.astro'
import Card from '@/components/ui/Card.astro'

interface Props {
  elements: string[]
}

const { elements } = Astro.props
---

<Card class="flex h-[calc(100vh-20rem)] flex-col">
  <div slot="header">
    <h2 class="text-md text-heading">
      <span class="me-1 inline-flex size-5 items-center justify-center rounded-main bg-primary-foreground p-3 text-base font-semibold text-primary"> 1 </span>
      Campos a ocultar
    </h2>
  </div>
  <div class="flex-1 space-y-1 overflow-y-auto">
    {
      elements.map((element) => (
        <label class="flex cursor-pointer justify-between rounded-main border border-border p-2 text-subheading transition-all duration-200 hover:border-primary hover:bg-primary-foreground hover:text-primary focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-2 focus-visible:outline-ring has-checked:border-primary has-checked:bg-primary-foreground has-checked:text-primary">
          {element}
          <input
            type="checkbox"
            name={element}
            id={element}
            value={element}
            data-field-hide-checkbox
            class="block accent-primary focus-visible:outline-2 focus-visible:outline-ring"
            aria-label={`Seleccionar ${element} para ocultar`}
          />
        </label>
      ))
    }
  </div>
  <div slot="footer" class="flex justify-end">
    <Button icon="Plus" size="sm" id="btn-create-validation"> Crear validación </Button>
  </div>
</Card>
