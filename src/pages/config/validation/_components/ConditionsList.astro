---
import Card from '@/components/ui/Card.astro'
import EmptyState from '@/components/ui/EmptyState.astro'
---

<Card>
  <div slot="header">
    <h2 class="text-md text-heading">
      <span class="me-1 inline-flex size-5 items-center justify-center rounded-main bg-primary-foreground p-3 text-base font-semibold text-primary"> 3 </span>
      Condiciones
    </h2>
  </div>

  <div class="flex h-full flex-1 items-center justify-center" data-empty-state-paso3>
    <EmptyState title="Sin condiciones" showBorder={false} description="Las condiciones creadas aparecerán aquí" state="info" hiddenAction={true} />
  </div>

  <ul class="hidden space-y-1" data-conditions-container></ul>
</Card>
