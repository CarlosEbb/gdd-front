---
import Input from '@/components/form/Input.astro'
import Button from '@/components/ui/Button.astro'
import { TYPES_DATE } from '../_constants'
---

<div class="absolute top-28 right-0 z-10 mt-4 hidden space-y-2 rounded-main border border-border bg-background p-4 shadow-base" data-date-format-container>
  <h3 class="mb-2 text-base font-medium text-heading">Tipo de fecha</h3>
  <div class="">
    {
      TYPES_DATE.map((type) => (
        <label class="flex cursor-pointer justify-between border-b border-border p-2 text-xs text-heading transition-all duration-200 last:border-b-0 hover:border-primary hover:bg-primary/10 hover:text-primary has-checked:bg-primary/10 has-checked:text-primary has-checked:ring-primary">
          <span class="px-2">{type.label}</span>
          <input type="radio" name="date-format" data-date-format-radio value={type.value} class="block accent-primary checked:border-primary" />
        </label>
      ))
    }

    <!-- Input para formato personalizado (hidden by default) -->
    <div class="mt-2 hidden" data-custom-date-format-container>
      <Input type="text" name="custom-date-format" label="Formato personalizado" placeholder="Ej: DD/MM/YYYY HH:mm" id="custom-date-format-input" />
      <Button size="sm" class="mt-2 w-full" data-btn-confirm-date-format> Confirmar formato </Button>
    </div>
  </div>
</div>
