---
import Button from '@/components/ui/Button.astro'
---

<template id="template-validation-items">
  <div class="validation-item flex items-center justify-between rounded-main border border-border p-4" data-validation-index="">
    <div class="flex-1">
      <div class="flex items-center gap-2">
        <span class="rounded-main bg-primary-foreground px-2 py-1 text-xs font-medium text-subheading" data-label-validation></span>
        <span class="text-sm font-medium text-subheading" data-value-validation></span>
      </div>
      <p class="mt-1 text-xs text-subheading" data-message-validation></p>
    </div>
    <div>
      <Button variant="destructive" size="sm" icon="X" iconOnly data-btn-delete-validation-item />
    </div>
  </div>
</template>
