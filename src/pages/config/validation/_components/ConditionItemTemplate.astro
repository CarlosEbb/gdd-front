---
import Button from '@/components/ui/Button.astro'
import Icon from '@/components/ui/Icon.astro'
---

<template id="template-condition-item">
  <li class="group rounded-main border border-border bg-muted p-3 transition-all duration-200 hover:border-primary/40" data-condition-index="">
    <div class="flex items-start justify-between gap-2">
      <div class="flex-1 space-y-2">
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1 text-xs text-muted-foreground">
            <Icon name="Eye" size={14} />
            Ocultar:
          </span>
          <span class="rounded-main bg-primary/10 px-2 py-0.5 text-xs font-semibold text-primary" data-field-text></span>
        </div>

        <div class="flex items-center gap-1.5 pl-5">
          <span class="rounded-main border border-border bg-background px-2 py-0.5 text-xs font-medium text-heading" data-hidden-by-text></span>
          <span class="text-xs font-semibold text-warning" data-operator-text></span>
          <span class="max-w-32 truncate rounded-main border border-border bg-background px-2 py-0.5 text-xs font-medium text-heading" data-value-text></span>
        </div>
      </div>

      <Button variant="destructive" size="sm" icon="X" iconOnly data-btn-delete-condition aria-label="Eliminar condición" class="opacity-0 transition-opacity group-hover:opacity-100" />
    </div>

    <span class="hidden" data-message-text></span>
  </li>
</template>
