---
import Button from '@/components/ui/Button.astro'
---

<div id="static-schema-banner" class="hidden flex-col gap-2 border-b border-border bg-secondary px-3 py-2 text-sm text-heading sm:flex-row sm:items-center sm:justify-between sm:px-4">
  <div class="flex min-w-0 flex-wrap items-center gap-2">
    <span class="inline-flex size-2 shrink-0 animate-pulse rounded-full bg-primary"></span>
    <span class="font-medium">Modo esquema estático:</span>
    <span class="text-subheading">Edita el encabezado y pie de página directamente en el lienzo. Se mostrarán fijos en todas las páginas.</span>
  </div>
  <div class="flex shrink-0 items-center gap-2">
    <Button type="button" size="sm" variant="secondary" data-open-modal="header-footer"> Configuración </Button>
    <Button type="button" size="sm" id="btn-end-static-banner"> Terminar edición </Button>
  </div>
</div>

<div id="container" class="h-[calc(100vh-56px)] w-full"></div>

<style>
  /* text y multiVariableText siguen registrados para documentos existentes */
  :global(.pdfme-designer-left-sidebar > div:has(.pdfme-designer-plugin-text)),
  :global(.pdfme-designer-left-sidebar > div:has(.pdfme-designer-plugin-multiVariableText)) {
    display: none;
  }

  /* En modo esquema estático, mostrar plugins necesarios (text, multiVariableText) y ocultar tabla */
  :global(body[data-editing-static-schema='true'] .pdfme-designer-left-sidebar > div:has(.pdfme-designer-plugin-text)),
  :global(body[data-editing-static-schema='true'] .pdfme-designer-left-sidebar > div:has(.pdfme-designer-plugin-multiVariableText)) {
    display: flex !important;
  }

  :global(body[data-editing-static-schema='true'] .pdfme-designer-left-sidebar > div:has(.pdfme-designer-plugin-table)) {
    display: none !important;
  }

  /*
    pdfme pinta los controles de la hoja (columnas de la tabla, borrar firma, etc.)
    como <button> sin color. El preflight los deja transparentes y heredan el texto
    del body, que en modo claro es casi blanco, así que desaparecen sobre el papel.
  */
  :global(.pdfme-designer-canvas .selectable button) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #171717;
    background-color: #ffffff;
    border: 1px solid #a3a3a3;
    border-radius: 6px;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.18);
    cursor: pointer;
    font-size: 16px;
    font-weight: 600;
    line-height: 1;
  }

  :global(.pdfme-designer-canvas .selectable button:hover) {
    background-color: #f3f4f6;
    border-color: #525252;
  }
</style>
<input type="file" id="uploadTemplateInput" accept=".json" class="hidden" />
<input type="file" id="basePdfInput" class="hidden" accept="application/pdf" />
