---
import Modal from '@/components/modal/Modal.astro'
import Button from '@/components/ui/Button.astro'
import Icon from '@/components/ui/Icon.astro'
---

<Modal title="Cambios sin guardar" modalId="unsaved-changes">
  <div class="flex flex-col items-center justify-center py-5">
    <Icon name="TriangleAlert" size={48} stroke-width={1.5} class="text-warning" />
    <p class="mt-3 text-center text-heading">Tienes cambios sin guardar. Si sales ahora, se perderán los últimos cambios.</p>
  </div>
  <div class="flex justify-end space-x-4 border-t border-border pt-4">
    <Button type="button" size="sm" variant="outline" data-close-modal>Cancelar</Button>
    <Button type="button" size="sm" variant="destructive" id="btn-leave-without-saving">Salir sin guardar</Button>
  </div>
</Modal>
