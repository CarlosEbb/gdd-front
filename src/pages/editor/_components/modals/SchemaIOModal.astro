---
import Modal from '@/components/modal/Modal.astro'
import Button from '@/components/ui/Button.astro'
import Icon from '@/components/ui/Icon.astro'
---

<Modal title="Importar y exportar schema" modalId="schema-io">
  <div class="space-y-4">
    <p class="text-xs text-subheading">Descarga el schema actual o reemplázalo con un archivo JSON.</p>

    <div class="grid grid-cols-1 gap-3">
      <div class="rounded-main border border-border bg-muted/40 p-3 sm:p-4" role="region" aria-labelledby="export-schema-title">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
          <div class="flex min-w-0 items-start gap-3">
            <Icon name="Download" stroke-width={1.5} class="mt-0.5 size-5 shrink-0 text-primary" />
            <div class="min-w-0 space-y-1">
              <p id="export-schema-title" class="text-sm font-semibold text-heading">Exportar schema</p>
              <p class="text-xs text-subheading">Descarga el schema del documento en un archivo JSON.</p>
            </div>
          </div>
          <Button type="button" size="sm" variant="outline" id="downloadTemplateBtn" icon="Download" class="w-full shrink-0 sm:w-auto">
            Descargar JSON
          </Button>
        </div>
      </div>

      <div class="rounded-main border border-border bg-muted/40 p-3 sm:p-4" role="region" aria-labelledby="import-schema-title">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
          <div class="flex min-w-0 items-start gap-3">
            <Icon name="FileUp" stroke-width={1.5} class="mt-0.5 size-5 shrink-0 text-primary" />
            <div class="min-w-0 space-y-1">
              <p id="import-schema-title" class="text-sm font-semibold text-heading">Importar schema</p>
              <p class="text-xs text-subheading">Carga un archivo JSON para reemplazar el schema actual.</p>
            </div>
          </div>
          <Button type="button" size="sm" variant="outline" id="loadTemplateBtn" icon="FileUp" class="w-full shrink-0 sm:w-auto">
            Cargar JSON
          </Button>
        </div>
      </div>
    </div>

    <div class="flex justify-end border-t border-border pt-4">
      <Button type="button" size="sm" variant="outline" data-close-modal>Cerrar</Button>
    </div>
  </div>
</Modal>
