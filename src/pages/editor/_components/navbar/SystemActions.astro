---
import Button from '@/components/ui/Button.astro'
import Link from '@/components/ui/Link.astro'

interface Props {
  uuid: string
  buildNumber: string
  uuidWorkspace?: string
  nameWorkspace?: string
}

const { uuid, buildNumber, uuidWorkspace = '', nameWorkspace = '' } = Astro.props

const documentationParams = new URLSearchParams({ build_number: buildNumber })
if (uuidWorkspace) documentationParams.set('id_workspace', uuidWorkspace)
if (nameWorkspace) documentationParams.set('name_workspace', nameWorkspace)
const documentationHref = `/config/documentation/${uuid}?${documentationParams.toString()}`
---

<div class="hidden shrink-0 items-center gap-x-2 lg:flex">
  <Button
    type="button"
    size="sm"
    iconOnly
    variant="transparent"
    data-open-modal="delete-document"
    title="Eliminar documento"
    class="!hover:bg-red-50 !hover:text-red-600 text-red-500"
    icon="Trash"
  />

  <div class="mx-1 hidden h-8 w-px shrink-0 bg-muted-foreground lg:block"></div>

  <Link href={documentationHref} id="documentationLink" size="sm" variant="transparent" title="Documentación" icon="FileInput">
    <span class="hidden xl:inline">Documentación</span>
  </Link>

  <Button type="button" size="sm" id="btn-save-document" loadingText="Guardando..." data-uuid-template={uuid} title="Guardar" class="shrink-0" icon="Save">
    <span class="hidden md:inline">Guardar</span>
  </Button>
</div>
