---
import Button from '@/components/ui/Button.astro'
import { PUBLIC_NAME_PROJECT } from 'astro:env/client'
import logo from '@/assets/images/imagotipo.png'
---

<div class="flex items-center gap-2">
  <Button variant="ghost" size="sm" iconOnly class="shrink-0" aria-label="Abrir menú" data-sidebar-toggle icon="Menu" />

  <div class="flex h-full items-center justify-center">
    <a href="/home">
      <img transition:name="image-transition" transition:animate="fade" src={logo.src} alt={PUBLIC_NAME_PROJECT} class="aspect-auto h-7 max-w-20 object-contain md:max-w-28" draggable="false" />
    </a>
  </div>
</div>
