---
import Button from '@/components/ui/Button.astro'
import Icon from '@/components/ui/Icon.astro'
import Dropdown from '@/components/ui/Dropdown.astro'

interface Props {
  showPageForView?: boolean
}

const { showPageForView = false } = Astro.props
---

<Button
  type="button"
  size="sm"
  variant="ghost"
  id="pagination-delete-page"
  title="Eliminar pagina actual"
  aria-label="Eliminar pagina actual"
  class="shrink-0 text-red-500 hover:bg-red-50! hover:text-red-600!"
  icon="FileX"
>
  <span class="hidden xl:inline">Eliminar pagina</span>
</Button>
<div id="pagination-bar" class="hidden shrink-0 items-center">
  <div class="mx-1 h-8 w-px shrink-0 bg-gray-200"></div>
  <div class="inline-flex items-center gap-x-0.5">
    <button
      type="button"
      id="pagination-prev"
      aria-label="Página anterior"
      title="Página anterior"
      class="inline-flex h-9 w-9 items-center justify-center rounded-md text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900 focus:outline-none disabled:pointer-events-none disabled:opacity-40"
      disabled
    >
      <Icon name="ChevronLeft" class="size-4" stroke-width={2} />
    </button>
    <div class="inline-flex h-9 items-center gap-x-1 px-1 font-semibold whitespace-nowrap text-gray-700">
      <input
        type="number"
        id="pagination-page-input"
        min="1"
        aria-label="Ir a página"
        class="h-6 w-12 rounded bg-gray-100 text-center font-semibold text-gray-800 tabular-nums [-moz-appearance:textfield] focus:bg-gray-100 focus:ring-1 focus:ring-gray-400 focus:outline-none [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
      />
      <span class="text-gray-400">/</span>
      <span id="pagination-total" class="tabular-nums">0</span>
    </div>
    <button
      type="button"
      id="pagination-next"
      aria-label="Página siguiente"
      title="Página siguiente"
      class="inline-flex h-9 w-9 items-center justify-center rounded-md text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900 focus:outline-none disabled:pointer-events-none disabled:opacity-40"
      disabled
    >
      <Icon name="ChevronRight" class="size-4" stroke-width={2} />
    </button>
    {
      showPageForView && (
        <div id="pagination-chunk-size-wrapper" class="hidden sm:inline-flex" title="Páginas visibles">
          <Dropdown buttonLabel="Páginas visibles: 1" size="sm" border="none" shadow="none" position="right">
            <ul class="py-1" role="listbox" aria-label="Páginas visibles">
              {[1, 3, 5].map((n) => (
                <li>
                  <button type="button" role="option" data-chunk-size={n} class="flex w-full items-center justify-between gap-x-4 px-3 py-1.5 text-sm text-gray-700 hover:bg-gray-100">
                    <span>
                      {n} {n === 1 ? 'página' : 'páginas'}
                    </span>
                  </button>
                </li>
              ))}
            </ul>
          </Dropdown>
        </div>
      )
    }
  </div>
  <div class="mx-1 h-8 w-px shrink-0 bg-gray-200"></div>
</div>
<Button type="button" size="sm" variant="transparent" id="pagination-create-page" title="Crear pagina" aria-label="Crear pagina" icon="FilePlus">
  <span class="hidden xl:inline">Crear pagina</span>
</Button>
