---
import EditorLayout from '@/layouts/EditorLayout.astro'
import Editor from '@/components/editor/EditorPdf.astro'

const { uuid } = Astro.params

if (!uuid) return Astro.redirect('/home')
---

<EditorLayout class="px-0 pt-14" title="Editor de documentos">
  <div class="">
    <Editor uuid={uuid} />
  </div>
</EditorLayout>
