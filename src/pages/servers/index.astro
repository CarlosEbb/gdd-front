---
import MainLayout from '@/layouts/MainLayout.astro'
import { actions } from 'astro:actions'
import EmptyState from '@/components/ui/EmptyState.astro'
import List from '@/components/ui/List.astro'
import type { DetailsServer } from '@/types/servers'
import Container from '@/components/ui/Container.astro'
import Icon from '@/components/ui/Icon.astro'
import Link from '@/components/ui/Link.astro'
import DataGrid from '@/components/ui/DataGrid.astro'
import Input from '@/components/form/Input.astro'
import Header from '@/components/ui/Header.astro'

const currentPath = Astro.url.pathname
const { data, error } = await Astro.callAction(actions.servers.list, {})

const servers = data?.data || []
const hasServers = servers.length > 0
---

<MainLayout title="Servidores">
  <Container>
    <Header title="Gestión de servidores" subtitle={`Total: ${servers.length} servidores`}>
      <div slot="actions">
        <Link size="sm" href="/servers/new" icon="Plus">Crear Servidor</Link>
      </div>
    </Header>

    <DataGrid hasData={hasServers} isError={error}>
      <EmptyState slot="error-state" title="Error al cargar los servidores" description="Intenta nuevamente." href={currentPath} state="error" />

      <EmptyState slot="empty-state" title="No hay servidores disponibles" description="No tienes ningún servidor registrado." href={currentPath} state="notFound" />

      <div slot="header" class="mb-4">
        <Input name="search" type="search" placeholder="Buscar servidor..." />
      </div>
      {
        servers.map((server: DetailsServer) => (
          <List icon="Server" title={`Puerto: ${server.puerto}`} subtitle={`IP: ${server.ip}`}>
            <div slot="actions">
              <Link href={`/servers/${server.uuid}`} variant="transparent" size="icon">
                <Icon name="ChevronRight" stroke-width={1.5} size={16} />
              </Link>
            </div>
          </List>
        ))
      }
    </DataGrid>
  </Container>
</MainLayout>
