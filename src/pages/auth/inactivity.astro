---
import AuthLayout from '@/layouts/AuthLayout.astro'
import Icon from '@/components/ui/Icon.astro'
---

<AuthLayout titleTabBrowser="Sesión expirada" titleCardAuth="Sesión expirada">
  <div class="flex flex-col items-center justify-center py-5">
    <Icon name="Clock" size={64} stroke-width={1.5} class="text-yellow-500" />
    <p class="mt-5 text-lg font-semibold text-gray-900">Tu session ha expirado por inactividad.</p>
    <p class="text-sm text-gray-500">Por favor, inicia sesión nuevamente.</p>

    <a href="/" class="mt-4 rounded-main bg-primary px-4 py-2 text-sm text-white hover:bg-primary/80"> Iniciar sesión </a>
  </div>
</AuthLayout>
