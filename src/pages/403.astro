---
import Layout from '@/layouts/Layout.astro'
import forbiddenImage from '@/assets/images/imagotipo.png'
import Link from '@/components/ui/Link.astro'
---

<Layout title="Acceso denegado">
  <div class="flex min-h-screen items-center justify-center bg-foreground">
    <div class="flex min-h-80 min-w-4xl flex-col items-center justify-center space-y-14 rounded-main border border-dashed border-border p-16 text-center shadow-base">
      <img src={forbiddenImage.src} transition:name="image-transition" transition:animate="fade" alt="403" width={400} height={400} />
      <h1 class="text-7xl font-bold text-heading">403</h1>
      <div class="space-y-4">
        <div>
          <p class="mt-4 text-xl text-subheading">Acceso denegado</p>
          <p class="mt-2 text-subheading">No tienes permisos para acceder a esta sección.</p>
        </div>
        <Link href="/home" variant="gradient" size="sm"> Volver al inicio </Link>
      </div>
    </div>
  </div>
</Layout>
