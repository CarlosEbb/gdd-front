---
import MainLayout from '@/layouts/MainLayout.astro'
import Container from '@/components/ui/Container.astro'
import CardList from '@/components/ui/CardList.astro'
import Link from '@/components/ui/Link.astro'
import Icon from '@/components/ui/Icon.astro'
import Input from '@/components/form/Input.astro'
import Header from '@/components/ui/Header.astro'

const LIST_USERS = [
  {
    id: 1,
    name: 'Carlos Martínez',
    description: 'Cliente: Mi Empresa SL',
    secondaryText: 'Activo hace 2h',
  },
  {
    id: 2,
    name: 'Ana García',
    description: 'Cliente: Ferretería Sb',
    secondaryText: 'En línea',
  },
  {
    id: 3,
    name: 'Miguel Rodríguez',
    description: 'Cliente: Soluciones SRL',
    secondaryText: 'Hace 1 día',
  },
  {
    id: 4,
    name: 'Laura Fernández',
    description: 'Cliente: Daka SL',
    secondaryText: 'Hace 3h',
  },
  {
    id: 5,
    name: 'Javier López',
    description: 'Cliente: Tech Solutions SL',
    secondaryText: 'Hace 5h',
  },
]
const totalUsers = LIST_USERS.length
---

<MainLayout title="Usuarios">
  <Container>
    <Header title="Gestión de usuarios" subtitle={`Total: ${totalUsers} usuarios`}>
      <div slot="actions">
        <Link href="/users/form-user" size="sm" icon="Plus"> Crear usuarios </Link>
      </div>
    </Header>

    <div class="mb-4">
      <Input name="search" type="search" placeholder="Buscar usuario..." />
    </div>

    <div class="overflow-hidden rounded-main border border-border bg-background">
      {
        LIST_USERS.map((user) => (
          <CardList icon="User" title={user.name} description={user.description} secondaryText={user.secondaryText}>
            <div slot="actions" class="flex gap-1">
              <Link href={`/users/${user.id}/edit`} variant="outline" size="icon">
                <Icon stroke-width={1.5} name="Pencil" size={16} />
              </Link>
              <Link href={`/users/${user.id}`} variant="outline" size="icon">
                <Icon stroke-width={1.5} name="ChevronRight" size={16} />
              </Link>
            </div>
          </CardList>
        ))
      }
    </div>
  </Container>
</MainLayout>
