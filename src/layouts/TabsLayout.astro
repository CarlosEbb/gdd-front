---
import MainLayout from '@/layouts/MainLayout.astro'
import TitleForPage from '@/components/ui/TitleForPage.astro'

interface Props {
  title: string
  navigation: { href: string; label: string }[]
  titleForPage: string
}

const { title, navigation, titleForPage } = Astro.props

const pathname = Astro.url.pathname
const currentPath = pathname + Astro.url.search
---

<MainLayout title={title}>
  <div class="mx-auto max-w-7xl">
    <TitleForPage title={titleForPage} />

    <section class="mb-10 border-b border-gray-200">
      <ul class="flex gap-x-4">
        {
          navigation.map((item) => (
            <li>
              <a href={item.href} class:list={['text-sm', { 'border-b border-blue-muted text-blue-muted': currentPath === item.href }]}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <slot />
    </section>
  </div>
</MainLayout>
