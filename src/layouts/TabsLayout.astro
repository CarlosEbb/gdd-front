---
import MainLayout from '@/layouts/MainLayout.astro'
import Header from '@/components/ui/Header.astro'
import Container from '@/components/ui/Container.astro'
import type { BreadcrumbItem } from '@/components/ui/Breadcrumb.astro'

interface Props {
  title: string
  navigation: { href: string; label: string }[]
  titleForPage: string
}

const { title, navigation, titleForPage } = Astro.props

const pathname = Astro.url.pathname
const search = Astro.url.search
const currentPath = pathname + search
const hasActions = Astro.slots.has('actions')

const activeTab = navigation.find((item) => item.href === currentPath) ?? navigation.find((item) => pathname.startsWith(item.href.split('?')[0]))

const breadcrumbItems: BreadcrumbItem[] = [{ label: 'Inicio', href: '/home' }, ...(activeTab ? [{ label: activeTab.label }] : [])]
---

<MainLayout title={title}>
  <Container>
    <Header title={titleForPage} subtitle="Consulta y gestiona la API de los documentos" breadcrumbItems={breadcrumbItems}>
      {
        hasActions && (
          <Fragment slot="actions">
            <slot name="actions" />
          </Fragment>
        )
      }
    </Header>

    <section class="mb-10 border-b border-border">
      <ul class="flex gap-x-8">
        {
          navigation.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'inline-block px-4 py-3 text-sm font-medium transition-colors',
                  {
                    'border-b-2 border-primary text-primary': currentPath === item.href,
                    'text-subheading hover:text-heading': currentPath !== item.href,
                  },
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mb-16">
      <slot />
    </section>
  </Container>
</MainLayout>
