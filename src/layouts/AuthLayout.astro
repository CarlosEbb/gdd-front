---
import '@/styles/global.css'

import { Image } from 'astro:assets'
import logo from '@/assets/images/imagotipo.png'
import Layout from './Layout.astro'

import bgTest2 from '@/assets/images/bg-1.avif'
import bgTest from '@/assets/images/bg-2.avif'
import bgTest4 from '@/assets/images/bg-4.avif'

interface Props {
  titleTabBrowser?: string
  titleCardAuth: string
  descriptionCardAuth: string
}

interface PromoSlide {
  image: ImageMetadata
  title: string
  description: string
}

const promoSlides: PromoSlide[] = [
  {
    image: bgTest,
    title: 'Documentos inteligentes para equipos que avanzan',
    description: 'Con CreaDocs creas, organizas y generas documentos desde un solo lugar: plantillas, espacios de trabajo y automatización para agilizar tu operación.',
  },
  {
    image: bgTest2,
    title: 'De la idea al documento, sin fricción',
    description: 'Diseña plantillas, colabora en espacios de trabajo y genera documentos listos para usar. Menos pasos manuales, más control y trazabilidad.',
  },
  {
    image: bgTest4,
    title: 'Menos papel, más impacto positivo',
    description: 'Con CreaDocs digitalizas tus procesos y reduces el uso de papel: genera, gestiona y reutiliza documentos de forma sostenible, sin perder control ni trazabilidad.',
  },
]

const { titleTabBrowser = null, titleCardAuth, descriptionCardAuth = 'Escribe tu email y contraseña para iniciar sesión' } = Astro.props
const currentYear = new Date().getFullYear()
const promoSlide = promoSlides[Math.floor(Math.random() * promoSlides.length)]
---

<Layout title={titleTabBrowser}>
  <div class="grid min-h-svh lg:grid-cols-3">
    <div class="flex flex-col gap-4 p-6 md:p-10">
      <div class="flex flex-1 items-center justify-center">
        <div class="w-full max-w-md space-y-12">
          <header class="flex flex-col items-center">
            <a href="/" class="mb-7 flex items-center gap-2 font-medium">
              <div class="flex w-40 items-center justify-center rounded-md text-primary-foreground">
                <img src={logo.src} alt="Salto angel" class="h-full w-64 rounded-main object-cover select-none lg:w-full" draggable="false" />
              </div>
            </a>
            <div class="flex flex-col items-center gap-1 text-center text-heading">
              <h1 class="text-2xl font-bold">{titleCardAuth}</h1>
              <p class="text-sm text-balance text-muted-foreground">
                {descriptionCardAuth}
              </p>
            </div>
          </header>
          <slot />

          <footer>
            <p class="text-center text-base text-subheading">
              <span class="mt-1 block"
                >© Made by <a href="https://www.solucioneslaser.com/" target="_blank" rel="noopener noreferrer" class="border-b border-dashed border-border">Soluciones Laser</a> {currentYear}</span
              >
            </p>
          </footer>
        </div>
      </div>
    </div>
    <div class="relative hidden bg-white lg:col-span-2 lg:block">
      <div class="absolute inset-2 overflow-hidden rounded-lg bg-primary/10">
        <Image
          src={promoSlide.image}
          alt=""
          widths={[960, 1280, 1600, 1920]}
          sizes="(min-width: 1024px) 66vw, 100vw"
          quality={80}
          format="webp"
          loading="eager"
          decoding="async"
          class="auth-promo__image h-full w-full object-cover"
        />
        <div class="pointer-events-none absolute inset-0" aria-hidden="true">
          <div class="absolute inset-0 bg-linear-to-tr from-heading/50 via-primary/35 to-heading/30"></div>
          <div class="absolute inset-0 bg-linear-to-t from-heading/75 via-primary/25 to-transparent"></div>
          <div class="absolute inset-0 bg-linear-to-r from-heading/30 via-transparent to-primary/20"></div>
          <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,color-mix(in_oklab,var(--primary)_35%,transparent),transparent_50%)]"></div>
        </div>
        <div class="absolute inset-0 z-10 flex items-end p-8 lg:p-14 xl:p-16">
          <section class="auth-promo max-w-4xl space-y-4" aria-labelledby="auth-promo-title">
            <h2
              id="auth-promo-title"
              class="auth-promo__item auth-promo__item--title text-3xl font-bold tracking-tight text-balance text-white drop-shadow-sm sm:text-4xl lg:text-5xl lg:leading-[1.1]"
            >
              {promoSlide.title}
            </h2>
            <p
              id="auth-promo-description"
              class="auth-promo__item auth-promo__item--description max-w-lg text-sm leading-relaxed text-pretty text-white/85 drop-shadow-sm sm:text-base lg:text-lg lg:leading-8"
            >
              {promoSlide.description}
            </p>
          </section>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  @keyframes auth-promo-reveal {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
      filter: blur(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  @keyframes auth-promo-image-reveal {
    from {
      opacity: 0.35;
      transform: scale(1.06);
      filter: blur(24px);
    }
    to {
      opacity: 1;
      transform: scale(1);
      filter: blur(0);
    }
  }

  .auth-promo__image {
    animation: auth-promo-image-reveal 1.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .auth-promo__item {
    opacity: 0;
    animation: auth-promo-reveal 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .auth-promo__item--title {
    animation-delay: 0.35s;
  }

  .auth-promo__item--description {
    animation-delay: 0.55s;
  }

  @media (prefers-reduced-motion: reduce) {
    .auth-promo__image,
    .auth-promo__item {
      opacity: 1;
      animation: none;
      filter: none;
      transform: none;
    }
  }
</style>
