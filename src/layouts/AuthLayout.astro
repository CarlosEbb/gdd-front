---
import '@/styles/global.css'

import bgAuth from '@/assets/images/img-login.jpg'
import logo from '@/assets/images/imagotipo.png'
import Layout from './Layout.astro'

const { PUBLIC_NAME_PROJECT } = import.meta.env

interface Props {
  titleTabBrowser?: string
  titleCardAuth: string
}

const { titleTabBrowser = null, titleCardAuth } = Astro.props
const optionalTitle = titleTabBrowser === null ? PUBLIC_NAME_PROJECT : `${titleTabBrowser} | ${PUBLIC_NAME_PROJECT}`
---

<Layout title={optionalTitle}>
  <div class="flex min-h-screen items-center justify-center bg-foreground">
    <div class="flex min-h-[calc(100vh-285px)] w-full max-w-none flex-col overflow-hidden bg-transparent md:max-w-xl md:rounded-main md:bg-white md:shadow-2xl lg:max-w-4xl lg:flex-row">
      <div class="relative hidden h-64 overflow-hidden lg:block lg:h-auto lg:w-1/2 lg:bg-none">
        <div class="absolute h-full w-full rotate-0 pe-2">
          <img transition:name="image-transition" transition:animate="fade" src={bgAuth.src} alt="Decorative gradient" class="h-full w-64 rounded-main object-cover lg:w-full" />
        </div>
      </div>

      <div class="relative flex flex-1 flex-col justify-center overflow-hidden p-8 md:bg-background">
        <header class="flex flex-col items-center">
          <img src={logo.src} transition:animate="initial" alt="CreaDocs" class="mb-7 aspect-auto w-64 object-cover md:w-64 lg:w-72 xl:w-80" />
          <h1 transition:animate="fade" class="mt-3 text-center text-lg font-semibold text-heading md:mt-5">
            {titleCardAuth}
          </h1>
        </header>
        <main transition:animate="fade" class="my-3 md:my-4">
          <slot />
        </main>
        <footer>
          <p class="text-center text-base text-subheading">
            <span class="mt-1 block">© Made by Soluciones Laser 2025</span>
          </p>
        </footer>
      </div>
    </div>
  </div>
</Layout>
