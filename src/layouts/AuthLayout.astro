---
import '@/styles/global.css'

import gddLogin from '@/assets/images/img-login.jpg'
import gddLogo from '@/assets/images/creadocs.png'

import { ClientRouter } from 'astro:transitions'

interface Props {
  titleTabBrowser?: string
  titleCardAuth: string
}

const { titleTabBrowser = null, titleCardAuth } = Astro.props
const { PUBLIC_IS_SANDBOX } = import.meta.env
console.log(PUBLIC_IS_SANDBOX)
const optionalTitle = titleTabBrowser === null ? 'GDD' : `${titleTabBrowser} | GDD`
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={'@/assets/images/favicon.ico'} />
    <title>{optionalTitle}</title>
    <ClientRouter />
  </head>
  <body class="flex min-h-screen items-center justify-center bg-white from-gray-50 via-blue-50 to-gray-100 md:bg-linear-to-br">
    <div class="flex min-h-[calc(100vh-186px)] w-full max-w-none flex-col overflow-hidden bg-transparent md:max-w-xl md:rounded-2xl md:bg-white md:shadow-2xl lg:max-w-5xl lg:flex-row">
      <div class="relative hidden h-64 overflow-hidden lg:block lg:h-auto lg:w-1/2 lg:bg-none">
        <div class="absolute h-full w-full rotate-0 pe-2">
          <img src={gddLogin.src} alt="Decorative gradient" class="h-full w-64 rounded-xl object-cover lg:w-full" />
        </div>
      </div>

      <div class="relative flex flex-1 flex-col justify-center overflow-hidden p-8 md:bg-white">
        <header class="flex flex-col items-center">
          <div class="relative flex items-center justify-center">
            <img src={gddLogo.src} transition:animate="initial" alt="GDDLogo" class="mb-12 aspect-auto w-64 object-cover md:w-64 lg:w-72 xl:w-80" />
            {
              PUBLIC_IS_SANDBOX === 'true' && (
                <span class="absolute top-3 -right-5 rotate-12 rounded-full bg-amber-100 px-2 py-1 text-[10px] leading-none font-semibold text-amber-700 uppercase shadow-sm md:text-xs">Sandbox</span>
              )
            }
          </div>
          <h1 transition:animate="fade" class="mt-3 text-center text-lg font-semibold text-custom-lucky-gray-light md:mt-5">
            {titleCardAuth}
          </h1>
        </header>
        <main transition:animate="fade" class="my-3 md:my-4">
          <slot />
        </main>
        <footer>
          <p class="text-center text-base text-custom-lucky-gray-light">
            <span class="mt-1 block">© Made by Soluciones Laser 2025</span>
          </p>
        </footer>
      </div>
    </div>
  </body>
</html>
