---
import '@/styles/global.css'
import { ClientRouter } from 'astro:transitions'

const { PUBLIC_NAME_PROJECT } = import.meta.env

interface Props {
  title?: string
}

const { title = null } = Astro.props as Props

const optionalTitle = title === null ? PUBLIC_NAME_PROJECT : `${title} | ${PUBLIC_NAME_PROJECT}`
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={'@/assets/images/favicon.ico'} />
    <title>{optionalTitle}</title>
    <script src="@/scripts/modal.ts"></script>
    <ClientRouter />
  </head>

  <body>
    <slot />
  </body>
</html>
