---
import Button from '@/components/ui/Button.astro'
import Link from '@/components/ui/Link.astro'
import Icon from '@/components/ui/Icon.astro'

interface Props {
  formId: string
  submitText: string
  loadingText?: string
  cancelHref?: string
  method?: 'post' | 'get'
  isEdit?: boolean
}

const { formId, submitText, loadingText = 'Guardando...', cancelHref = '/', method = 'post', isEdit = false } = Astro.props
---

<form id={formId} method={method} class="space-y-8" data-is-edit={isEdit.toString()}>
  <slot />

  <div class="h-48"></div>

  <div class="fixed right-0 bottom-0 left-0 z-10 flex items-center border-t border-border bg-background py-4 lg:ml-16 xl:ml-24">
    <div class="mx-auto flex w-full max-w-6xl justify-end gap-4">
      <Link href={cancelHref} size="sm" variant="secondary">Cancelar</Link>
      <Button type="submit" size="sm" id={`${formId}-submit`} data-loading-text={loadingText}>
        <span class="flex items-center gap-2">
          <Icon name="Save" size={18} />
          {submitText}
        </span>
      </Button>
    </div>
  </div>
</form>
