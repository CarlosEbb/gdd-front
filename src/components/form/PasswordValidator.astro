---
interface Props {
  passwordName: string
  confirmName: string
}

const { passwordName, confirmName } = Astro.props
---

<div
  class="mt-1.5 hidden rounded-main border border-border bg-muted/50 px-3 py-2 transition-colors duration-200"
  data-password-validator
  data-password-name={passwordName}
  data-confirm-name={confirmName}
>
  <div class="flex items-center justify-between gap-2">
    <p class="text-sm text-muted-foreground transition-colors duration-200" data-validator-message aria-live="polite" aria-atomic="true"></p>
    <span class="shrink-0 text-xs font-medium text-muted-foreground" data-validator-counter></span>
  </div>
</div>

<script>
  interface PasswordRule {
    test: (value: string) => boolean
    message: string
  }

  const PASSWORD_RULES: PasswordRule[] = [
    { test: (v) => v.length >= 8 && v.length <= 64, message: 'Debe tener entre 8 y 64 caracteres' },
    { test: (v) => !v.includes(' '), message: 'No se permiten espacios' },
    { test: (v) => /[a-z]/.test(v), message: 'Falta al menos una letra minúscula' },
    { test: (v) => /[A-Z]/.test(v), message: 'Falta al menos una letra mayúscula' },
    { test: (v) => /\d/.test(v), message: 'Falta al menos un número' },
    { test: (v) => /[^a-zA-Z0-9]/.test(v), message: 'Falta al menos un carácter especial' },
  ]

  function initValidator(container: HTMLElement) {
    const passwordName = container.dataset.passwordName!
    const confirmName = container.dataset.confirmName!
    const messageEl = container.querySelector('[data-validator-message]') as HTMLParagraphElement
    const counterEl = container.querySelector('[data-validator-counter]') as HTMLSpanElement

    const form = container.closest('form') ?? document.querySelector(`form:has(input[name="${passwordName}"])`)
    if (!form) return

    const passwordInput = form.querySelector<HTMLInputElement>(`input[name="${passwordName}"]`)
    const confirmInput = form.querySelector<HTMLInputElement>(`input[name="${confirmName}"]`)
    if (!passwordInput || !confirmInput) return

    const isEditForm = form.getAttribute('data-is-edit') === 'true'
    const totalRules = PASSWORD_RULES.length

    function validate() {
      const password = passwordInput!.value
      const confirm = confirmInput!.value

      // En edición, si ambos campos están vacíos no validar
      if (isEditForm && password === '' && confirm === '') {
        toggleVisibility(false)
        passwordInput!.setCustomValidity('')
        confirmInput!.setCustomValidity('')
        return
      }

      // Si el campo de contraseña está vacío, ocultar el contenedor
      if (password === '') {
        toggleVisibility(false)
        passwordInput!.setCustomValidity('')
        confirmInput!.setCustomValidity('')
        return
      }

      // Contar reglas cumplidas
      const passed = PASSWORD_RULES.filter((rule) => rule.test(password)).length
      updateCounter(passed)
      toggleVisibility(true)

      // Buscar la primera regla que falle
      const failedRule = PASSWORD_RULES.find((rule) => !rule.test(password))

      if (failedRule) {
        setMessage(failedRule.message, 'warning')
        passwordInput!.setCustomValidity(failedRule.message)
        confirmInput!.setCustomValidity('')
        return
      }

      // Todas las reglas de fortaleza pasan, verificar coincidencia
      passwordInput!.setCustomValidity('')

      if (confirm !== '' && password !== confirm) {
        setMessage('Las contraseñas no coinciden', 'error')
        confirmInput!.setCustomValidity('Las contraseñas no coinciden')
        return
      }

      confirmInput!.setCustomValidity('')

      if (confirm === '') {
        // Falta confirmar, mostrar indicación
        setMessage('Confirma tu contraseña', 'muted')
      } else {
        // Todo OK: mostrar éxito brevemente y ocultar
        setMessage('✓ Contraseña válida', 'success')
        setTimeout(() => toggleVisibility(false), 1500)
      }
    }

    function toggleVisibility(show: boolean) {
      container.classList.toggle('hidden', !show)
    }

    function updateCounter(passed: number) {
      counterEl.textContent = `${passed}/${totalRules}`
    }

    function setMessage(text: string, type: 'muted' | 'warning' | 'error' | 'success') {
      messageEl.textContent = text

      const textColorMap: Record<string, string> = {
        muted: 'text-muted-foreground',
        warning: 'text-warning',
        error: 'text-destructive',
        success: 'text-primary',
      }

      const borderColorMap: Record<string, string> = {
        muted: 'border-border',
        warning: 'border-warning',
        error: 'border-destructive',
        success: 'border-primary',
      }

      const allTextColors = Object.values(textColorMap)
      const allBorderColors = Object.values(borderColorMap)

      messageEl.classList.remove(...allTextColors)
      counterEl.classList.remove(...allTextColors)
      container.classList.remove(...allBorderColors)

      messageEl.classList.add(textColorMap[type])
      counterEl.classList.add(textColorMap[type])
      container.classList.add(borderColorMap[type])
    }

    passwordInput.addEventListener('input', validate)
    confirmInput.addEventListener('input', validate)
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-password-validator]').forEach(initValidator)
  })
</script>
