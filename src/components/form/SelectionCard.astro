---
import type { icons } from '@lucide/astro'
import type { HTMLAttributes } from 'astro/types'
import Icon from '../ui/Icon.astro'

interface Props extends HTMLAttributes<'input'> {
  name: string
  value: string
  label: string
  icon?: keyof typeof icons
  checked?: boolean
  type?: 'radio' | 'checkbox'
}

const { name, value, label, icon, checked = false, type = 'radio', ...rest }: Props = Astro.props
---

<label
  class="flex cursor-pointer items-start gap-3 rounded-main border-2 border-slate-100 bg-white p-4 text-slate-300 shadow-sm transition-all hover:border-indigo-200 has-checked:border-purple-light has-checked:bg-purple-light/10 has-checked:text-purple-light has-checked:*:text-purple-light"
>
  {icon && <Icon name={icon} size={24} />}
  <span class="flex-1 text-sm font-medium text-gray-900">{label}</span>
  <input type={type} name={name} value={value} class:list={['accent-purple-light', rest.class]} checked={checked} {...rest} />
</label>
