---
import type { icons } from '@lucide/astro'
import type { HTMLAttributes } from 'astro/types'
import Icon from '../ui/Icon.astro'

interface Props extends HTMLAttributes<'input'> {
  name: string
  value: string
  label: string
  icon?: keyof typeof icons
  checked?: boolean
  type?: 'radio' | 'checkbox'
}

const { name, value, label, icon, checked = false, type = 'radio', ...rest }: Props = Astro.props
---

<label class="flex cursor-pointer items-start gap-3 rounded-main border border-border bg-background p-4 text-heading transition-all has-checked:border-primary">
  {icon && <Icon name={icon} stroke-width={1.5} size={18} />}
  <span class="block flex-1 text-sm font-medium text-heading">{label}</span>
  <input type={type} name={name} value={value} class:list={['accent-primary', rest.class]} checked={checked} {...rest} />
</label>
