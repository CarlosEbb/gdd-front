---
import type { icons } from '@lucide/astro'
import type { HTMLAttributes } from 'astro/types'
import Icon from '../ui/Icon.astro'

interface Props extends HTMLAttributes<'input'> {
  name: string
  value: string
  label: string
  icon?: keyof typeof icons
  checked?: boolean
  type?: 'radio' | 'checkbox'
}

const { name, value, label, icon, checked = false, type = 'radio', ...rest }: Props = Astro.props
---

<label
  class="flex cursor-pointer items-start gap-3 rounded-main border-2 border-slate-100 bg-white p-4 text-slate-300 shadow-sm transition-all hover:border-indigo-200 has-checked:border-primary has-checked:bg-primary-foreground has-checked:text-primary has-checked:*:text-primary"
>
  {icon && <Icon name={icon} size={24} />}
  <span class="flex-1 text-sm font-medium text-heading">{label}</span>
  <input type={type} name={name} value={value} class:list={['accent-primary', rest.class]} checked={checked} {...rest} />
</label>
