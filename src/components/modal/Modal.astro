---
interface Props {
  modalId: string
  title: string
}

const { modalId, title } = Astro.props
---

<dialog id={modalId} class="modal-dialog">
  <div class="modal-content">
    <header class="modal-header">
      <h2 class="modal-title">{title}</h2>

      <form method="dialog">
        <button class="modal-close-btn" aria-label="Cerrar ventana modal">&times;</button>
      </form>
    </header>

    <div class="modal-body">
      <slot />
    </div>

    {
      Astro.slots.has('footer') && (
        <footer class="modal-footer">
          <slot name="footer" />
        </footer>
      )
    }
  </div>
</dialog>

<script>
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement

    const closeButton = target.closest('[data-close-modal]')
    if (closeButton) {
      const modal = closeButton.closest('dialog')
      if (modal) {
        modal.close()
      }
      return
    }

    if (target instanceof HTMLDialogElement && target.classList.contains('modal-dialog')) {
      target.close()
    }
  })
</script>

<style>
  dialog.modal-dialog {
    border: 1px solid oklch(0.922 0 0);
    padding: 0;
    border-radius: 12px;
    box-shadow:
      0 4px 6px -1px rgb(0 0 0 / 0.1),
      0 2px 4px -2px rgb(0 0 0 / 0.1);
    max-width: 500px;
    width: 90vw;
    margin: 0;
    position: fixed;
    top: 50%;
    left: 50%;
    max-height: 90vh;
    overflow: hidden;

    /* Estado cerrado (fade-out) */
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.9);

    transition:
      opacity 0.3s ease,
      transform 0.3s ease,
      display 0.3s allow-discrete,
      overlay 0.3s allow-discrete;
  }

  dialog.modal-dialog[open] {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  /* Estado inicial al abrirse (fade-in desde) */
  @starting-style {
    dialog.modal-dialog[open] {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.9);
    }
  }

  dialog.modal-dialog::backdrop {
    background: rgba(253, 247, 247, 0.5);
    backdrop-filter: blur(4px);
    opacity: 0;

    transition:
      opacity 0.3s ease,
      backdrop-filter 0.3s ease,
      display 0.3s allow-discrete,
      overlay 0.3s allow-discrete;
  }

  dialog.modal-dialog[open]::backdrop {
    opacity: 1;
  }

  @starting-style {
    dialog.modal-dialog[open]::backdrop {
      opacity: 0;
    }
  }

  /* Estilos para el contenido interno */
  .modal-content {
    display: flex;
    flex-direction: column;
    max-height: 90vh;
    overflow: hidden;
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid oklch(0.922 0 0);
    background-color: #fafafa;
    flex-shrink: 0;
  }

  .modal-title {
    margin: 0;
    font-size: 1.25rem;
  }

  .modal-close-btn {
    background: none;
    border: none;
    font-size: 2rem;
    line-height: 1;
    padding: 0;
    cursor: pointer;
    color: #888;
  }
  .modal-close-btn:hover {
    color: #000;
  }

  .modal-body {
    padding: 1rem 1.5rem 1.5rem;
    overflow-y: auto;
    flex: 1 1 auto;
    min-height: 0;
  }

  .modal-footer {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.5rem;
    border-top: 1px solid oklch(0.922 0 0);
    background-color: #fafafa;
    flex-shrink: 0;
  }
</style>
