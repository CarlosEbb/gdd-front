---
import Modal from './Modal.astro'
import Select from '../form/Select.astro'
import Input from '../form/Input.astro'
import Button from '../ui/Button.astro'
import Icon from '../ui/Icon.astro'
import { MARGIN_PRESETS, ORIENTATION, PAPER_SIZES } from '@/constants/file-settings'

const workspaces = (await Astro.session?.get('workspaces')) || []
---

<Modal modalId="save-template" title="Crear documento">
  <form class="space-y-4" id="save-template-form">
    <div>
      <Select
        label="Espacio de trabajo"
        name="uuid_workspace"
        placeholder="Seleccione un espacio de trabajo"
        options={workspaces.map((workspace) => ({ value: workspace.uuid, label: workspace.name }))}
        required
      />
    </div>

    <div>
      <Input label="Nombre" name="title" placeholder="Ingrese el nombre del documento" required />
    </div>

    <div>
      <Input label="Descripción" name="description" placeholder="Ingrese la descripción del documento" required />
    </div>

    <button
      type="button"
      id="toggle-generate-with-ia"
      class="flex w-full cursor-pointer items-center justify-between gap-2 rounded-lg border border-custom-blue3 bg-custom-blue3/10 px-4 py-3 text-left transition-all hover:shadow-md"
    >
      <div class="flex items-center gap-2">
        <Icon name="Sparkles" class="size-5 text-gray-600" stroke-width={1.5} />
        <span class="text-sm font-medium text-gray-700">Generar con IA</span>
        <span class="rounded border border-yellow-300 bg-yellow-100 px-2 py-1 text-xs text-gray-700">Funcionalidad experimental</span>
      </div>
      <Icon name="ChevronDown" class="size-5 text-gray-500 transition-transform duration-200" id="toggle-ia-icon" stroke-width={1.5} />
    </button>

    <div class="-mt-4 grid grid-rows-[0fr] opacity-0 transition-all duration-300 ease-in-out" id="prompt-container">
      <div class="-mx-1 overflow-hidden px-1 pt-1">
        <Input label="Crear documento con IA" name="prompt" placeholder="Genera un documento sobre..." />
        <p class="text-sm text-gray-500">Ingrese el prompt para crear el documento con IA.</p>
      </div>
    </div>

    <button
      type="button"
      id="toggle-document-settings"
      class="flex w-full cursor-pointer items-center justify-between gap-2 rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 text-left transition-all hover:bg-gray-100"
    >
      <div class="flex items-center gap-2">
        <Icon name="Settings" class="size-5 text-gray-600" stroke-width={1.5} />
        <span class="text-sm font-medium text-gray-700">Configuraciones del documento</span>
      </div>
      <Icon name="ChevronDown" class="size-5 text-gray-500 transition-transform duration-200" id="toggle-icon" stroke-width={1.5} />
    </button>

    <div class="-mt-4 grid grid-rows-[0fr] opacity-0 transition-all duration-300 ease-in-out" id="document-settings-container">
      <div class="-mx-1 space-y-4 overflow-hidden px-1 pt-1">
        <div>
          <Select label="Tamaño de papel" value={PAPER_SIZES[0]} name="pageSize" placeholder="Seleccione el tamaño de papel" options={PAPER_SIZES.map((size) => ({ value: size, label: size }))} />
        </div>

        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
          <div>
            <Select label="Margen" name="marginType" placeholder="Seleccione un margen" options={MARGIN_PRESETS.map((margin) => ({ value: margin, label: margin }))} value={MARGIN_PRESETS[1]} />
          </div>

          <div>
            <Select
              label="Orientación"
              name="orientation"
              placeholder="Seleccione una orientación"
              value={ORIENTATION[0]}
              options={ORIENTATION.map((orientation) => ({ value: orientation, label: orientation === 'PORTRAIT' ? 'Vertical' : 'Horizontal' }))}
            />
          </div>
        </div>
      </div>
    </div>

    <div class="flex justify-end space-x-4 border-t border-gray-200 pt-4">
      <Button type="button" size="sm" variant="outline" data-close-modal>Cancelar</Button>
      <Button type="submit" size="sm" id="btn-save-template" loadingText="Creando documento...">Crear documento</Button>
    </div>
  </form>
</Modal>

<script>
  import { actions } from 'astro:actions'
  import { navigate } from 'astro:transitions/client'
  import { callAction, setButtonLoading } from '@/scripts/utils'
  import { toast } from '@/scripts/toast'

  function initializeCreateDocumentModal() {
    const modalSaveTemplate = document.getElementById('save-template') as HTMLDialogElement
    const form = document.getElementById('save-template-form') as HTMLFormElement
    const toggleGenerateWithIA = document.getElementById('toggle-generate-with-ia') as HTMLButtonElement
    const promptContainer = document.getElementById('prompt-container') as HTMLDivElement
    const toggleIaIcon = document.getElementById('toggle-ia-icon') as HTMLElement
    const toggleDocumentSettings = document.getElementById('toggle-document-settings') as HTMLButtonElement
    const documentSettingsContainer = document.getElementById('document-settings-container') as HTMLDivElement
    const toggleIcon = document.getElementById('toggle-icon') as HTMLElement

    if (!form) return

    const handleToggleDocumentSettings = () => {
      const isExpanded = documentSettingsContainer.classList.contains('grid-rows-[1fr]')
      if (isExpanded) {
        documentSettingsContainer.classList.remove('grid-rows-[1fr]', 'opacity-100', 'mt-4')
        documentSettingsContainer.classList.add('grid-rows-[0fr]', 'opacity-0', '-mt-4')
        toggleIcon.classList.remove('rotate-180')
      } else {
        documentSettingsContainer.classList.remove('grid-rows-[0fr]', 'opacity-0', '-mt-4')
        documentSettingsContainer.classList.add('grid-rows-[1fr]', 'opacity-100', 'mt-4')
        toggleIcon.classList.add('rotate-180')
      }
    }

    toggleDocumentSettings.addEventListener('click', handleToggleDocumentSettings)

    const handleSaveTemplate = async (e: Event) => {
      e.preventDefault()

      const formData = new FormData(form)
      const name = (formData.get('title') as string)
        .toLowerCase()
        .replace(/ /g, '_')
        .replace(/[^a-z0-9_]/g, '')
      formData.append('name', name)

      try {
        setButtonLoading('#btn-save-template', true)
        const { data, error } = await callAction(actions.documents.createTemplate(formData))

        if (error) {
          toast.error(error.message)
          setButtonLoading('#btn-save-template', false)
          return
        }

        toast.success(data.message)
        navigate(`/editor/${data.data.template.uuid}?build_number=${data.data.version.build_number}&id_workspace=${data.data.template.id_workspace}&name_document=${data.data.template.title}`)
        modalSaveTemplate.close()
      } catch (error: unknown) {
        if (error instanceof Error) {
          toast.error(error.message)
        } else {
          toast.error('Error al guardar la plantilla')
        }
        modalSaveTemplate.close()
      } finally {
        setButtonLoading('#btn-save-template', false)
      }
    }

    const handleToggleGenerateWithIA = () => {
      const promptInput = form.querySelector('input[name="prompt"]') as HTMLInputElement
      const isExpanded = promptContainer.classList.contains('grid-rows-[1fr]')

      if (isExpanded) {
        promptContainer.classList.remove('grid-rows-[1fr]', 'opacity-100', 'mt-4')
        promptContainer.classList.add('grid-rows-[0fr]', 'opacity-0', '-mt-4')
        toggleIaIcon.classList.remove('rotate-180')
        promptInput?.removeAttribute('name')
      } else {
        promptContainer.classList.remove('grid-rows-[0fr]', 'opacity-0', '-mt-4')
        promptContainer.classList.add('grid-rows-[1fr]', 'opacity-100', 'mt-4')
        toggleIaIcon.classList.add('rotate-180')
        promptInput?.setAttribute('name', 'prompt')
      }
    }

    toggleGenerateWithIA.addEventListener('click', handleToggleGenerateWithIA)
    toggleDocumentSettings.addEventListener('click', handleToggleDocumentSettings)

    form.addEventListener('submit', handleSaveTemplate)
  }

  document.addEventListener('astro:page-load', () => {
    initializeCreateDocumentModal()
  })
</script>
