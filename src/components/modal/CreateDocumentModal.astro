---
import Modal from './Modal.astro'
import Select from '../form/Select.astro'
import Input from '../form/Input.astro'
import Button from '../ui/Button.astro'
import Icon from '../ui/Icon.astro'
import SelectionCard from '../form/SelectionCard.astro'
import { PAPER_SIZES, ORIENTATION, MARGIN_PRESETS } from '@/constants/file-settings'

const workspaces = await Astro.session?.get('workspaces')

const mapperWorkspaces = workspaces?.map((workspace) => ({ value: workspace.uuid, label: workspace.name })) || []
const showWarningFromServer = workspaces !== undefined && workspaces.length === 0
---

<Modal modalId="save-template" title="Crear documento">
  <form class="space-y-4" id="save-template-form">
    <input type="hidden" name="uuidBaseTemplate" value="" />
    <div>
      <p class:list={['text-sm text-warning', { hidden: !showWarningFromServer }]} id="no-workspaces-warning">No tienes espacios de trabajo disponibles</p>
      <Select
        id="select-workspace"
        disabled={mapperWorkspaces.length === 0}
        label="Espacio de trabajo"
        name="uuid_workspace"
        placeholder="Seleccione un espacio de trabajo"
        options={mapperWorkspaces}
        required
        data-error-required="Seleccione un espacio de trabajo"
      />
    </div>

    <div>
      <Input label="Nombre" name="title" placeholder="Carta de presentación" required data-error-required="Ingrese un nombre para el documento" />
    </div>

    <div>
      <Input label="Descripción" name="description" placeholder="Una descripción breve del documento" required />
    </div>

    <div>
      <input type="checkbox" name="generate_with_ai" id="generate_with_ai" class="hidden" />
      <button type="button" class="flex w-full cursor-pointer items-center justify-between border-b border-border pb-1.5" id="generate-with-ai-toggle">
        <h3 class="flex items-center gap-2 text-sm font-semibold text-subheading">
          <Icon class="text-primary" name="Sparkles" size={18} />
          Crear documento con IA
        </h3>
        <Icon class="text-subheading transition-transform duration-200" name="ChevronDown" size={20} stroke-width={1.5} id="generate-with-ai-icon" />
      </button>
      <div class="mt-2 grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-in-out" id="prompt-container">
        <div class="overflow-hidden rounded-main bg-foreground p-0 shadow-sm transition-[padding] duration-300 ease-in-out" id="prompt-inner">
          <label for="prompt" class="block text-sm font-medium text-heading">Describe el documento que deseas generar</label>
          <textarea name="prompt" placeholder="Crea un documento sobre..." class="field-sizing-content w-full rounded-main border border-border bg-background p-2"></textarea>
          <p class="text-sm text-subheading">Ingrese el prompt para crear el documento con IA.</p>
        </div>
      </div>
    </div>

    <div>
      <button type="button" class="flex w-full cursor-pointer items-center justify-between border-b border-border pb-1.5" id="page-settings-toggle">
        <h3 class="text-sm font-semibold text-subheading">Configuración de página</h3>
        <Icon class="text-subheading transition-transform duration-200" name="ChevronDown" size={20} stroke-width={1.5} id="page-settings-icon" />
      </button>
      <div class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-in-out" id="page-settings-content">
        <div class="overflow-hidden p-1">
          <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            <div>
              <Select
                label="Tamaño de papel"
                name="pageSize"
                placeholder="Seleccione un tamaño de papel"
                options={PAPER_SIZES.map((size) => ({ value: size, label: size }))}
                value={PAPER_SIZES[0]}
                required
              />
            </div>

            <div>
              <Select
                label="Margen"
                name="marginType"
                placeholder="Seleccione un margen"
                options={MARGIN_PRESETS.map((margin) => ({ value: margin, label: margin }))}
                value={MARGIN_PRESETS[1]}
                required
              />
            </div>

            <div class="md:col-span-2">
              <span class="mb-1 block text-sm font-medium text-heading">Orientación</span>
              <div class="grid grid-cols-2 gap-4">
                {
                  ORIENTATION.map((orientation) => (
                    <SelectionCard
                      name="orientation"
                      value={orientation}
                      label={orientation === 'PORTRAIT' ? 'Vertical' : 'Horizontal'}
                      icon={orientation === 'PORTRAIT' ? 'File' : 'StickyNote'}
                      checked={orientation === 'PORTRAIT'}
                    />
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </form>

  <div slot="footer">
    <Button type="button" size="sm" variant="outline" data-close-modal>Cancelar</Button>
    <Button type="submit" size="sm" form="save-template-form" id="btn-save-template" icon="Plus" loadingText="Creando documento...">Crear documento</Button>
  </div>
</Modal>

<script>
  import { actions } from 'astro:actions'
  import { navigate } from 'astro:transitions/client'
  import { callAction, setButtonLoading } from '@/scripts/utils'
  import { toast } from '@/scripts/toast'

  function initializeCreateDocumentModal() {
    const modalSaveTemplate = document.getElementById('save-template') as HTMLDialogElement
    const form = document.getElementById('save-template-form') as HTMLFormElement
    const btnGenerateWithIA = document.getElementById('generate_with_ai') as HTMLInputElement
    const generateWithAIToggle = document.getElementById('generate-with-ai-toggle') as HTMLButtonElement
    const generateWithAIIcon = document.getElementById('generate-with-ai-icon') as HTMLElement
    const promptContainer = document.getElementById('prompt-container') as HTMLDivElement
    const pageSettingsToggle = document.getElementById('page-settings-toggle') as HTMLButtonElement
    const pageSettingsContent = document.getElementById('page-settings-content') as HTMLDivElement
    const pageSettingsIcon = document.getElementById('page-settings-icon') as HTMLElement

    if (!form) return

    pageSettingsToggle?.addEventListener('click', () => {
      const isOpen = pageSettingsContent.classList.toggle('grid-rows-[1fr]')
      pageSettingsContent.classList.toggle('grid-rows-[0fr]', !isOpen)
      pageSettingsIcon.classList.toggle('rotate-180')
    })

    const handleSaveTemplate = async (e: Event) => {
      e.preventDefault()

      const formData = new FormData(form)
      const name = (formData.get('title') as string)
        .toLowerCase()
        .replace(/ /g, '_')
        .replace(/[^a-z0-9_]/g, '')
      formData.append('name', name)

      try {
        setButtonLoading('#btn-save-template', true)
        const { data, error } = await callAction(actions.documents.createTemplate(formData))

        if (error) {
          toast.error(error.message)
          setButtonLoading('#btn-save-template', false)
          return
        }

        toast.success(data.message)
        const editorUrl = new URL(`/editor/${data.data.template.uuid}`, window.location.origin)
        editorUrl.searchParams.set('build_number', String(data.data.lastVersion?.buildNumber))
        editorUrl.searchParams.set('id_workspace', data.data.template.uuidWorkspace)
        editorUrl.searchParams.set('name_document', data.data.template.title)
        navigate(editorUrl.pathname + editorUrl.search)
        modalSaveTemplate.close()
      } catch (error: unknown) {
        if (error instanceof Error) {
          toast.error(error.message)
        } else {
          toast.error('Error al guardar la plantilla')
        }
        modalSaveTemplate.close()
      } finally {
        setButtonLoading('#btn-save-template', false)
      }
    }

    const handleGenerateWithIA = () => {
      btnGenerateWithIA.checked = !btnGenerateWithIA.checked
      const promptTextarea = form.querySelector('textarea[name="prompt"]') as HTMLTextAreaElement
      const isOpen = promptContainer.classList.toggle('grid-rows-[1fr]')
      promptContainer.classList.toggle('grid-rows-[0fr]', !isOpen)
      generateWithAIIcon.classList.toggle('rotate-180')
      const promptInner = document.getElementById('prompt-inner') as HTMLDivElement
      if (isOpen) {
        promptInner.classList.add('p-4')
        promptInner.classList.remove('p-0')
      } else {
        promptInner.classList.remove('p-4')
        promptInner.classList.add('p-0')
      }

      const action = btnGenerateWithIA.checked ? 'setAttribute' : 'removeAttribute'
      promptTextarea[action]('name', 'prompt')
    }

    generateWithAIToggle.addEventListener('click', handleGenerateWithIA)

    const checkAndLoadWorkspaces = async () => {
      const selectWorkspace = document.getElementById('select-workspace') as HTMLSelectElement | null
      const warningText = document.getElementById('no-workspaces-warning') as HTMLParagraphElement | null

      if (!selectWorkspace) return

      const optionsCount = Array.from(selectWorkspace.options).filter((opt) => opt.value !== '').length
      if (optionsCount > 0) return

      const placeholderOption = selectWorkspace.querySelector('option[value=""]') as HTMLOptionElement | null
      const originalPlaceholder = placeholderOption?.textContent || 'Seleccione un espacio de trabajo'

      try {
        if (placeholderOption) {
          placeholderOption.textContent = 'Cargando espacios de trabajo...'
        }

        const { data, error } = await callAction(actions.workspaces.list())

        if (error || !data || !Array.isArray(data.data)) {
          placeholderOption!.textContent = 'Error al cargar espacios de trabajo'
          return
        }

        selectWorkspace.innerHTML = ''
        const newPlaceholder = document.createElement('option')
        newPlaceholder.value = ''
        newPlaceholder.disabled = true
        newPlaceholder.selected = true
        newPlaceholder.textContent = originalPlaceholder
        selectWorkspace.add(newPlaceholder)

        const workspacesList = data.data
        if (workspacesList.length === 0) {
          selectWorkspace.disabled = true
          warningText?.classList.remove('hidden')
          return
        }

        workspacesList.forEach((workspace: any) => {
          const opt = document.createElement('option')
          opt.value = workspace.uuid
          opt.textContent = workspace.name
          selectWorkspace.add(opt)
        })

        selectWorkspace.disabled = false
        warningText?.classList.add('hidden')
      } catch (error) {
        console.error('Error al cargar espacios de trabajo:', error)
        placeholderOption!.textContent = 'Error al cargar espacios de trabajo'
      }
    }

    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.type === 'attributes' && mutation.attributeName === 'open') {
          if (modalSaveTemplate.hasAttribute('open')) {
            checkAndLoadWorkspaces()
          }
        }
      })
    })

    if (modalSaveTemplate) {
      observer.observe(modalSaveTemplate, { attributes: true })
    }

    form.addEventListener('submit', handleSaveTemplate)
  }

  document.addEventListener('astro:page-load', () => {
    initializeCreateDocumentModal()
  })
</script>
