---
import Button from './Button.astro'
import Icon from './Icon.astro'

interface Props {
  title: string
  backHref?: string
  class?: string
  showBackButton?: boolean
}

const { title, class: className, backHref = undefined, showBackButton = true } = Astro.props
---

<div class="mb-6 flex items-center gap-4">
  {
    showBackButton && (
      <Button type="button" data-history-back data-fallback-href={backHref} variant="ghost" title="Volver a la página anterior" size="sm" aria-label="Volver a la página anterior">
        <Icon name="ArrowLeft" size={20} />
      </Button>
    )
  }

  <h1 class="text-2xl font-bold text-gray-900 md:text-3xl" class:list={[className]} transition:animate="fade" transition:name="title">
    {title}
  </h1>
</div>

<script>
  import { navigate } from 'astro:transitions/client'

  const w = window as typeof window & { __titleForPageBackInitialized?: boolean }

  if (!w.__titleForPageBackInitialized) {
    w.__titleForPageBackInitialized = true

    document.addEventListener('click', (event) => {
      const target = event.target
      if (!(target instanceof Element)) return

      const button = target.closest('[data-history-back]')
      if (!(button instanceof HTMLButtonElement)) return

      const fallbackHref = button.dataset.fallbackHref
      if (fallbackHref) {
        navigate(fallbackHref)
        return
      }

      if (window.history.length > 1) {
        window.history.back()
        return
      }

      navigate('/')
    })
  }
</script>
