---
import { icons } from '@lucide/astro'
import type { Document } from '@/types/documents'
import { formatShortDate } from '@/scripts/utils'
import Icon from './Icon.astro'
import Avatar from './Avatar.astro'
import CardList from './CardList.astro'

interface Props {
  document: Document
}

const ACTIONS = [
  {
    name: 'Documentación',
    icon: 'FileCode',
    action: 'view-documentation',
  },
  {
    name: 'Visualizar',
    icon: 'FileText',
    action: 'view',
  },
  {
    name: 'Documentos generados',
    icon: 'ListTree',
    action: 'generated',
  },
  {
    name: 'Duplicar',
    icon: 'Copy',
    action: 'duplicate',
  },
  {
    name: 'Crear plantilla',
    icon: 'FilePlusCorner',
    action: 'template',
  },
]

const { document } = Astro.props

const { uuid, lastVersion, uuidWorkspace, title, updatedAt, description, owner, workspace } = document
const { pathThumbnails = null, buildNumber, nameVersion = '', uuid: uuidVersion } = lastVersion || {}
const { name: autor, photo } = owner

const url = `/editor/${uuid}?build_number=${buildNumber}&id_workspace=${uuidWorkspace}&name_document=${title}`
---

<CardList
  title={title}
  description={description}
  secondaryText={formatShortDate(updatedAt)}
  img={pathThumbnails}
  class="document-list-item group cursor-pointer hover:bg-foreground"
  data-url={url}
  data-title={title}
  data-created-at={updatedAt}
  data-workspace-id={uuidWorkspace}
  data-uuid={uuid}
  data-name-version={nameVersion}
  data-build-number={buildNumber}
  data-uuid-version={uuidVersion}
  data-name-workspace={workspace?.name || ''}
>
  <div slot="actions" class="flex items-center gap-2">
    <div class="hidden items-center gap-2 sm:flex">
      {
        workspace && (
          <div class="flex max-w-[120px] min-w-0 items-center gap-x-2 rounded-main border border-primary bg-background px-1 py-0.5">
            <Icon name={workspace.icon as keyof typeof icons} stroke-width={1.5} class="size-2.5 shrink-0 text-primary" />
            <p class="truncate text-[11px] text-primary">{workspace.name}</p>
          </div>
        )
      }
      <div class="flex items-center">
        <Avatar size="xs" name={autor} photo={photo} />
        <p class="ml-2 line-clamp-1 max-w-[140px] text-xs text-heading">{autor}</p>
      </div>
    </div>

    <div class="relative">
      <button class="flex size-8 items-center justify-center rounded-main text-heading transition-colors duration-150 hover:bg-muted" data-btn-dropdown aria-label="Acciones del documento">
        <Icon name="EllipsisVertical" stroke-width={1.5} size={18} />
      </button>

      <div
        class="invisible absolute top-full right-0 z-20 mt-1 w-56 origin-top-right scale-95 transform rounded-main border border-border bg-background p-2 opacity-0 shadow-base transition-all duration-150 ease-out [&.is-open]:visible [&.is-open]:scale-100 [&.is-open]:opacity-100"
        data-card-dropdown
      >
        <div class="py-1">
          {
            ACTIONS.map((action) => (
              <button class="flex w-full items-center gap-x-2 rounded-main px-3 py-2 text-sm text-heading transition-colors duration-150 hover:bg-muted" data-action={action.action}>
                <Icon name={action.icon as keyof typeof icons} stroke-width={1.5} class="size-4" />
                {action.name}
              </button>
            ))
          }
          <button class="flex w-full items-center gap-x-2 rounded-main px-3 py-2 text-sm text-red-600 transition-colors duration-150 hover:bg-red-500/20" data-action="delete">
            <Icon name="Trash2" stroke-width={1.5} class="size-3" />
            <span>Eliminar</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</CardList>

<script>
  import { initDocumentCardActions } from '@/scripts/document-card-actions'

  initDocumentCardActions()
  document.addEventListener('astro:page-load', initDocumentCardActions)
</script>
