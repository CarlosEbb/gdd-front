---
import Modal from '../modal/Modal.astro'
import EmptyState from './EmptyState.astro'
import Icon from './Icon.astro'
import { FileText } from '@lucide/astro'
import { actions } from 'astro:actions'

type Size = 'xs' | 'sm' | 'full'

interface Props {
  size?: Size
  class?: string
}

const { size = 'full', class: className = '' } = Astro.props

const { data } = await Astro.callAction(actions.documents.getByUser, { limit: null })
const documents = data?.data ?? []

const sizeClasses: Record<Size, string> = {
  xs: 'h-9 w-9 justify-center px-0 py-0',
  sm: 'h-9 w-56 justify-between px-3 py-1',
  full: 'h-full w-full justify-between px-4 py-1',
}
---

<button
  type="button"
  id="search-trigger"
  data-open-modal="search-modal"
  class:list={[
    'flex cursor-pointer items-center gap-3 rounded-main border border-border bg-background text-left text-sm transition-colors hover:bg-muted focus:ring-1 focus:ring-primary focus:outline-none',
    sizeClasses[size],
    className,
  ]}
  aria-label="Abrir buscador de documentos"
>
  <span class="flex min-w-0 items-center gap-3">
    <Icon name="Search" class="shrink-0 text-subheading" stroke-width={1.5} size={16} />
    {size !== 'xs' && <span class="truncate text-subheading">{size === 'sm' ? 'Buscar...' : 'Buscar documentos...'}</span>}
  </span>

  {(size === 'full' || size === 'sm') && <span class="hidden shrink-0 rounded-[calc(var(--radius)-2px)] border border-border bg-muted px-2 py-1 text-xs text-subheading md:inline-flex">Ctrl + K</span>}
</button>

<Modal modalId="search-modal" title="Buscar documentos">
  <div class="flex h-96 flex-col" id="search-container">
    <div class="relative">
      <div class="pointer-events-none absolute inset-y-0 inset-s-0 z-10 flex items-center ps-4 text-subheading">
        <Icon name="Search" stroke-width={1.5} size={16} />
      </div>
      <input
        type="search"
        id="input-search"
        class="h-full w-full rounded-main border border-border bg-background p-2 ps-11 text-sm text-heading placeholder:text-subheading focus:ring-1 focus:ring-primary focus:outline-none"
        placeholder="Buscar documentos..."
        autocomplete="off"
        autofocus
      />
    </div>

    <div id="search-results" class="mt-3 flex min-h-0 flex-1 flex-col overflow-hidden">
      <div id="results-list" class="hidden min-h-0 flex-1 overflow-y-auto">
        <!-- Los resultados se insertarán aquí dinámicamente -->
      </div>
      <div id="no-results" class="flex min-h-0 flex-1 items-center justify-center px-4 py-8 text-center text-subheading">
        <div id="search-empty-idle" class="w-full">
          <EmptyState title="Escribe para buscar documentos" description="Los resultados aparecerán aquí al instante." state="info" hiddenAction showBorder={false} />
        </div>
        <div id="search-empty-no-match" class="hidden w-full">
          <EmptyState title="No se encontraron documentos" description="Prueba con otro título o descripción." state="notFound" hiddenAction showBorder={false} />
        </div>
      </div>
    </div>
  </div>

  <div slot="footer" class="w-full">
    <p id="search-results-count" class="text-sm text-subheading">0 resultados</p>
  </div>
</Modal>

<template id="search-result-template">
  <a class="flex items-center gap-3 rounded-[calc(var(--radius)-2px)] px-3 py-3 transition-colors duration-150 hover:bg-foreground">
    <div class="flex size-9 shrink-0 items-center justify-center rounded-[calc(var(--radius)-2px)] bg-background text-primary">
      <FileText class="size-3 md:size-4" />
    </div>
    <div class="min-w-0 flex-1">
      <p class="truncate text-sm font-medium text-heading" data-title></p>
      <p class="truncate text-xs text-subheading" data-description></p>
    </div>
    <span class="hidden shrink-0 text-xs text-subheading md:block" data-date></span>
  </a>
</template>

<script type="application/json" id="search-documents-data" set:html={JSON.stringify(documents)} />

<script>
  import { formatDate } from '@/scripts/utils'
  import type { Document } from '@/types/documents'

  function initSearchComponent() {
    const dataScript = document.getElementById('search-documents-data')
    const documents: Document[] = dataScript ? JSON.parse(dataScript.textContent || '[]') : []

    const trigger = document.getElementById('search-trigger') as HTMLButtonElement | null
    const modal = document.getElementById('search-modal') as HTMLDialogElement | null
    const input = document.getElementById('input-search') as HTMLInputElement | null
    const resultsList = document.getElementById('results-list')
    const noResults = document.getElementById('no-results')
    const resultsCount = document.getElementById('search-results-count')
    const emptyIdle = document.getElementById('search-empty-idle')
    const emptyNoMatch = document.getElementById('search-empty-no-match')
    const searchContainer = document.getElementById('search-container')
    const template = document.getElementById('search-result-template') as HTMLTemplateElement | null

    if (!trigger || !modal || !input || !resultsList || !noResults || !resultsCount || !emptyIdle || !emptyNoMatch || !template || !searchContainer) return
    if (searchContainer.dataset.initialized === 'true') return
    searchContainer.dataset.initialized = 'true'

    const $trigger = trigger
    const $modal = modal
    const $input = input
    const $resultsList = resultsList
    const $noResults = noResults
    const $resultsCount = resultsCount
    const $emptyIdle = emptyIdle
    const $emptyNoMatch = emptyNoMatch
    const $template = template
    const $searchContainer = searchContainer

    function openSearchModal() {
      if (!$modal.open) {
        $modal.showModal()
      }

      window.requestAnimationFrame(() => {
        $input.focus()

        if ($input.value.trim() !== '') {
          filterDocuments($input.value)
        }
      })
    }

    function updateResultsCount(count: number) {
      $resultsCount.textContent = `${count} ${count === 1 ? 'resultado' : 'resultados'}`
    }

    function showIdleState() {
      $noResults.classList.remove('hidden')
      $emptyIdle.classList.remove('hidden')
      $emptyNoMatch.classList.add('hidden')
    }

    function showNoMatchState() {
      $noResults.classList.remove('hidden')
      $emptyIdle.classList.add('hidden')
      $emptyNoMatch.classList.remove('hidden')
    }

    function hideResults() {
      $resultsList.classList.add('hidden')
      $resultsList.innerHTML = ''
      showIdleState()
      updateResultsCount(0)
    }

    function createResultItem(doc: Document) {
      const clone = $template.content.cloneNode(true) as DocumentFragment
      const link = clone.querySelector('a')
      const title = clone.querySelector('[data-title]')
      const description = clone.querySelector('[data-description]')
      const date = clone.querySelector('[data-date]')

      if (link) link.href = `/editor/${doc.uuid}?build_number=${doc.lastVersion?.buildNumber || '1.00'}&id_workspace=${doc.uuidWorkspace}&name_document=${doc.title}`
      if (title) title.textContent = doc.title
      if (description) description.textContent = doc.description || 'Sin descripción'
      if (date) date.textContent = formatDate(doc.updatedAt)

      return clone
    }

    function renderResults(filteredDocs: Document[]) {
      $resultsList.innerHTML = ''
      updateResultsCount(filteredDocs.length)

      if (filteredDocs.length === 0) {
        $resultsList.classList.add('hidden')
        showNoMatchState()
      } else {
        $resultsList.classList.remove('hidden')
        $noResults.classList.add('hidden')

        const fragment = document.createDocumentFragment()
        filteredDocs.forEach((doc) => fragment.appendChild(createResultItem(doc)))
        $resultsList.appendChild(fragment)
      }
    }

    function filterDocuments(searchTerm: string) {
      const term = searchTerm.toLowerCase().trim()

      if (term === '') {
        hideResults()
        return
      }

      const filtered = documents.filter((doc) => doc.title.toLowerCase().includes(term) || (doc.description && doc.description.toLowerCase().includes(term)))

      renderResults(filtered)
    }

    $input.addEventListener('input', (e) => filterDocuments((e.target as HTMLInputElement).value))

    $input.addEventListener('focus', () => {
      if ($input.value.trim() !== '') {
        filterDocuments($input.value)
      }
    })

    if (document.body.dataset.searchShortcutInitialized !== 'true') {
      document.body.dataset.searchShortcutInitialized = 'true'

      document.addEventListener('keydown', (e: KeyboardEvent) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault()
          openSearchModal()
        }
      })
    }

    $trigger.addEventListener('click', openSearchModal)

    $modal.addEventListener('click', (e: MouseEvent) => {
      if (!$searchContainer.contains(e.target as Node)) {
        hideResults()
      }
    })

    $modal.addEventListener('close', () => {
      hideResults()
    })
  }

  document.addEventListener('astro:page-load', initSearchComponent)
</script>
