---
import Icon from './Icon.astro'

interface Props {
  title: string
  defaultOpen?: boolean
  titleClass?: string
}

const { title, defaultOpen = false, titleClass = 'text-base font-semibold text-heading' } = Astro.props
---

<details class="group border-x border-b border-border bg-background first:rounded-t-main first:border-t last:rounded-b-main" open={defaultOpen}>
  <summary class="flex cursor-pointer items-center gap-2 p-4 text-sm font-medium text-heading transition-colors select-none hover:bg-foreground">
    <span class={`flex-1 truncate ${titleClass}`}>{title}</span>
    <slot name="header" />
    <Icon name="ChevronDown" size={16} class="shrink-0 text-subheading transition-transform duration-200 group-open:rotate-180" />
  </summary>
  <div class="border-t border-border px-4 pt-3 pb-4">
    <slot />
  </div>
</details>
