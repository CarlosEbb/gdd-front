---
import { icons } from '@lucide/astro'
import type { Document } from '@/types/documents'
import template from '@/assets/images/preview/template-1.png'
import { formatShortDate } from '@/scripts/utils'
import Icon from './Icon.astro'
import Avatar from './Avatar.astro'
const { PUBLIC_PROJECT_URL } = import.meta.env

interface Props {
  document: Document
}

const ACTIONS = [
  {
    name: 'Documentación',
    icon: 'FileCode',
    action: 'view-documentation',
  },
  {
    name: 'Visualizar',
    icon: 'FileText',
    action: 'view',
  },
  {
    name: 'Documentos generados',
    icon: 'ListTree',
    action: 'generated',
  },
  {
    name: 'Duplicar',
    icon: 'Copy',
    action: 'duplicate',
  },
  {
    name: 'Crear plantilla',
    icon: 'FilePlusCorner',
    action: 'template',
  },
]

const { document } = Astro.props

const { uuid, lastVersion, uuidWorkspace, title, updatedAt, description, owner, workspace } = document
const { pathThumbnails = null, buildNumber, nameVersion, uuid: uuidVersion = '' } = lastVersion || {}
const { name: autor, photo } = owner

const thumbnails = pathThumbnails ? `${PUBLIC_PROJECT_URL}${pathThumbnails}` : template.src
const editorUrl = new URL(`/editor/${uuid}`, Astro.url)

editorUrl.searchParams.set('build_number', String(buildNumber))
editorUrl.searchParams.set('id_workspace', uuidWorkspace)
editorUrl.searchParams.set('name_document', title)

const url = editorUrl.pathname + editorUrl.search
---

<div
  class="document-card group flex cursor-pointer flex-col rounded-main border border-border bg-background transition-all duration-200 hover:shadow-base"
  data-url={url}
  data-title={title}
  data-created-at={updatedAt}
  data-workspace-id={uuidWorkspace}
  data-uuid={uuid}
  data-name-version={nameVersion}
  data-build-number={buildNumber}
  data-uuid-version={uuidVersion}
  data-name-workspace={workspace?.name || ''}
>
  <div class="overflow-hidden px-3 pt-3">
    <div class="relative flex h-48 w-full items-center justify-center overflow-hidden rounded-main bg-foreground">
      <div class="thumbnail-skeleton absolute inset-0 animate-pulse bg-muted"></div>
      <img
        src={thumbnails}
        class="thumbnail-img relative z-10 h-full w-full object-contain opacity-0 transition-opacity duration-200"
        alt={title}
        width="200"
        height="128"
        loading="lazy"
        decoding="async"
        onload="this.classList.remove('opacity-0'); this.previousElementSibling.classList.add('hidden')"
      />
    </div>
  </div>

  <div class="my-2 flex items-center justify-between space-x-2 px-3">
    {
      workspace && (
        <div class="flex max-w-[120px] min-w-0 items-center gap-x-2 rounded-main border border-primary bg-background px-1 py-0.5">
          <Icon name={workspace.icon as keyof typeof icons} stroke-width={1.5} class="size-2.5 shrink-0 text-primary" />
          <p class="truncate text-[11px] text-primary">{workspace.name}</p>
        </div>
      )
    }
    <div class="relative">
      <button class="flex size-6 items-center justify-center rounded-main text-heading transition-colors duration-150 hover:bg-foreground" data-btn-dropdown>
        <Icon name="EllipsisVertical" stroke-width={1.5} size={18} />
      </button>

      <div
        class="invisible absolute top-full right-0 z-20 mt-1 w-56 origin-top-right scale-95 transform rounded-main border border-border bg-background p-2 opacity-0 shadow-base transition-all duration-150 ease-out [&.is-open]:visible [&.is-open]:scale-100 [&.is-open]:opacity-100"
        data-card-dropdown
      >
        <div class="py-1">
          {
            ACTIONS.map((action) => (
              <button class="flex w-full items-center gap-x-2 rounded-main px-3 py-2 text-sm text-heading transition-colors duration-150 hover:bg-muted" data-action={action.action}>
                <Icon name={action.icon as keyof typeof icons} stroke-width={1.5} class="size-4" />
                {action.name}
              </button>
            ))
          }
          <button class="flex w-full items-center gap-x-2 rounded-main px-3 py-2 text-sm text-red-600 transition-colors duration-150 hover:bg-red-500/20" data-action="delete">
            <Icon name="Trash2" stroke-width={1.5} class="size-3" />
            <span>Eliminar</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="mb-2 px-3 pb-2">
    <div class="flex min-w-0 flex-1 items-center gap-x-2">
      <h3 class="truncate text-sm font-medium text-heading">{title}</h3>
    </div>
    {description && <p class="line-clamp-2 text-xs text-subheading">{description}</p>}
  </div>

  <div class="mt-auto rounded-b-main border-t border-border bg-foreground px-3 py-2">
    <div class="flex items-center justify-between">
      <div class="flex items-center">
        <Avatar size="xs" name={autor} photo={photo} />
        <p class="ml-2 line-clamp-1 text-xs text-heading">{autor}</p>
      </div>
      <p class="mt-0.5 rounded-main border border-border bg-muted px-2 py-1 text-[10px] text-subheading">{formatShortDate(updatedAt)}</p>
    </div>
  </div>
</div>

<script>
  import { initDocumentCardActions } from '@/scripts/document-card-actions'

  initDocumentCardActions()
  document.addEventListener('astro:page-load', initDocumentCardActions)
</script>
