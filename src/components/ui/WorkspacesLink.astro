---
import { formatISODateWithIntl } from '@/scripts/utils'
import Icon from '@/components/ui/Icon.astro'
import { icons } from '@lucide/astro'
import type { Workspace } from '@/types/workspaces'

type Props = {
  workspace: Workspace
  index: number
}
const GRADIENTS: Record<number, any> = {
  0: { gradientBg: 'to-purple-50 dark:to-purple-950/20 via-white dark:via-neutral-800 from-transparent', bgIcon: 'bg-purple-100', colorIcon: 'text-purple-600' },
  1: { gradientBg: 'to-blue-50 dark:to-blue-950/20 via-white dark:via-neutral-800 from-transparent', bgIcon: 'bg-blue-100', colorIcon: 'text-blue-600' },
  2: { gradientBg: 'to-red-50 dark:to-red-950/20 via-white dark:via-neutral-800 from-transparent', bgIcon: 'bg-red-100', colorIcon: 'text-red-600' },
  3: { gradientBg: 'to-green-50 dark:to-green-950/20 via-white dark:via-neutral-800 from-transparent', bgIcon: 'bg-green-100', colorIcon: 'text-green-600' },
}

const { workspace, index } = Astro.props
---

<a
  class={`group relative p-6 bg-background border border-border rounded-main cursor-pointer flex flex-col items-center text-center overflow-hidden space-y-3 bg-linear-to-t ${GRADIENTS[index % 4].gradientBg}`}
  href={`/workspaces/${workspace.uuid}`}
>
  <div>
    <Icon name={workspace.icon as keyof typeof icons} class={`size-10 ${GRADIENTS[index % 4].colorIcon}`} />
  </div>
  <div class="flex flex-col text-center">
    <span class="text-sm font-medium text-heading" transition:animate="fade" transition:name="title">{workspace.name}</span>
    <span class="text-xs text-subheading">{formatISODateWithIntl(workspace.updatedAt)}</span>
  </div>

  <div class="flex w-full items-center justify-between border-t border-border pt-4 text-xs font-bold text-subheading">
    <span>Documentos</span>
    <span class="text-heading">{workspace.templates?.length || 0}</span>
  </div>
</a>
