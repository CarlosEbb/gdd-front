---
import { formatISODateWithIntl } from '@/scripts/utils'
import Icon from '@/components/ui/Icon.astro'
import { icons } from '@lucide/astro'

interface Workspace {
  id: string
  name: string
  uuid: string
  icon: keyof typeof icons
  updatedAt: string
}

type Props = {
  workspace: Workspace
  index: number
}

const GRADIENTS: Record<number, any> = {
  0: { gradientBg: 'to-purple-50 via-white from-transparent', bgIcon: 'bg-purple-100', colorIcon: 'text-purple-600' },
  1: { gradientBg: 'to-blue-50 via-white from-transparent', bgIcon: 'bg-blue-100', colorIcon: 'text-blue-600' },
  2: { gradientBg: 'to-red-50 via-white from-transparent', bgIcon: 'bg-red-100', colorIcon: 'text-red-600' },
}

const { workspace, index } = Astro.props
---

<a
  class={`flex cursor-pointer items-center gap-2 rounded-lg border border-border p-4 md:p-3 text-center hover:shadow-base transition-all duration-300 bg-background bg-linear-to-tr ${GRADIENTS[index].gradientBg}`}
  href={`/workspaces/${workspace.uuid}`}
>
  <div class={`rounded-xl ${GRADIENTS[index].bgIcon} p-2`}>
    <Icon name={workspace.icon} class={`size-5 ${GRADIENTS[index].colorIcon}`} stroke-width={1.5} />
  </div>
  <div class="flex flex-col items-start justify-start">
    <span class="text-sm font-medium text-heading" transition:animate="fade" transition:name="title">{workspace.name}</span>
    <span class="text-xs text-subheading">{formatISODateWithIntl(workspace.updatedAt)}</span>
  </div>
</a>
