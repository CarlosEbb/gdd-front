---
import { icons } from '@lucide/astro'
import Icon from './Icon.astro'

interface Props {
  buttonLabel?: string
  withSearch?: boolean
  size?: 'default' | 'sm'
  shadow?: 'lg' | 'md' | 'sm' | 'none'
  border?: 'border' | 'none'
  position?: 'left' | 'right' | 'default'
  mobileIcon?: keyof typeof icons
  icon?: keyof typeof icons
  menuClass?: string
  hideLabel?: boolean
}

const {
  buttonLabel = 'Seleccionar',
  withSearch = false,
  size = 'default',
  shadow = 'base',
  border = 'border',
  position = 'default',
  mobileIcon = 'Menu',
  icon = undefined,
  menuClass = '',
  hideLabel = false,
} = Astro.props

const hasTriggerSlot = Astro.slots.has('trigger')

const sizeClasses = {
  default: 'h-10 px-2',
  sm: 'h-8 px-2',
}

const shadowClasses = {
  lg: 'shadow-lg',
  md: 'shadow-md',
  sm: 'shadow-sm',
  base: 'shadow-base',
  none: '',
}

const borderClasses = {
  border: 'border border-border',
  none: '',
}

const positionClasses = {
  left: 'md:left-0 md:right-auto',
  right: 'md:right-0 md:left-auto',
  default: 'md:left-0 md:right-auto',
}
---

<div class="relative inline-block w-full cursor-pointer text-left" data-dropdown-container>
  <div class="fixed inset-0 z-40 hidden bg-background/50 opacity-0 transition-opacity duration-300 in-[.is-open]:block in-[.is-open]:opacity-100 md:hidden!" data-dropdown-backdrop></div>
  <button
    class:list={[
      hasTriggerSlot
        ? 'inline-flex cursor-pointer items-center justify-center rounded-full bg-transparent p-0 text-subheading transition duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-foreground disabled:cursor-not-allowed disabled:opacity-50'
        : [
            'inline-flex w-full cursor-pointer items-center justify-between gap-x-1.5 rounded-main bg-background backdrop-blur-sm transition duration-200 focus:border-transparent focus:ring-2 focus:ring-primary-foreground focus:outline-none disabled:cursor-not-allowed disabled:bg-gray-100 disabled:opacity-50',
            sizeClasses[size],
            shadowClasses[shadow],
            borderClasses[border],
          ],
    ]}
    data-dropdown-toggle
  >
    {
      hasTriggerSlot ? (
        <slot name="trigger" />
      ) : (
        <>
          {mobileIcon && (
            <span class:list={['flex items-center justify-center', !hideLabel && 'md:hidden']}>
              <Icon name={mobileIcon} class="size-5 text-heading" />
            </span>
          )}
          {icon && (
            <span class:list={['flex items-center justify-center', mobileIcon && 'hidden md:flex']}>
              <Icon name={icon} class="size-4 text-heading" />
            </span>
          )}
          {!hideLabel && <span class:list={['truncate text-subheading', mobileIcon && 'hidden md:inline']}>{buttonLabel}</span>}
          {!hideLabel && (
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class:list={['-mr-1 ml-2 h-5 w-5 shrink-0 text-heading transition-transform duration-200 ease-in-out in-[.is-open]:rotate-180', mobileIcon && 'hidden md:block']}
            >
              <path d="m6 9 6 6 6-6" />
            </svg>
          )}
        </>
      )
    }
  </button>

  <div
    class:list={[
      'invisible fixed inset-x-0 bottom-0 z-50 flex max-h-[60vh] translate-y-full flex-col overflow-y-auto rounded-t-3xl bg-background opacity-0 shadow-[0_-8px_30px_rgba(0,0,0,0.12)] transition-all duration-300 ease-out focus:outline-none',
      '[&.is-open]:visible [&.is-open]:translate-y-0 [&.is-open]:opacity-100',
      'md:ring-opacity-5 md:absolute md:bottom-auto md:mt-1 md:block md:max-h-72 md:w-auto md:translate-y-0 md:scale-95 md:rounded-main md:shadow-lg md:ring-1 md:ring-border md:transition-all md:duration-150',
      'md:[&.is-open]:scale-100',
      positionClasses[position],
      position === 'right' ? 'md:origin-top-right' : 'md:origin-top-left',
      menuClass,
    ]}
    data-dropdown-menu
  >
    <div class="mx-auto mt-3 mb-2 h-1.5 w-12 shrink-0 rounded-full bg-gray-300 md:hidden"></div>
    {
      withSearch && (
        <div class="border-b border-border p-2">
          <input
            type="text"
            class="block w-full rounded-main border border-border bg-background/80 px-4 py-3 shadow-sm backdrop-blur-sm transition duration-200 placeholder:text-gray-400 focus:border-transparent focus:ring-2 focus:ring-primary-foreground focus:outline-none disabled:cursor-not-allowed disabled:bg-gray-100 disabled:opacity-50"
            placeholder="Buscar..."
            data-dropdown-search
          />
        </div>
      )
    }

    <div class="py-1" data-options-container>
      <slot />
    </div>
  </div>
</div>

<script>
  function initAstroDropdowns() {
    const dropdowns = document.querySelectorAll('[data-dropdown-container]')
    if (dropdowns.length === 0) return

    dropdowns.forEach((container) => {
      const toggleButton = container.querySelector('[data-dropdown-toggle]')
      const menu = container.querySelector('[data-dropdown-menu]')
      const searchInput = container.querySelector('[data-dropdown-search]') as HTMLInputElement
      const optionsContainer = container.querySelector('[data-options-container]') as HTMLElement

      if (!toggleButton || !menu || !optionsContainer) return

      toggleButton.addEventListener('click', (e) => {
        e.stopPropagation()
        const isOpen = menu.classList.toggle('is-open')
        container.classList.toggle('is-open', isOpen)

        if (isOpen && searchInput) {
          searchInput.focus()
        }
      })

      if (searchInput) {
        searchInput.addEventListener('click', (e) => e.stopPropagation())
        searchInput.addEventListener('input', () => {
          const filter = searchInput.value.toLowerCase()
          const items = Array.from(optionsContainer.children)
          items.forEach((item) => {
            const text = item.textContent?.toLowerCase() || ''
            if (text.includes(filter)) {
              ;(item as HTMLElement).style.display = ''
            } else {
              ;(item as HTMLElement).style.display = 'none'
            }
          })
        })
      }
    })
  }

  document.addEventListener('click', (e) => {
    document.querySelectorAll('[data-dropdown-menu].is-open').forEach((menu) => {
      const container = menu.closest('[data-dropdown-container]')
      const backdrop = container?.querySelector('[data-dropdown-backdrop]')

      if (container && (!container.contains(e.target as Node) || e.target === backdrop)) {
        menu.classList.remove('is-open')
        container.classList.remove('is-open')
      }
    })
  })

  document.addEventListener('astro:page-load', () => {
    initAstroDropdowns()
  })
</script>
