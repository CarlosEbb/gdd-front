---
import type { HTMLAttributes } from 'astro/types'
import EmptyState from './EmptyState.astro'

export interface TableColumn {
  key: string
  label: string
  align?: 'left' | 'center' | 'right'
}

export interface TableRow {
  [key: string]: unknown
  href?: string
}

interface Props extends HTMLAttributes<'div'> {
  columns: TableColumn[]
  rows: TableRow[]
  currentPage?: number
  totalPages?: number
  pageSize?: number
  showPagination?: boolean
  size?: 'fixed' | 'free'
  width?: string
  height?: number
}

const { columns, rows, currentPage = 1, totalPages = 1, pageSize = 10, showPagination = true, size = 'free', width, height, class: className, ...rest } = Astro.props

const isFixed = size === 'fixed'
const containerStyle = [width && `width: ${width};`, isFixed && height && `height: ${height}dvh;`].filter(Boolean).join(' ') || undefined

const alignClasses: Record<string, string> = {
  left: 'text-left',
  center: 'text-center',
  right: 'text-right',
}
---

<div class:list={['rounded-main border border-border bg-background', !isFixed && 'w-full overflow-hidden', isFixed && 'flex flex-col overflow-hidden', className]} style={containerStyle} {...rest}>
  <div class:list={[isFixed ? 'flex-1 overflow-auto' : 'w-full']}>
    <table class:list={['border-collapse', !isFixed && 'w-full', isFixed && 'w-full table-fixed']}>
      <thead>
        <tr class:list={['h-11 border-b border-border bg-foreground', isFixed && 'sticky top-0 z-10']}>
          {columns.map((col) => <th class:list={['px-4 py-3 text-sm font-medium tracking-wide whitespace-nowrap text-heading select-none', alignClasses[col.align || 'left']]}>{col.label}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          rows.length === 0 ? (
            <tr>
              <td colspan={columns.length}>
                <EmptyState title="Sin datos" description="No hay registros disponibles." state="info" hiddenAction showBorder={false} />
              </td>
            </tr>
          ) : (
            rows.map((row) => {
              return (
                <tr class:list={['h-11 border-b border-border transition-colors last:border-b-0', row.href && 'cursor-pointer hover:bg-foreground']}>
                  {columns.map((col, colIdx) => (
                    <td class:list={['px-4 py-3 text-sm text-heading', alignClasses[col.align || 'left']]}>
                      {row.href && colIdx === 0 ? (
                        <a href={row.href} class="hover:underline">
                          {row[col.key] as string}
                        </a>
                      ) : colIdx === columns.length - 1 && row.href ? (
                        <span class="flex items-center justify-between gap-2">
                          <span class={alignClasses[col.align || 'left']}>{row[col.key] as string}</span>
                          <a href={row.href} class="text-subheading hover:text-heading">
                            <svg
                              xmlns="http://www.w3.org/2000/svg"
                              width="16"
                              height="16"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            >
                              <path d="m9 18 6-6-6-6" />
                            </svg>
                          </a>
                        </span>
                      ) : (
                        (row[col.key] as string)
                      )}
                    </td>
                  ))}
                </tr>
              )
            })
          )
        }
      </tbody>
    </table>
  </div>

  {
    showPagination && (
      <div class:list={['flex items-center justify-between border-t border-border bg-foreground px-4 py-2', isFixed && 'sticky bottom-0 z-10']}>
        <div class="flex items-center gap-1 text-xs text-subheading">
          <span>Show {pageSize}</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </div>
        <div class="flex items-center gap-3 text-xs text-subheading">
          <span>
            {currentPage} of {totalPages}
          </span>
          <div class="flex items-center gap-1">
            <button
              class="flex h-6 w-6 items-center justify-center rounded border border-border text-subheading transition-colors hover:bg-foreground hover:text-heading disabled:opacity-40"
              disabled={currentPage <= 1}
              aria-label="Página anterior"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m15 18-6-6 6-6" />
              </svg>
            </button>
            <button
              class="flex h-6 w-6 items-center justify-center rounded border border-border text-subheading transition-colors hover:bg-foreground hover:text-heading disabled:opacity-40"
              disabled={currentPage >= totalPages}
              aria-label="Página siguiente"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m9 18 6-6-6-6" />
              </svg>
            </button>
          </div>
        </div>
      </div>
    )
  }
</div>
