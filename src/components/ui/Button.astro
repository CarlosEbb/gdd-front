---
import type { HTMLAttributes } from 'astro/types'
import Icon from './Icon.astro'
import { icons } from '@lucide/astro'

export interface Props extends HTMLAttributes<'button'> {
  variant?: 'default' | 'destructive' | 'outline' | 'secondary' | 'ghost' | 'gradient' | 'transparent'
  size?: 'default' | 'sm' | 'lg' | 'icon'
  rounded?: 'default' | 'full'
  loadingText?: string
  showTextOnLoading?: boolean
  icon?: keyof typeof icons
  iconPosition?: 'left' | 'right'
}

const { variant = 'default', size = 'default', class: className, rounded = 'default', loadingText, showTextOnLoading = true, icon, iconPosition = 'left', ...props } = Astro.props

const baseClasses =
  'inline-flex items-center font-normal cursor-pointer justify-center whitespace-nowrap rounded-main ring-offset-white transition-colors focus:outline-none focus:ring-2 focus-visible:ring-slate-950 focus:ring-offset-2 disabled:cursor-not-allowed disabled:pointer-events-none disabled:bg-neutral-200 disabled:border-border disabled:text-neutral-600'

const variantClasses = {
  default: 'border border-primary bg-primary text-white hover:bg-primary/80',
  destructive: 'border border-destructive/30 text-destructive hover:bg-destructive/20',
  outline: 'border border-border bg-foreground hover:bg-background text-heading',
  secondary: 'border border-border bg-background text-heading hover:bg-foreground/60',
  ghost: 'hover:bg-background bg-foreground text-heading',
  gradient: 'bg-gradient-to-r from-primary via-primary/80 to-primary/60 hover:bg-gradient-to-r hover:from-primary/90 hover:via-primary/70 hover:to-primary/50 text-white transition-color',
  transparent: 'bg-transparent text-heading hover:bg-foreground',
}

const sizeClasses = {
  default: 'h-12 px-4 py-2.5 ',
  sm: 'h-8 px-1.5',
  lg: 'h-10 px-8',
  icon: 'h-8 w-8',
}

const iconSizes = {
  default: 16,
  sm: 17,
  lg: 18,
  icon: 16,
}

const roundedClasses = {
  default: 'rounded-main',
  full: 'rounded-full',
}
---

<button
  class:list={[baseClasses, variantClasses[variant], sizeClasses[size], roundedClasses[rounded], className]}
  data-loading-text={loadingText}
  data-show-text-on-loading={showTextOnLoading}
  {...props}
>
  <span data-button-spinner class="mr-2 hidden animate-spin" aria-hidden="true">
    <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
    </svg>
  </span>
  <span data-button-content class="flex items-center gap-2 px-1.5">
    {
      icon && iconPosition === 'left' && (
        <span data-button-icon>
          <Icon name={icon} size={iconSizes[size]} />
        </span>
      )
    }
    <slot />
    {
      icon && iconPosition === 'right' && (
        <span data-button-icon>
          <Icon name={icon} size={iconSizes[size]} />
        </span>
      )
    }
  </span>
</button>

<script>
  function initButtonLoadingSystem() {
    // Seleccionar todos los botones que tengan los elementos internos de spinner y content
    const buttons = document.querySelectorAll('button[data-button-spinner], button:has([data-button-spinner])') as NodeListOf<HTMLButtonElement>

    buttons.forEach((button) => {
      const spinner = button.querySelector('[data-button-spinner]') as HTMLElement
      const content = button.querySelector('[data-button-content]') as HTMLElement

      if (!spinner || !content) return

      // Evitar inicializar el mismo botón múltiples veces
      if (button.hasAttribute('data-loading-initialized')) return
      button.setAttribute('data-loading-initialized', 'true')

      const originalContent = content.innerHTML

      button.addEventListener('button:start-loading', () => {
        const loadingText = button.dataset.loadingText
        const showTextOnLoading = button.dataset.showTextOnLoading !== 'false'
        const iconElement = button.querySelector('[data-button-icon]') as HTMLElement

        button.setAttribute('data-loading', 'true')
        button.disabled = true

        spinner.classList.remove('hidden')

        if (iconElement) {
          iconElement.classList.add('hidden')
        }

        if (loadingText) {
          content.textContent = loadingText
        } else if (!showTextOnLoading) {
          content.classList.add('hidden')
        }
      })

      button.addEventListener('button:stop-loading', () => {
        const loadingText = button.dataset.loadingText
        const showTextOnLoading = button.dataset.showTextOnLoading !== 'false'
        const iconElement = button.querySelector('[data-button-icon]') as HTMLElement

        button.removeAttribute('data-loading')
        button.disabled = false

        spinner.classList.add('hidden')

        if (iconElement) {
          iconElement.classList.remove('hidden')
        }

        if (loadingText || !showTextOnLoading) {
          content.innerHTML = originalContent
          content.classList.remove('hidden')
        }
      })
    })
  }

  // Inicializar en la primera carga
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initButtonLoadingSystem)
  } else {
    initButtonLoadingSystem()
  }

  // Reinicializar después de navegaciones del lado del cliente (si aplica)
  document.addEventListener('astro:page-load', initButtonLoadingSystem)
</script>
