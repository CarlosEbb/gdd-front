---
import { Image } from 'astro:assets'
import type { Templates } from '@/types/templates'
import Button from './Button.astro'
import { API_URL } from 'astro:env/client'

interface Props {
  template: Templates
}

const { template } = Astro.props
const thumbnails = `${API_URL}${template.pathThumbnails}`
const isMyTemplate = template.category?.toLowerCase() === 'mis plantillas'
---

<div class="group relative cursor-pointer overflow-hidden rounded-lg border border-border bg-foreground transition-all duration-300 hover:border-muted hover:shadow-base" id={template.uuid}>
  <div class="relative h-52 overflow-hidden bg-background">
    <div
      class="absolute top-10 left-1/2 h-auto w-[80%] -translate-x-1/2 rounded-t-md border border-border bg-background mask-b-from-50% mask-b-to-90% shadow-sm transition-transform duration-500 ease-out group-hover:-translate-y-6"
    >
      <Image src={thumbnails} alt={template.category} width={200} height={200} class="h-full w-full rounded-t-md object-contain transition-opacity" priority={false} />
    </div>
    {
      isMyTemplate && (
        <Button
          iconOnly
          class="delete-template-btn absolute top-2 right-2 z-20 bg-destructive/30 opacity-70 shadow-sm transition-all duration-200 md:opacity-0 md:group-hover:opacity-100"
          variant="destructive"
          size="sm"
          icon="Trash2"
          title="Eliminar plantilla"
          data-uuid={template.uuid}
          type="button"
        />
      )
    }
  </div>
  <div class="relative z-10 border-t border-border bg-foreground p-3">
    <h3 class="text-sm font-semibold tracking-tight text-heading">{template.title}</h3>
    <div class="flex items-center justify-between">
      <span class="text-[11px] font-semibold text-subheading">{template.category}</span>
    </div>
  </div>
</div>
