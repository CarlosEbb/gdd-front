---
import { House, FileText, FolderOpen, type Icon as IconType, CirclePlus, Menu, X, Briefcase, Server, Users, CircleUser } from '@lucide/astro'
import type { PermissionData } from '@/lib/permissions/types'
import { hasModuleAccess, hasPermission } from '@/lib/permissions/policy'
import PermissionGuard from './PermissionGuard.astro'

type MenuItem = {
  name: string
  href: string
  icon: typeof IconType
  module?: string
  permission?: string
}

const ALL_MENU_ITEMS: MenuItem[] = [
  { href: '/home', name: 'Inicio', icon: House },
  { href: '/documents', name: 'Documentos', icon: FolderOpen, module: 'templates' },
  { href: '/templates', name: 'Plantillas', icon: FileText, module: 'templates', permission: 'templates.create' },
  { href: '/profile', name: 'Perfil', icon: CircleUser },
  { href: '/users', name: 'Usuarios', icon: Users, module: 'users' },
  { href: '/clients', name: 'Clientes', icon: Briefcase, module: 'clients' },
  { href: '/servers', name: 'Servidores', icon: Server, module: 'servers' },
  { href: '/workspaces', name: 'Espacios', icon: FolderOpen, module: 'workspaces' },
]

const permissions = (await Astro.session?.get('permissions')) as PermissionData | undefined

const OPTIONS_MENU = ALL_MENU_ITEMS.filter((item) => {
  if (!item.module && !item.permission) return true
  if (!permissions) return false
  if (item.permission) return hasPermission(permissions, item.permission)
  return hasModuleAccess(permissions, item.module!)
})

const currentPath = Astro.url.pathname
---

<div id="menu-overlay" data-sidebar-overlay class="fixed inset-0 z-40 hidden bg-black/50 lg:hidden"></div>

<button
  type="button"
  data-sidebar-toggle
  aria-controls="menubar"
  aria-expanded="false"
  class="fixed bottom-4 left-4 z-50 flex items-center justify-center rounded-full bg-primary p-3 text-background shadow-lg transition-all duration-200 hover:shadow-xl lg:hidden"
>
  <Menu class="size-6" />
  <span class="sr-only">Abrir menú</span>
</button>

<aside
  id="menubar"
  data-sidebar
  class={`fixed left-0 top-0 z-40 h-screen w-64 -translate-x-full bg-background border-r border-sidebar-border transition-transform duration-200 lg:bottom-0 lg:top-auto lg:h-[calc(100vh-57px)] lg:w-16 lg:translate-x-0 xl:w-[85px]`}
>
  <div class="flex flex-col">
    <div class="flex w-full items-center justify-between p-2 lg:hidden">
      <div class="px-2 text-sm font-semibold text-primary">Menú</div>
      <button type="button" data-sidebar-close class="rounded-main p-2 text-primary hover:bg-primary-foreground">
        <X class="size-5" />
        <span class="sr-only">Cerrar menú</span>
      </button>
    </div>
    <PermissionGuard permission="templates.create">
      <div class="mt-4 flex w-full items-center justify-center p-2">
        <button
          data-open-modal="save-template"
          class="group flex w-auto cursor-pointer flex-col items-center justify-center gap-1 rounded-main p-2 text-xs font-medium text-primary transition-all duration-200 hover:scale-105"
        >
          <span class="flex items-center justify-center rounded-main bg-primary-foreground p-2 text-primary transition-all duration-200 group-hover:shadow-lg">
            <CirclePlus class="size-5" />
          </span>
          <span>Crear</span>
        </button>
      </div>
    </PermissionGuard>
    <nav class="mt-7 space-y-5 overflow-y-auto">
      <ul class="space-y-3 p-1">
        {
          OPTIONS_MENU.map((option) => (
            <li>
              <a
                class:list={[
                  'group flex min-w-0 items-center justify-start gap-1 overflow-hidden rounded-main text-xs text-subheading transition-all duration-200 lg:flex-col lg:justify-center lg:gap-0',
                ]}
                href={option.href}
                title={option.name}
              >
                <span
                  class:list={[
                    'flex items-center justify-center rounded-main border border-background p-2 group-hover:border-border group-hover:bg-foreground',
                    {
                      'rounded-main border border-border bg-foreground font-semibold transition-all duration-200': option.href === currentPath,
                    },
                  ]}
                >
                  <option.icon class="size-5" stroke-width="1.5" />
                </span>
                <span class:list={['block w-full truncate text-left md:block lg:hidden xl:block xl:text-center', option.href === currentPath ? 'font-semibold' : '']}>{option.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</aside>

<script>
  const initSidebarDrawer = () => {
    const sidebar = document.querySelector('[data-sidebar]')
    const overlay = document.querySelector('[data-sidebar-overlay]')
    const toggle = document.querySelector('[data-sidebar-toggle]')
    const closeBtn = document.querySelector('[data-sidebar-close]')

    if (!sidebar || !overlay || !toggle) return

    const isDesktop = () => window.matchMedia('(min-width: 1024px)').matches

    const open = () => {
      if (isDesktop()) return
      sidebar.classList.remove('-translate-x-full')
      overlay.classList.remove('hidden')
      toggle.setAttribute('aria-expanded', 'true')
    }

    const close = () => {
      overlay.classList.add('hidden')
      toggle.setAttribute('aria-expanded', 'false')
      if (isDesktop()) return
      sidebar.classList.add('-translate-x-full')
    }

    const isOpen = () => !sidebar.classList.contains('-translate-x-full')

    // Estado inicial
    close()

    // Evita duplicar listeners entre navegaciones con view transitions
    if (toggle.getAttribute('data-bound') === 'true') return
    toggle.setAttribute('data-bound', 'true')

    toggle.addEventListener('click', () => {
      if (isOpen()) close()
      else open()
    })

    overlay.addEventListener('click', close)
    closeBtn?.addEventListener('click', close)

    if (sidebar.getAttribute('data-links-bound') !== 'true') {
      sidebar.setAttribute('data-links-bound', 'true')
      sidebar.addEventListener('click', (e) => {
        if (isDesktop()) return
        const target = e.target
        if (!(target instanceof Element)) return
        const link = target.closest('a[href]')
        if (!link) return
        close()
      })
    }

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close()
    })

    // Si cambias de tamaño a desktop, cierra overlay y deja el layout estable
    const onResize = () => close()
    window.addEventListener('resize', onResize, { passive: true })
  }

  document.addEventListener('astro:page-load', initSidebarDrawer)
  document.addEventListener('astro:after-swap', initSidebarDrawer)
</script>
