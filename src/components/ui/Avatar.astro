---
import type { InfoProfile } from '@/types/profile'
const API_URL = import.meta.env.API_URL

interface Props {
  size: 'xs' | 'sm' | 'md' | 'lg' | 'xl'
  name?: string
  lastName?: string
  photo?: string | null
}

const { size, name: nameProp, lastName: lastNameProp, photo: photoProp } = Astro.props
const getUser = (await Astro.session?.get('user')) as InfoProfile | undefined
const name = nameProp ?? getUser?.name ?? ''
const last_name = lastNameProp ?? getUser?.lastName ?? ''
const photo = photoProp !== undefined ? photoProp : (getUser?.photo ?? null)

const SIZES = {
  xs: 'size-4',
  sm: 'size-6',
  md: 'size-8',
  lg: 'size-10',
  xl: 'size-12',
}

const SIZE_TEXT = {
  xs: 'text-xs',
  sm: 'text-xs',
  md: 'text-sm',
  lg: 'text-base',
  xl: 'text-lg',
}

const sizeClass = SIZES[size]
const initials = name.charAt(0).toUpperCase() + (last_name ? last_name.charAt(0).toUpperCase() : '')
const textSize = SIZE_TEXT[size]

const hasPhoto = photo === null || photo === '{}'
const photoUrl = hasPhoto ? '' : `${API_URL}${photo}`
const isHiddenPhoto = hasPhoto === false ? '' : 'hidden'
---

<img src={photoUrl} alt="Foto de perfil" class={`aspect-square ${sizeClass} rounded-full border border-border object-cover ${isHiddenPhoto}`} />

<div
  class={`flex aspect-square ${sizeClass} items-center justify-center rounded-full bg-linear-to-r from-cyan-500 to-blue-500 object-cover font-semibold ${textSize} ${isHiddenPhoto ? '' : 'hidden'}`}
  title={`${name} ${last_name}`}
>
  {initials}
</div>
