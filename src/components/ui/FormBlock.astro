---
interface Props {
  title: string
  cols?: 1 | 2 | 3
  description?: string
}

const { title, cols = 2, description } = Astro.props

const colsClass = {
  1: 'grid-cols-1',
  2: 'grid-cols-1 md:grid-cols-2',
  3: 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3',
}
---

<div class="space-y-4 rounded-main border border-border bg-background p-6">
  <h3 class="flex items-center gap-2 text-xl font-semibold tracking-wider text-heading">
    {title}
  </h3>
  <h4 class="text-md mb-7 text-subheading">{description}</h4>
  <div class={`grid gap-6 ${colsClass[cols]}`}>
    <slot />
  </div>
</div>
