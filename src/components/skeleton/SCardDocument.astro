---
interface Props {
  number?: number | null
}

const { number = 4 } = Astro.props

const documents = Array.from({ length: number ?? 0 }, (_, index) => index)
---

{
  documents.map((document) => (
    <div class="block animate-pulse rounded-main border border-border bg-background">
      <div class="overflow-hidden px-3 pt-3">
        <div class="h-48 w-full rounded-main bg-muted" />
      </div>

      <div class="mt-2 flex items-center justify-between space-x-2 px-3">
        <div class="flex min-w-0 flex-1 items-center gap-x-2">
          <div class="h-4 w-3/4 rounded bg-muted" />
        </div>
        <div class="size-6 rounded-main bg-muted" />
      </div>

      <div class="mb-2 px-3">
        <div class="h-3 w-full rounded bg-muted" />
        <div class="mt-1 h-3 w-2/3 rounded bg-muted" />
      </div>

      <div class="mt-5 flex items-center justify-between border-t border-border bg-foreground px-3 py-2">
        <div class="flex items-center">
          <div class="size-6 rounded-full bg-muted" />
          <div class="ml-2 h-3 w-20 rounded bg-muted" />
        </div>
        <div class="h-3 w-16 rounded bg-muted" />
      </div>
    </div>
  ))
}
