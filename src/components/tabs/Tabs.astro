---
interface Props {
  defaultValue: string
  variant?: 'default' | 'line'
  class?: string
}

const { defaultValue, variant = 'default', class: className } = Astro.props
---

<div
  class:list={['w-full', className]}
  data-tabs-container
  data-tabs-value={defaultValue}
  data-tabs-variant={variant}
>
  <slot />
</div>

<script>
  function initTabs() {
    const tabsContainers = document.querySelectorAll('[data-tabs-container]')

    tabsContainers.forEach((container) => {
      if (container.hasAttribute('data-tabs-initialized')) return
      container.setAttribute('data-tabs-initialized', 'true')

      const currentValue = container.getAttribute('data-tabs-value')

      // Inicializar estado
      updateTabsState(container, currentValue)
    })
  }

  function getOwnTabsElements(container: Element, selector: string): Element[] {
    return Array.from(container.querySelectorAll(selector)).filter((element) => element.closest('[data-tabs-container]') === container)
  }

  function updateTabsState(container: Element, activeValue: string | null) {
    const triggers = getOwnTabsElements(container, '[data-tabs-trigger]')
    const contents = getOwnTabsElements(container, '[data-tabs-content]')

    triggers.forEach((trigger) => {
      const value = trigger.getAttribute('data-tabs-trigger')
      trigger.setAttribute('data-state', value === activeValue ? 'active' : 'inactive')
    })

    contents.forEach((content) => {
      const value = content.getAttribute('data-tabs-content')
      content.setAttribute('data-state', value === activeValue ? 'active' : 'inactive')
    })
  }

  // Event delegation - un solo listener en el document
  document.addEventListener('click', (e) => {
    const trigger = (e.target as Element).closest('[data-tabs-trigger]')
    if (!trigger) return

    const container = trigger.closest('[data-tabs-container]')
    if (!container) return

    const value = trigger.getAttribute('data-tabs-trigger')
    container.setAttribute('data-tabs-value', value || '')
    updateTabsState(container, value)
  })

  // Inicializar en la primera carga
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTabs)
  } else {
    initTabs()
  }

  // Reinicializar después de navegaciones con View Transitions
  document.addEventListener('astro:page-load', initTabs)
</script>
