---
interface Props {
  value: string
  class?: string
}

const { value, class: className } = Astro.props
---

<div
  class:list={['mt-4 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:outline-none', 'data-[state=inactive]:hidden', className]}
  role="tabpanel"
  data-tabs-content={value}
  data-state="inactive"
>
  <slot />
</div>
